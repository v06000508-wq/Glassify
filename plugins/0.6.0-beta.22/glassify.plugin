            "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
            "AAAAAAAAAAAAAAAAAAAAwGXw/wFa9jJvbB/TmQAAAABJRU5ErkJggg=="
        ),
    )

    def __init__(self, plugin, view, background):
        self.plugin = plugin
        self.view = view
        self.key = _identity(view)
        self.elapsed = 0.30
        self.started_at = 0.0
        self.particles = []
        self.animator = None
        self.density = AndroidUtilities.dp(100) / 100.0
        self.light = self._is_light(background)
        self.warm, self.snow = (self._decode_sprite(data) for data in self.SPRITES[int(self.light)])
        context = view.getContext()
        for index in range(self.PARTICLE_COUNT):
            depth = ((index * 7) % self.PARTICLE_COUNT) / (self.PARTICLE_COUNT - 1)
            size = AndroidUtilities.dp(round(9 + 8 * depth))
            image = ImageView(context)
            image.setScaleType(ImageView.ScaleType.FIT_CENTER)
            image.setImageBitmap(self.snow)
            view.addView(image, FrameLayout.LayoutParams(size, size, Gravity.TOP | Gravity.LEFT))
            self.particles.append((image, size, depth))
        self.phase = [True] * self.PARTICLE_COUNT
        self._install_listeners()

    @staticmethod
    def _decode_sprite(encoded):
        data = base64.b64decode(encoded)
        bitmap = BitmapFactory.decodeByteArray(data, 0, len(data))
        if bitmap is None:
            raise RuntimeError("winter particle sprite could not be decoded")
        return bitmap

    @staticmethod
    def _is_light(background):
        return Color.red(background) * 3 + Color.green(background) * 6 + Color.blue(background) >= 1560

    @classmethod
    def show_static(cls, view, light):
        image = ImageView(view.getContext())
        image.setScaleType(ImageView.ScaleType.FIT_CENTER)
        image.setImageBitmap(cls._decode_sprite(cls.STILL[int(light)]))
        view.removeAllViews()
        view.addView(image, FrameLayout.LayoutParams(
            ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT,
        ))

    @staticmethod
    def _ease(start, end, elapsed):
        t = max(0.0, min(1.0, (elapsed - start) / (end - start)))
        return t * t * (3.0 - 2.0 * t)

    @classmethod
    def _pose(cls, index, depth, elapsed, width, height, inset, density):
        # The expansion and settle share one orbit, so particles never respawn.
        spread = 0.76 + 0.24 * cls._ease(0.12, 1.25, elapsed)
        spread += 0.15 * (cls._ease(1.42, 2.06, elapsed) - cls._ease(2.06, 3.3, elapsed))
        angle = index * 2.399963 + elapsed * (0.21 + 0.18 * depth)
        radius = (0.40 + 0.44 * depth) * spread
        radius += 0.035 * math.sin(index * 1.21 + elapsed * 0.72)
        rx = max(0.0, width / 2.0 - inset)
        ry = max(0.0, height / 2.0 - inset)
        wobble = index * 0.83 + elapsed * (0.64 + 0.22 * depth)
        x = width / 2.0 + rx * radius * math.cos(angle) + 4.0 * density * math.sin(wobble)
        y = height / 2.0 + ry * radius * math.sin(angle) + 3.0 * density * math.sin(wobble * 1.18)
        alpha = cls._ease(0.04 + depth * 0.24, 0.60 + depth * 0.24, elapsed)
        alpha *= 0.49 + 0.34 * depth + 0.10 * math.sin(wobble)
        rotation = math.degrees(angle) * (0.65 if index % 2 else -0.46)
        return x, y, alpha, rotation

    @staticmethod
    def _crystal_at(index):
        return 0.93 + (index * 5 % 9) * 0.071

    def _render(self, elapsed):
        width, height = self.view.getWidth(), self.view.getHeight()
        if width <= 0 or height <= 0:
            return
        for index, (image, size, depth) in enumerate(self.particles):
            transform_at = self._crystal_at(index)
            half_fade = self.CROSSFADE_MS / 2000.0
            snow = elapsed >= transform_at
            if self.phase[index] != snow:
                image.setImageBitmap(self.snow if snow else self.warm)
                self.phase[index] = snow

            inset = size / 2.0 + 7.0 * self.density
            x, y, alpha, rotation = self._pose(index, depth, elapsed, width, height, inset, self.density)
            opacity = max(0.23, alpha)
            opacity *= 0.42 + 0.58 * self._ease(0.0, half_fade, abs(elapsed - transform_at))
            image.setTranslationX(float(x - size / 2.0))
            image.setTranslationY(float(y - size / 2.0))
            image.setAlpha(float(opacity))
            image.setRotation(float(rotation % 360.0))

    def start(self):
        if not self.plugin._plugin_alive or not self.particles:
            return
        animator = self.animator
        if animator is not None and animator.isStarted():
            return
        self.plugin._header_particle_animations[self.key] = self
        self._render(3.3 if animator is None else self.elapsed)
        if animator is not None:
            self.started_at = time.monotonic() - self.elapsed
            animator.start()

    def stop(self):
        try:
            if self.animator is not None:
                self.animator.cancel()
        finally:
            self.plugin._header_particle_animations.pop(self.key, None)

    def _use_static(self, exc):
        _note_suppressed(exc)
        self.stop()
        self.animator = None
        self.particles.clear()
        self.show_static(self.view, self.light)

    def _install_listeners(self):
        state = self
        attach_interface = jclass("android.view.View$OnAttachStateChangeListener")
        layout_interface = jclass("android.view.View$OnLayoutChangeListener")

        class OnAttach(dynamic_proxy(attach_interface)):
            def onViewAttachedToWindow(self, view):
                try:
                    state.start()
                except Exception as exc:
                    state._use_static(exc)

            def onViewDetachedFromWindow(self, view):
                state.stop()

        class OnLayout(dynamic_proxy(layout_interface)):
            def onLayoutChange(self, view, left, top, right, bottom,
                               old_left, old_top, old_right, old_bottom):
                if state.plugin._plugin_alive and state.particles:
                    try:
                        state._render(3.3 if state.animator is None else state.elapsed)
                    except Exception as exc:
                        state._use_static(exc)

        self.view.addOnAttachStateChangeListener(OnAttach())
        self.view.addOnLayoutChangeListener(OnLayout())

        try:
            ValueAnimator = jclass("android.animation.ValueAnimator")
            if hasattr(ValueAnimator, "areAnimatorsEnabled") and not ValueAnimator.areAnimatorsEnabled():
                return
            update_interface = jclass("android.animation.ValueAnimator$AnimatorUpdateListener")

            class OnUpdate(dynamic_proxy(update_interface)):
                def onAnimationUpdate(self, animator):
                    try:
                        state.elapsed = time.monotonic() - state.started_at
                        state._render(state.elapsed)
                    except Exception as exc:
                        state._use_static(exc)

            animator = ValueAnimator.ofFloat(jarray(jfloat)([0.0, 1.0]))
            animator.setDuration(1000)
            animator.setRepeatCount(-1)
            animator.addUpdateListener(OnUpdate())
            self.animator = animator
        except Exception as exc:
            _note_suppressed(exc)


class _WinterGarlandGlow:
    SIZE_DP = 38
    CYCLE_MS = 8000

    def __init__(self, plugin, holder, light):
        self.plugin = plugin
        self.holder = holder
        self.key = _identity(holder)
        self.layers = []
        self.size = 0
        self.animator = None
        context = holder.getContext()
        bitmaps = [_WinterHeaderParticles._decode_sprite(encoded) for encoded in _WINTER_GARLAND_BLOOM[int(light)]]
        for _, _, kind in _WINTER_GARLAND_LAMPS:
            glow = ImageView(context)
            glow.setScaleType(ImageView.ScaleType.FIT_CENTER)
            glow.setImageBitmap(bitmaps[kind])
            glow.setAlpha(0.0)
            holder.addView(glow, FrameLayout.LayoutParams(1, 1, Gravity.TOP | Gravity.LEFT))
            self.layers.append(glow)

        state = self
        layout_interface = jclass("android.view.View$OnLayoutChangeListener")
        attach_interface = jclass("android.view.View$OnAttachStateChangeListener")

        class OnLayout(dynamic_proxy(layout_interface)):
            def onLayoutChange(self, view, left, top, right, bottom, old_left, old_top, old_right, old_bottom):
                try:
                    state.layout(right - left, bottom - top)
                except Exception as exc:
                    _note_suppressed(exc)

        class OnAttach(dynamic_proxy(attach_interface)):
            def onViewAttachedToWindow(self, view):
                state.start()

            def onViewDetachedFromWindow(self, view):
                state.stop()

        holder.addOnLayoutChangeListener(OnLayout())
        holder.addOnAttachStateChangeListener(OnAttach())

        ValueAnimator = jclass("android.animation.ValueAnimator")
        if hasattr(ValueAnimator, "areAnimatorsEnabled") and not ValueAnimator.areAnimatorsEnabled():
            return
        update_interface = jclass("android.animation.ValueAnimator$AnimatorUpdateListener")

        class OnUpdate(dynamic_proxy(update_interface)):
            def onAnimationUpdate(self, animator):
                try:
                    state.render(float(animator.getAnimatedFraction()))
                except Exception as exc:
                    _note_suppressed(exc)
                    state.stop()

        animator = ValueAnimator.ofFloat(jarray(jfloat)([0.0, 1.0]))
        animator.setDuration(self.CYCLE_MS)
        animator.setRepeatCount(-1)
        animator.setInterpolator(jclass("android.view.animation.LinearInterpolator")())
        animator.addUpdateListener(OnUpdate())
        self.animator = animator

    def layout(self, width, height):
        if width <= 0 or height <= 0:
            return
        scale = min(width / 384.0, height / 46.0)
        left = (width - 384 * scale) / 2
        top = (height - 46 * scale) / 2
        size = max(1, round(self.SIZE_DP * scale))
        for glow, (x, y, _) in zip(self.layers, _WINTER_GARLAND_LAMPS):
            if size != self.size:
                glow.setLayoutParams(FrameLayout.LayoutParams(size, size, Gravity.TOP | Gravity.LEFT))
            glow.setTranslationX(float(left + x * scale - size / 2))
            glow.setTranslationY(float(top + y * scale - size / 2))
            if self.animator is None:
                glow.setAlpha(0.48)
        self.size = size

    @staticmethod
    def opacity(index, fraction):
        phase = index * 0.231
        breathe = 0.5 + 0.5 * math.cos(math.tau * ((2 + index % 3) * fraction + phase))
        glint = 0.5 + 0.5 * math.cos(math.tau * ((3 + (index * 3) % 4) * fraction - phase))
        return 0.10 + 0.44 * breathe ** 2 + 0.46 * glint ** 5

    def render(self, fraction):
        for index, glow in enumerate(self.layers):
            glow.setAlpha(float(self.opacity(index, fraction)))

    def start(self):
        if self.animator is None or self.animator.isStarted() or not self.plugin._plugin_alive:
            return
        self.plugin._header_particle_animations[self.key] = self
        try:
            self.render(0.0)
            self.animator.start()
        except Exception as exc:
            _note_suppressed(exc)
            self.stop()
            self.animator = None
            self.layout(self.holder.getWidth(), self.holder.getHeight())

    def stop(self):
        try:
            if self.animator is not None:
                self.animator.cancel()
        finally:
            self.plugin._header_particle_animations.pop(self.key, None)


def _create_glassify_header_view_impl(
    context,
    list_view,
    current_account,
    class_guid,
    resources_provider,
):
    dp = AndroidUtilities.dp
    header = LinearLayout(context)
    header.setOrientation(LinearLayout.VERTICAL)
    header.setGravity(Gravity.CENTER_HORIZONTAL)
    header.setPadding(dp(16), dp(10), dp(16), dp(24))
    primary = _theme_color(Theme.key_windowBackgroundWhiteBlackText, resources_provider)
    secondary = _theme_color(Theme.key_windowBackgroundWhiteGrayText, resources_provider)

    logo_area = FrameLayout(context)
    logo_area.setClipChildren(False)
    header.addView(
        logo_area,
        LinearLayout.LayoutParams(
            ViewGroup.LayoutParams.MATCH_PARENT, dp(_WinterHeaderParticles.STAGE_HEIGHT_DP)
        ),
    )
    try:
        plugin = _ACTIVE_PLUGIN
        if plugin is not None:
            particles = FrameLayout(context)
            particles.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO_HIDE_DESCENDANTS)
            background = _theme_color(Theme.key_windowBackgroundWhite, resources_provider)
            try:
                _WinterHeaderParticles(plugin, particles, background)
            except Exception as exc:
                _note_suppressed(exc)
                _WinterHeaderParticles.show_static(particles, _WinterHeaderParticles._is_light(background))
            logo_area.addView(
                particles,
                FrameLayout.LayoutParams(
                    ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT
                ),
            )
    except Exception as exc:
        _note_suppressed(exc)

    try:
        background = _theme_color(Theme.key_windowBackgroundWhite, resources_provider)
        light = _WinterHeaderParticles._is_light(background)
        lights = FrameLayout(context)
        lights.setClipChildren(False)
        lights.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO_HIDE_DESCENDANTS)
        garland = ImageView(context)
        garland.setScaleType(ImageView.ScaleType.FIT_CENTER)
        garland.setImageBitmap(_WinterHeaderParticles._decode_sprite(_WINTER_GARLAND[int(light)]))
        lights.addView(garland, FrameLayout.LayoutParams(
            ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT,
        ))
        plugin = _ACTIVE_PLUGIN
        if plugin is not None:
            try:
                _WinterGarlandGlow(plugin, lights, light)
            except Exception as exc:
                _note_suppressed(exc)
        logo_area.addView(lights, FrameLayout.LayoutParams(
            ViewGroup.LayoutParams.MATCH_PARENT, dp(46), Gravity.TOP,
        ))
    except Exception as exc:
        _note_suppressed(exc)

    logo = ImageView(context)
    logo.setScaleType(ImageView.ScaleType.FIT_CENTER)
    logo_area.addView(
        logo,
        FrameLayout.LayoutParams(dp(78), dp(78), Gravity.CENTER),
    )
    _load_glassify_logo_into(logo)

    title = TextView(context)
    title.setText("Glassify")
    title.setTextColor(primary)
    title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 24.0)
    title.setTypeface(Typeface.DEFAULT, Typeface.BOLD)
    title.setGravity(Gravity.CENTER)
    title_params = LinearLayout.LayoutParams(
        ViewGroup.LayoutParams.MATCH_PARENT,
        ViewGroup.LayoutParams.WRAP_CONTENT,
    )
    header.addView(title, title_params)

    version = TextView(context)
    version.setText(f"{__version__.replace('-beta.', ' beta ')} · {__author__}")
    version.setTextColor(secondary)
    version.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14.0)
    version.setGravity(Gravity.CENTER)
    version_params = LinearLayout.LayoutParams(
        ViewGroup.LayoutParams.MATCH_PARENT,
        ViewGroup.LayoutParams.WRAP_CONTENT,
    )
    version_params.topMargin = dp(4)
    header.addView(version, version_params)
    return header


def _create_safe_custom_fallback(context, title_text, detail_text, resources_provider):
    """Create a dependency-light row when a rich custom settings view fails."""
    try:
        outer = LinearLayout(context)
        outer.setOrientation(LinearLayout.VERTICAL)
        outer.setGravity(Gravity.CENTER_VERTICAL)
        outer.setPadding(
            AndroidUtilities.dp(16),
            AndroidUtilities.dp(14),
            AndroidUtilities.dp(16),
            AndroidUtilities.dp(14),
        )

        title = TextView(context)
        title.setText(title_text)
        title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 16.0)
        try:
            title.setTextColor(
                _theme_color(
                    Theme.key_windowBackgroundWhiteBlackText, resources_provider
                )
            )
        except Exception as color_exc:
            _note_suppressed(color_exc)
        outer.addView(
            title,
            LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT,
                ViewGroup.LayoutParams.WRAP_CONTENT,
            ),
        )

        detail = TextView(context)
        detail.setText(detail_text)
        detail.setTextSize(TypedValue.COMPLEX_UNIT_SP, 13.0)
        detail.setSingleLine(False)
        try:
            detail.setTextColor(
                _theme_color(
                    getattr(
                        Theme,
                        "key_windowBackgroundWhiteGrayText",
                        Theme.key_windowBackgroundWhiteBlackText,
                    ),
                    resources_provider,
                )
            )
        except Exception as color_exc:
            _note_suppressed(color_exc)
        detail_params = LinearLayout.LayoutParams(
            ViewGroup.LayoutParams.MATCH_PARENT,
            ViewGroup.LayoutParams.WRAP_CONTENT,
        )
        detail_params.topMargin = AndroidUtilities.dp(4)
        outer.addView(detail, detail_params)
        return outer
    except Exception as fallback_exc:
        # Last-resort Android View with virtually no dependencies.
        _note_suppressed(fallback_exc)
        view = TextView(context)
        view.setText(title_text)
        return view


def _create_strength_view(
    context,
    list_view,
    current_account,
    class_guid,
    resources_provider,
):
    try:
        return _create_strength_view_impl(
            context, list_view, current_account, class_guid, resources_provider
        )
    except Exception as exc:
        _note_suppressed(exc)
        return _create_safe_custom_fallback(
            context,
            f"Сила Liquid Glass · {_active_strength()}%",
            "Ползунок недоступен на этой сборке клиента. Остальные настройки Glassify работают.",
            resources_provider,
        )


def _create_glassify_header_view(
    context,
    list_view,
    current_account,
    class_guid,
    resources_provider,
):
    try:
        return _create_glassify_header_view_impl(
            context, list_view, current_account, class_guid, resources_provider
        )
    except Exception as exc:
        _note_suppressed(exc)
        return _create_safe_custom_fallback(
            context,
            f"Glassify {__version__}",
            "Нативный Liquid Glass для exteraGram",
            resources_provider,
        )


def _bind_static_setting_view(view, item, divider, adapter, list_view):
    # Required by SimpleSettingFactory; static custom rows have no bind state.
    return


def _bind_glassify_header_view(view, item, divider, adapter, list_view):
    # The settings adapter may set a themed row background after creating the view.
    view.setBackground(None)


GlassifyHeaderFactory = SimpleSettingFactory(
    _create_glassify_header_view,
    _bind_glassify_header_view,
    is_clickable=False,
    is_shadow=True,
)


StrengthSliderFactory = SimpleSettingFactory(
    _create_strength_view,
    _bind_strength_view,
    is_clickable=False,
)


