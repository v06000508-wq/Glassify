class _EmojiPanelRefreshAfterHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if not self.plugin._emoji_panel_glass and not self.plugin.chat_work_busy():
            self.plugin.decorate_emoji_panel(param.thisObject)
            return
        self.plugin.schedule_keyboard_panel_refresh(
            param.thisObject,
            "emoji",
            16,
        )


class _EmojiPanelStockMaterialHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if self.plugin._plugin_alive and not self.plugin._emoji_panel_glass:
            if self.plugin.chat_work_busy():
                self.plugin.schedule_keyboard_panel_refresh(param.thisObject, "emoji", 16)
            else:
                self.plugin._sync_emoji_panel_material(param.thisObject)


