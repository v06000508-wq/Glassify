GLASSIFY_MAX_CATALOG_BYTES = 256 * 1024
GLASSIFY_MAX_EXTENSION_BYTES = 512 * 1024
GLASSIFY_MAX_PREVIEW_BYTES = 4 * 1024 * 1024
GLASSIFY_MAX_PREVIEW_DIMENSION = 2048
GLASSIFY_MAX_PREVIEW_PIXELS = 2 * 1024 * 1024
GLASSIFY_MAX_RUNTIME_REFS = 256
_EXTENSION_ID_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{1,63}$")
_SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
_GIT_COMMIT_RE = re.compile(r"^[0-9a-f]{40}$")
_GIT_BLOB_RE = re.compile(r"^[0-9a-f]{40}$")
_PREVIEW_FILE_RE = re.compile(r"^preview\.(?:png|jpe?g|webp)$", re.IGNORECASE)
_EXTENSION_SETTING_KEY_RE = re.compile(r"^[a-z][a-z0-9_.-]{0,47}$")

_EXTENSION_SAFE_BUILTINS = {
    "abs",
    "all",
    "any",
    "bool",
    "bytes",
    "callable",
    "chr",
    "dict",
    "enumerate",
    "Exception",
    "float",
    "getattr",
    "hasattr",
    "int",
    "isinstance",
    "issubclass",
    "iter",
    "len",
    "list",
    "map",
    "max",
    "min",
    "next",
    "object",
    "property",
    "range",
    "repr",
    "reversed",
    "round",
    "RuntimeError",
    "set",
    "setattr",
    "slice",
    "sorted",
    "staticmethod",
    "str",
    "sum",
    "super",
    "tuple",
    "type",
    "TypeError",
    "ValueError",
    "zip",
    "__build_class__",
}

OnSeekBarChangeListener = jclass("android.widget.SeekBar$OnSeekBarChangeListener")


def _decode_github_base64(encoded: str, limit: int, label: str) -> bytes:
    """Decode a GitHub Contents payload without accepting oversized input."""
    compact = "".join(encoded.split())
    if not compact:
        raise ValueError(f"{label} is empty")

    max_encoded = 4 * ((int(limit) + 2) // 3)
    if len(compact) > max_encoded:
        raise ValueError(f"{label} is too large")

    try:
        data = base64.b64decode(compact, validate=True)
    except (binascii.Error, ValueError) as exc:
        raise ValueError(f"{label} has invalid base64") from exc
    if not data or len(data) > limit:
        raise ValueError(f"{label} has invalid size")
    return data


def _note_suppressed(exc: Any):
    """Keep compatibility fallbacks observable without flooding the log."""
    global _SUPPRESSED_FAILURE_TOTAL
    try:
        frame = sys._getframe(1)
        location = f"{frame.f_code.co_name}:{frame.f_lineno}"
        message = f"{type(exc).__name__}: {exc}"
        key = f"{location}:{message}"
        if key not in _SUPPRESSED_FAILURES and len(_SUPPRESSED_FAILURES) >= 256:
            key = "__overflow__"
            message = "additional compatibility failures"
        count = int(_SUPPRESSED_FAILURES.get(key, 0)) + 1
        _SUPPRESSED_FAILURES[key] = count
        _SUPPRESSED_FAILURE_TOTAL += 1
        plugin = _ACTIVE_PLUGIN
        if plugin is not None and (
            (count == 1 and len(_SUPPRESSED_FAILURES) <= 32) or count in (8, 32, 128)
        ):
            plugin.log(
                f"Glassify: compatibility fallback at {location} ({count}): {message}"
            )
    except Exception:
        return


def _identity(obj: Any) -> int:
    try:
        return int(System.identityHashCode(obj))
    except Exception:
        return id(obj)


def _active_strength() -> int:
    plugin = _ACTIVE_PLUGIN
    if plugin is None:
        return 50
    return plugin.current_strength()


def _theme_color(key: int, resources_provider: Any = None) -> int:
    try:
        return int(Theme.getColor(key, resources_provider))
    except Exception:
        try:
            return int(Theme.getColor(key))
        except Exception:
            return 0xFFFFFFFF


def _validate_extension_attribute_name(name: Any) -> str:
    value = str(name)
    if value.startswith("_") or "__" in value:
        raise AttributeError("служебные атрибуты недоступны расширениям")
    return value


def _safe_extension_getattr(obj: Any, name: Any, *default):
    value = _validate_extension_attribute_name(name)
    if len(default) > 1:
        raise TypeError("getattr expected at most 3 arguments")
    if default:
        return getattr(obj, value, default[0])
    return getattr(obj, value)


def _safe_extension_hasattr(obj: Any, name: Any) -> bool:
    value = _validate_extension_attribute_name(name)
    return hasattr(obj, value)


def _safe_extension_setattr(obj: Any, name: Any, value: Any):
    safe_name = _validate_extension_attribute_name(name)
    return setattr(obj, safe_name, value)


def _get_glassify_logo_bitmap():
    global _GLASSIFY_LOGO_BITMAP
    if _GLASSIFY_LOGO_BITMAP is None:
        data = base64.b64decode(_GLASSIFY_LOGO_BASE64)
        _GLASSIFY_LOGO_BITMAP = BitmapFactory.decodeByteArray(data, 0, len(data))
    return _GLASSIFY_LOGO_BITMAP


def _load_glassify_logo_into(view: Any) -> bool:
    if view is None:
        return False
    try:
        bitmap = _get_glassify_logo_bitmap()
        if bitmap is not None:
            view.setImageBitmap(bitmap)
            return True
    except Exception as exc:
        _note_suppressed(exc)
    return False


class _StrengthSliderInteraction:
    def __init__(self, plugin, value_view):
        self.plugin = plugin
        self.value_view = value_view
        self.tracking = False
        self.changed = False

    def start(self):
        self.tracking = True
        self.changed = False

    def change(self, value, from_user):
        if not from_user or not self.plugin._plugin_alive:
            return
        value = max(1, min(100, int(round(value))))
        self.value_view.setText(f"{value}%")
        if self.tracking:
            self.changed = True
            self.plugin.preview_strength(value)
        else:
            # Keyboard and accessibility adjustments have no touch-up callback.
            self.plugin.commit_strength(value)

    def stop(self, value):
        changed = self.changed
        self.tracking = False
        self.changed = False
        if changed and self.plugin._plugin_alive:
            self.plugin.commit_strength(int(round(value)))


@java_subclass(Object, OnSeekBarChangeListener)
class _StrengthSeekListener(Base):
    def __init__(self, interaction):
        self.interaction = interaction

    @joverride()
    def onProgressChanged(self, seek_bar, progress, from_user):
        self.interaction.change(int(progress) + 1, bool(from_user))

    @joverride()
    def onStartTrackingTouch(self, seek_bar):
        self.interaction.start()

    @joverride()
    def onStopTrackingTouch(self, seek_bar):
        self.interaction.stop(int(seek_bar.getProgress()) + 1)


def _create_material_strength_slider(context, value, accent, inactive, interaction):
    dp = AndroidUtilities.dp
    class_name = "com.google.android.material.slider.Slider"
    Slider = jclass(class_name)
    theme_id = context.getResources().getIdentifier(
        "Theme.Material3.DayNight", "style", context.getPackageName()
    )
    if theme_id:
        ContextThemeWrapper = jclass("android.view.ContextThemeWrapper")
        context = ContextThemeWrapper(context, theme_id)
    slider = Slider(context)
    slider.setValueTo(100.0)
    slider.setValueFrom(1.0)
    slider.setStepSize(1.0)
    slider.setValue(float(value))
    slider.setTickVisible(False)
    slider.setLabelBehavior(jclass("com.google.android.material.slider.LabelFormatter").LABEL_GONE)
    slider.setTrackHeight(dp(8))
    slider.setThumbWidth(dp(4))
    slider.setThumbHeight(dp(24))
    slider.setThumbTrackGapSize(dp(4))
    slider.setThumbElevation(0.0)
    slider.setTrackActiveTintList(ColorStateList.valueOf(accent))
    slider.setTrackInactiveTintList(ColorStateList.valueOf(inactive))
    slider.setThumbTintList(ColorStateList.valueOf(accent))

    if interaction is None:
        return slider, None

    change_listener = jclass(f"{class_name}$OnChangeListener")
    touch_listener = jclass(f"{class_name}$OnSliderTouchListener")

    class Listener(dynamic_proxy(change_listener, touch_listener)):
        def onValueChange(self, view, value, from_user):
            interaction.change(float(value), bool(from_user))

        def onStartTrackingTouch(self, view):
            interaction.start()

        def onStopTrackingTouch(self, view):
            interaction.stop(float(view.getValue()))

    listener = Listener()
    slider.addOnChangeListener(listener)
    slider.addOnSliderTouchListener(listener)

    def detach():
        slider.removeOnChangeListener(listener)
        slider.removeOnSliderTouchListener(listener)

    return slider, detach


def _create_android_strength_slider(context, value, accent, inactive, interaction):
    dp = AndroidUtilities.dp
    slider = SeekBar(context)
    slider.setMax(99)
    slider.setPaddingRelative(dp(4), 0, dp(4), 0)
    slider.setSplitTrack(False)
    slider.setProgressTintList(ColorStateList.valueOf(accent))
    slider.setProgressBackgroundTintList(ColorStateList.valueOf(inactive))
    slider.setThumbTintList(ColorStateList.valueOf(accent))

    thumb = GradientDrawable()
    thumb.setColor(accent)
    thumb.setCornerRadius(float(dp(2)))
    thumb.setSize(dp(4), dp(24))
    slider.setThumb(thumb)
    slider.setThumbOffset(dp(2))

    try:
        ClipDrawable = jclass("android.graphics.drawable.ClipDrawable")
        LayerDrawable = jclass("android.graphics.drawable.LayerDrawable")
        background = GradientDrawable()
        background.setColor(inactive)
        background.setCornerRadius(float(dp(4)))
        filled = GradientDrawable()
        filled.setColor(accent)
        filled.setCornerRadius(float(dp(4)))
        track = LayerDrawable(
            jarray(jclass("android.graphics.drawable.Drawable"))(
                [background, ClipDrawable(filled, Gravity.START, ClipDrawable.HORIZONTAL)]
            )
        )
        track.setId(0, 0x01020000)  # android.R.id.background
        track.setId(1, 0x0102000D)  # android.R.id.progress
        for index in range(2):
            track.setLayerHeight(index, dp(8))
            track.setLayerGravity(index, Gravity.FILL_HORIZONTAL | Gravity.CENTER_VERTICAL)
        slider.setProgressDrawable(track)
    except Exception as exc:
        _note_suppressed(exc)
    slider.setProgress(value - 1)

    if interaction is None:
        return slider, None

    listener = _StrengthSeekListener.new_instance(init_args=[interaction])
    slider.setOnSeekBarChangeListener(listener.java)

    # Retain the Python proxy for the lifetime of the Java listener.
    def detach(_listener=listener):
        slider.setOnSeekBarChangeListener(None)

    return slider, detach


def _create_strength_view_impl(
    context,
    list_view,
    current_account,
    class_guid,
    resources_provider,
):
    dp = AndroidUtilities.dp
    match = ViewGroup.LayoutParams.MATCH_PARENT
    wrap = ViewGroup.LayoutParams.WRAP_CONTENT
    value = _active_strength()
    accent = _theme_color(Theme.key_windowBackgroundWhiteBlueText, resources_provider)
    secondary = _theme_color(Theme.key_windowBackgroundWhiteGrayText, resources_provider)
    inactive = Color.argb(64, Color.red(accent), Color.green(accent), Color.blue(accent))

    outer = LinearLayout(context)
    outer.setOrientation(LinearLayout.VERTICAL)
    outer.setLayoutParams(ViewGroup.LayoutParams(match, wrap))
    outer.setPadding(dp(20), dp(16), dp(20), dp(6))

    header = LinearLayout(context)
    header.setGravity(Gravity.CENTER_VERTICAL)
    title = TextView(context)
    title.setText("Сила Liquid Glass")
    title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 16.0)
    title.setTextColor(accent)
    title.setTypeface(AndroidUtilities.bold())
    header.addView(title, LinearLayout.LayoutParams(0, wrap, 1.0))

    value_view = TextView(context)
    value_view.setText(f"{value}%")
    value_view.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14.0)
    value_view.setTextColor(accent)
    value_view.setTypeface(AndroidUtilities.bold())
    value_view.setGravity(Gravity.CENTER)
    value_view.setMinimumWidth(dp(52))
    value_view.setPadding(dp(6), dp(2), dp(6), dp(2))
    badge = GradientDrawable()
    badge.setColor(inactive)
    badge.setCornerRadius(float(dp(5)))
    value_view.setBackground(badge)
    header.addView(value_view, LinearLayout.LayoutParams(wrap, wrap))
    outer.addView(header, LinearLayout.LayoutParams(match, wrap))

    limits = LinearLayout(context)
    for text, weight, gravity, color in (
        ("1%", 1.0, Gravity.START, secondary),
        ("100%", 0.0, Gravity.END, accent),
    ):
        label = TextView(context)
        label.setText(text)
        label.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14.0)
        label.setTextColor(color)
        label.setGravity(gravity)
        limits.addView(label, LinearLayout.LayoutParams(0 if weight else wrap, wrap, weight))
    limits_params = LinearLayout.LayoutParams(match, wrap)
    limits_params.topMargin = dp(12)
    outer.addView(limits, limits_params)

    plugin = _ACTIVE_PLUGIN
    interaction = (
        _StrengthSliderInteraction(plugin, value_view)
        if plugin is not None and plugin._plugin_alive
        else None
    )
    try:
        slider, detach = _create_material_strength_slider(
            context, value, accent, inactive, interaction
        )
    except Exception as exc:
        _note_suppressed(exc)
        slider, detach = _create_android_strength_slider(
            context, value, accent, inactive, interaction
        )
    slider.setContentDescription("Сила Liquid Glass")
    slider.setEnabled(interaction is not None)
    outer.addView(slider, LinearLayout.LayoutParams(match, dp(56)))

    if detach is not None:
        plugin._slider_listeners[_identity(slider)] = detach
        if len(plugin._slider_listeners) > 16:
            oldest = next(iter(plugin._slider_listeners))
            try:
                plugin._slider_listeners.pop(oldest)()
            except Exception as exc:
                _note_suppressed(exc)
    return outer


def _bind_strength_view(view, item, divider, adapter, list_view):
    value = _active_strength()
    try:
        view.getChildAt(0).getChildAt(1).setText(f"{value}%")
        slider = view.getChildAt(2)
        if hasattr(slider, "getValue"):
            if int(round(float(slider.getValue()))) != value:
                slider.setValue(float(value))
        elif int(slider.getProgress()) != value - 1:
            slider.setProgress(value - 1)
    except Exception as exc:
        _note_suppressed(exc)


def _create_glassify_header_view_impl(
    context,
    list_view,
    current_account,
    class_guid,
    resources_provider,
):
    dp = AndroidUtilities.dp
    header = LinearLayout(context)
    header.setOrientation(LinearLayout.VERTICAL)
    header.setGravity(Gravity.CENTER_HORIZONTAL)
    header.setPadding(dp(16), dp(10), dp(16), dp(24))
    primary = _theme_color(Theme.key_windowBackgroundWhiteBlackText, resources_provider)
    secondary = _theme_color(Theme.key_windowBackgroundWhiteGrayText, resources_provider)

    logo_area = FrameLayout(context)
    header.addView(
        logo_area,
        LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(132)),
    )
    try:
        StarParticlesView = jclass("org.telegram.ui.Components.Premium.StarParticlesView")
        particles = StarParticlesView(context, 48)
        particles.drawable.paint.setColorFilter(
            PorterDuffColorFilter(Color.rgb(239, 54, 169), PorterDuff.Mode.SRC_IN)
        )
        particles.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO)
        logo_area.addView(
            particles,
            FrameLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT,
                ViewGroup.LayoutParams.MATCH_PARENT,
            ),
        )
    except Exception as exc:
        _note_suppressed(exc)

    logo = ImageView(context)
    logo.setScaleType(ImageView.ScaleType.FIT_CENTER)
    logo_area.addView(
        logo,
        FrameLayout.LayoutParams(dp(78), dp(78), Gravity.CENTER),
    )
    _load_glassify_logo_into(logo)

    title = TextView(context)
    title.setText("Glassify")
    title.setTextColor(primary)
    title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 24.0)
    title.setTypeface(Typeface.DEFAULT, Typeface.BOLD)
    title.setGravity(Gravity.CENTER)
    title_params = LinearLayout.LayoutParams(
        ViewGroup.LayoutParams.MATCH_PARENT,
        ViewGroup.LayoutParams.WRAP_CONTENT,
    )
    header.addView(title, title_params)

    version = TextView(context)
    version.setText(f"{__version__.replace('-beta.', ' beta ')} · {__author__}")
    version.setTextColor(secondary)
    version.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14.0)
    version.setGravity(Gravity.CENTER)
    version_params = LinearLayout.LayoutParams(
        ViewGroup.LayoutParams.MATCH_PARENT,
        ViewGroup.LayoutParams.WRAP_CONTENT,
    )
    version_params.topMargin = dp(4)
    header.addView(version, version_params)
    return header


def _create_safe_custom_fallback(context, title_text, detail_text, resources_provider):
    """Create a dependency-light row when a rich custom settings view fails."""
    try:
        outer = LinearLayout(context)
        outer.setOrientation(LinearLayout.VERTICAL)
        outer.setGravity(Gravity.CENTER_VERTICAL)
        outer.setPadding(
            AndroidUtilities.dp(16),
            AndroidUtilities.dp(14),
            AndroidUtilities.dp(16),
            AndroidUtilities.dp(14),
        )

        title = TextView(context)
        title.setText(title_text)
        title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 16.0)
        try:
            title.setTextColor(
                _theme_color(
                    Theme.key_windowBackgroundWhiteBlackText, resources_provider
                )
            )
        except Exception as color_exc:
            _note_suppressed(color_exc)
        outer.addView(
            title,
            LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT,
                ViewGroup.LayoutParams.WRAP_CONTENT,
            ),
        )

        detail = TextView(context)
        detail.setText(detail_text)
        detail.setTextSize(TypedValue.COMPLEX_UNIT_SP, 13.0)
        detail.setSingleLine(False)
        try:
            detail.setTextColor(
                _theme_color(
                    getattr(
                        Theme,
                        "key_windowBackgroundWhiteGrayText",
                        Theme.key_windowBackgroundWhiteBlackText,
                    ),
                    resources_provider,
                )
            )
        except Exception as color_exc:
            _note_suppressed(color_exc)
        detail_params = LinearLayout.LayoutParams(
            ViewGroup.LayoutParams.MATCH_PARENT,
            ViewGroup.LayoutParams.WRAP_CONTENT,
        )
        detail_params.topMargin = AndroidUtilities.dp(4)
        outer.addView(detail, detail_params)
        return outer
    except Exception as fallback_exc:
        # Last-resort Android View with virtually no dependencies.
        _note_suppressed(fallback_exc)
        view = TextView(context)
        view.setText(title_text)
        return view


