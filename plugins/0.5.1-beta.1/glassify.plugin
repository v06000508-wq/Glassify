_UPDATE_NOTES = (
    (
        "Репозиторий и обновления",
        (
            (
                "Репозиторий на GitHub",
                "В разделе «О плагине» появилась кнопка с логотипом GitHub. "
                "Она открывает репозиторий Glassify и его расширений.",
            ),
            (
                "Выбор источника обновлений",
                "В разделе «Настройки → Обновления» можно открыть список релизов "
                "на GitHub или публикацию Glassify в группе exteraPlugins.",
            ),
        ),
    ),
)


def _create_update_report_view_impl(
    context,
    list_view,
    current_account,
    class_guid,
    resources_provider,
):
    outer = LinearLayout(context)
    outer.setOrientation(LinearLayout.VERTICAL)
    outer.setPadding(
        AndroidUtilities.dp(20),
        AndroidUtilities.dp(10),
        AndroidUtilities.dp(20),
        AndroidUtilities.dp(18),
    )

    primary = _theme_color(
        Theme.key_windowBackgroundWhiteBlackText,
        resources_provider,
    )
    secondary_key = getattr(
        Theme,
        "key_windowBackgroundWhiteGrayText2",
        getattr(
            Theme,
            "key_windowBackgroundWhiteGrayText",
            Theme.key_windowBackgroundWhiteBlackText,
        ),
    )
    secondary = _theme_color(secondary_key, resources_provider)
    accent_key = getattr(
        Theme,
        "key_windowBackgroundWhiteBlueHeader",
        getattr(
            Theme,
            "key_windowBackgroundWhiteBlueText",
            Theme.key_windowBackgroundWhiteBlackText,
        ),
    )
    accent = _theme_color(accent_key, resources_provider)

    def add_text(
        text,
        size=15,
        color=None,
        bold=False,
        top=0,
        bottom=0,
    ):
        view = TextView(context)
        view.setText(str(text))
        view.setTextSize(TypedValue.COMPLEX_UNIT_SP, float(size))
        view.setTextColor(int(primary if color is None else color))
        view.setSingleLine(False)
        view.setEllipsize(None)
        try:
            view.setLineSpacing(float(AndroidUtilities.dp(2)), 1.0)
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)
        if bold:
            try:
                view.setTypeface(Typeface.DEFAULT, Typeface.BOLD)
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

        params = LinearLayout.LayoutParams(
            ViewGroup.LayoutParams.MATCH_PARENT,
            ViewGroup.LayoutParams.WRAP_CONTENT,
        )
        params.topMargin = AndroidUtilities.dp(top)
        params.bottomMargin = AndroidUtilities.dp(bottom)
        outer.addView(view, params)
        return view

    def add_section(title):
        add_text(
            title,
            size=14,
            color=accent,
            bold=True,
            top=14,
            bottom=6,
        )

    def add_item(title, description):
        add_text(
            title,
            size=16,
            color=primary,
            bold=True,
            top=4,
            bottom=2,
        )
        add_text(
            description,
            size=14,
            color=secondary,
            bold=False,
            top=0,
            bottom=7,
        )

    add_text(
        f"Glassify {__version__}",
        size=21,
        color=primary,
        bold=True,
        top=2,
        bottom=6,
    )

    for title, changes in _UPDATE_NOTES:
        add_section(title)
        for name, detail in changes:
            add_item(name, detail)

    return outer


def _create_update_report_view(
    context,
    list_view,
    current_account,
    class_guid,
    resources_provider,
):
    try:
        return _create_update_report_view_impl(
            context, list_view, current_account, class_guid, resources_provider
        )
    except Exception as exc:
        _note_suppressed(exc)
        paragraphs = []
        for heading, changes in _UPDATE_NOTES:
            paragraphs.append(heading)
            paragraphs.extend(f"{title}\n{detail}" for title, detail in changes)
        fallback = TextView(context)
        fallback.setSingleLine(False)
        fallback.setEllipsize(None)
        fallback.setText("\n\n".join(paragraphs))
        fallback.setTextColor(
            _theme_color(Theme.key_windowBackgroundWhiteBlackText, resources_provider)
        )
        inset = AndroidUtilities.dp(16)
        fallback.setPadding(inset, inset, inset, inset)
        return fallback


UpdateReportFactory = SimpleSettingFactory(
    _create_update_report_view,
    _bind_static_setting_view,
    is_clickable=False,
)


def _create_extension_preview_view(
    extension_id: str,
    context,
    list_view,
    current_account,
    class_guid,
    resources_provider,
):
    outer = FrameLayout(context)
    outer.setPadding(
        AndroidUtilities.dp(16),
        AndroidUtilities.dp(8),
        AndroidUtilities.dp(16),
        AndroidUtilities.dp(10),
    )

    image = ImageView(context)
    image.setScaleType(ImageView.ScaleType.CENTER_CROP)
    image.setContentDescription(f"Предпросмотр расширения {extension_id}")
    try:
        image.setClipToOutline(True)
    except Exception as _suppressed_exc:
        _note_suppressed(_suppressed_exc)
    preview_background_key = getattr(
        Theme,
        "key_windowBackgroundGray",
        getattr(
            Theme,
            "key_windowBackgroundWhite",
            Theme.key_windowBackgroundWhiteBlackText,
        ),
    )
    image.setBackgroundColor(
        _theme_color(
            preview_background_key,
            resources_provider,
        )
    )
    try:
        background = GradientDrawable()
        background.setShape(GradientDrawable.RECTANGLE)
        background.setColor(
            _theme_color(
                preview_background_key,
                resources_provider,
            )
        )
        background.setCornerRadius(float(AndroidUtilities.dp(18)))
        image.setBackground(background)
    except Exception as _suppressed_exc:
        _note_suppressed(_suppressed_exc)

    try:
        screen_width = int(context.getResources().getDisplayMetrics().widthPixels)
    except Exception:
        screen_width = AndroidUtilities.dp(360)
    card_width = max(AndroidUtilities.dp(280), screen_width - AndroidUtilities.dp(32))
    card_height = max(
        AndroidUtilities.dp(150),
        min(AndroidUtilities.dp(220), int(card_width * 0.5)),
    )
    outer.addView(
        image,
        FrameLayout.LayoutParams(
            ViewGroup.LayoutParams.MATCH_PARENT,
            card_height,
        ),
    )

    placeholder = TextView(context)
    placeholder.setText("Загружаем предпросмотр…")
    placeholder.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14.0)
    placeholder.setGravity(Gravity.CENTER)
    placeholder.setTextColor(
        _theme_color(
            getattr(
                Theme,
                "key_windowBackgroundWhiteGrayText",
                Theme.key_windowBackgroundWhiteBlackText,
            ),
            resources_provider,
        )
    )
    outer.addView(
        placeholder,
        FrameLayout.LayoutParams(
            ViewGroup.LayoutParams.MATCH_PARENT,
            card_height,
        ),
    )
    return outer


def _bind_extension_preview_view(
    extension_id: str,
    view,
    item,
    divider,
    adapter,
    list_view,
):
    plugin = _ACTIVE_PLUGIN
    if plugin is not None:
        plugin._bind_extension_preview_view(extension_id, view)


def _extension_preview_factory(extension_id: str):
    factory = _EXTENSION_PREVIEW_FACTORIES.get(extension_id)
    if factory is not None:
        return factory

    def create(context, list_view, current_account, class_guid, resources_provider):
        try:
            return _create_extension_preview_view(
                extension_id,
                context,
                list_view,
                current_account,
                class_guid,
                resources_provider,
            )
        except Exception as exc:
            _note_suppressed(exc)
            return _create_safe_custom_fallback(
                context,
                "Предпросмотр недоступен",
                "Карточка расширения продолжает работать без изображения.",
                resources_provider,
            )

    def bind(view, item, divider, adapter, list_view):
        try:
            _bind_extension_preview_view(
                extension_id,
                view,
                item,
                divider,
                adapter,
                list_view,
            )
        except Exception as exc:
            _note_suppressed(exc)

    factory = SimpleSettingFactory(create, bind, is_clickable=False)
    _EXTENSION_PREVIEW_FACTORIES[extension_id] = factory
    return factory


class _RememberDrawableAfterHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if not self.plugin._plugin_alive or not self.plugin._native_available:
            return
        drawable = param.getResult()
        if drawable is None:
            return

        view = None
        try:
            if len(param.args) > 0:
                candidate = param.args[0]
                if candidate is not None and hasattr(candidate, "invalidate"):
                    view = candidate
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)

        self.plugin.track_liquid_drawable(drawable, view)


class _StaticPluginIconHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin", catalog=False):
        self.plugin = plugin
        self.catalog = catalog

    def after_hooked_method(self, param):
        if not self.plugin._plugin_alive:
            return
        try:
            if param.hasThrowable():
                return
            metadata = param.args[0]
            if metadata is None:
                return
            if self.catalog:
                plugin_id = metadata.getPluginId()
                icon_field = "iconView"
            else:
                if param.args[1] is None:
                    return
                plugin_id = metadata.getId()
                icon_field = "imageView"
            if str(plugin_id) != __id__:
                return

            cell = param.thisObject
            image_view = self.plugin.field(cell, icon_field)
            if not _load_glassify_logo_into(image_view):
                return
            image_view.setVisibility(View.VISIBLE)
            if self.catalog:
                placeholder = self.plugin.field(cell, "placeholderView")
                if placeholder is not None:
                    placeholder.setVisibility(View.GONE)
        except Exception as exc:
            _note_suppressed(exc)


class _InstallPluginIconHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin._plugin_alive:
            return
        try:
            sheet = param.thisObject
            metadata = self.plugin.field(sheet, "plugin")
            if metadata is None or str(metadata.getId()) != __id__:
                return
            params = self.plugin.field(sheet, "params")
            bitmap = _get_glassify_logo_bitmap()
            if params is not None and bitmap is not None:
                BitmapDrawable = jclass("android.graphics.drawable.BitmapDrawable")
                drawable = BitmapDrawable(param.args[0].getResources(), bitmap)
                drawable.setFilterBitmap(True)
                params.setIconDrawable(drawable)
        except Exception as exc:
            _note_suppressed(exc)


class _FragmentCreateHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin", kind: str, delay: int = 80):
        self.plugin = plugin
        self.kind = kind
        self.delay = delay

    def before_hooked_method(self, param):
        if not self.plugin._plugin_alive:
            return
        if not self.plugin._native_available:
            self.plugin.ensure_native_flags()
        if self.kind == "chat":
            self.plugin.begin_chat_create()

    def after_hooked_method(self, param):
        if not self.plugin._plugin_alive:
            return
        if self.kind == "chat":
            self.plugin.end_chat_create()
        fragment = param.thisObject
        root = param.getResult()
        if fragment is None or root is None:
            return

        if self.kind == "main_tabs":
            self.plugin.schedule(
                lambda: self.plugin.decorate_main_tabs(fragment, root),
                self.delay,
            )
            return

        if self.kind == "chat":
            key = _identity(fragment)

            # Keep the chat-opening fast path: keyboard/panel work is
            # deferred and independent from the top-header integration.
            self.plugin.schedule_coalesced(
                ("chat_bottom_panels_create", key),
                lambda fragment=fragment: self.plugin.decorate_chat_bottom_panels(fragment),
                260,
            )

            # Fallback only. Keep expensive M3 discovery comfortably outside
            # the opening animation if the transition callback is unavailable.
            self.plugin.schedule_coalesced(
                ("chat_post_transition", key),
                lambda fragment=fragment, root=root: self.plugin.decorate_fragment(
                    fragment,
                    root,
                    "chat",
                ),
                620,
            )
            return

        self.plugin.schedule(
            lambda: self.plugin.decorate_fragment(fragment, root, self.kind),
            self.delay,
        )


class _ChatTransitionEndAfterHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        fragment = param.thisObject

        # Telegram normally passes isOpen as the first boolean argument.
        # Ignore closing transitions so we never rebuild a header while a
        # fragment is leaving the screen.
        is_open = True
        try:
            if len(param.args) > 0:
                raw = param.args[0]
                text = str(raw).strip().lower()
                if text in ("false", "0"):
                    is_open = False
                elif text in ("true", "1"):
                    is_open = True
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)

        if not is_open:
            return

        key = _identity(fragment)
        root = self.plugin.field(fragment, "fragmentView")

        # Avoid full M3 discovery immediately after the transition, directly in
        # the first interactive frame. Give input/scroll a short head start.
        self.plugin.schedule_coalesced(
            ("chat_post_transition", key),
            lambda fragment=fragment, root=root: self.plugin.decorate_fragment(
                fragment,
                root,
                "chat",
            ),
            96,
        )


class _M3ChatHeaderColorsAfterHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        fragment = param.thisObject
        key = _identity(fragment)

        # Never perform M3 discovery from updateColors. Only refresh an already
        # installed fade, which is a cheap theme-color update.
        state = self.plugin._m3_chat_headers.get(key)
        if not isinstance(state, dict):
            return

        self.plugin.schedule_coalesced(
            ("m3_chat_header_colors", key),
            lambda state=state: self.plugin._apply_m3_chat_header_fade(state),
            32,
        )


class _GestureNavigationDiagnosticsHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin", invalidate_banner=False):
        self.plugin = plugin
        self.invalidate_banner = invalidate_banner

    def after_hooked_method(self, param):
        if not self.plugin._plugin_alive:
            return
        if self.plugin._transparent_gesture_enabled:
            if self.invalidate_banner:
                self.plugin._invalidate_gesture_update_banner(param.thisObject)
            self.plugin.schedule_coalesced(
                ("gesture_navigation_background",),
                self.plugin._refresh_gesture_background,
                16,
            )
        self.plugin.schedule_coalesced(
            ("gesture_navigation_diagnostics",),
            self.plugin._read_gesture_navigation_diagnostics,
            160,
        )


class _GestureFadeDrawHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin"):
        self.plugin = plugin
        self.layers = {}

    def before_hooked_method(self, param):
        state = self.plugin._gesture_background
        if state is None or _identity(param.thisObject) != _identity(state["drawable"]):
            return
        try:
            if not self.plugin._gesture_background_is_current(state):
                return
            bounds = param.thisObject.getBounds()
            if bounds.isEmpty():
                return
            mask = self.plugin._gesture_fade_mask(state, bounds)
            if mask is None:
                return
            canvas = param.args[0]
            area = tuple(float(edge) for edge in (bounds.left, bounds.top, bounds.right, bounds.bottom))
            token = _identity(param)
            layer = canvas.saveLayer(*area, None)
            self.layers[token] = (canvas, layer, area, mask, state)
        except Exception as exc:
            self.plugin._log_suppressed("mask tabs gradient at gesture edge", exc)

    def after_hooked_method(self, param):
        if not self.layers:
            return
        saved = self.layers.pop(_identity(param), None)
        if saved is None:
            return
        canvas, layer, area, mask, state = saved
        try:
            if not param.hasThrowable():
                canvas.drawRect(*area, mask)
                state["fade_drawn"] = True
        except Exception as exc:
            self.plugin._log_suppressed("apply tabs gradient mask", exc)
        finally:
            try:
                canvas.restoreToCount(layer)
            except Exception as exc:
                self.plugin._log_suppressed("restore tabs gradient canvas", exc)


class _GestureUnderlayDrawHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin"):
        self.plugin = plugin
        self.paints = {}

    def before_hooked_method(self, param):
        state = self.plugin._gesture_background
        if state is None or state["underlay"] is None:
            return
        if _identity(param.thisObject) != _identity(state["layout"]):
            return
        try:
            if not self.plugin._gesture_background_is_current(state):
                return
            # The root draws a colored rectangle with this Paint even when its
            # bottom sheet tabs are hidden. Restore it after this one draw.
            paint = state["underlay"]
            alpha = int(paint.getAlpha())
            if alpha:
                self.paints[_identity(param)] = (paint, alpha)
                paint.setAlpha(0)
        except Exception as exc:
            self.plugin._log_suppressed("hide main tabs gesture underlay", exc)

    def after_hooked_method(self, param):
        if not self.paints:
            return
        saved = self.paints.pop(_identity(param), None)
        if saved is None:
            return
        paint, alpha = saved
        try:
            if int(paint.getAlpha()) == 0:
                paint.setAlpha(alpha)
        except Exception as exc:
            self.plugin._log_suppressed("restore main tabs gesture underlay", exc)


class _HiddenUpdateBannerDrawHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin._plugin_alive or not self.plugin._transparent_gesture_enabled:
            return
        wrapper = param.thisObject
        wrapper_id = _identity(wrapper)
        if self.plugin._last_suppressed_update_banner == wrapper_id:
            self.plugin._last_suppressed_update_banner = None
        try:
            if (
                int(wrapper.getMeasuredHeight()) == 0
                and int(wrapper.getPaddingBottom()) > 0
                and not wrapper.isUpdateLayoutVisible()
                and self.plugin._has_bottom_gesture_inset(wrapper)
            ):
                # exteraGram draws [height - padding, height] even at height 0.
                # MainTabs can still draw this wrapper after losing focus.
                param.setResult(None)
                self.plugin._last_suppressed_update_banner = wrapper_id
        except Exception as exc:
            self.plugin._log_suppressed("skip hidden update banner gesture fill", exc)


class _DialogsStoriesRefreshHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        fragment = param.thisObject
        key = _identity(fragment)
        self.plugin.schedule_coalesced(
            ("stories_now", key),
            lambda fragment=fragment: self.plugin.refresh_dialogs_stories(fragment),
            0,
        )
        self.plugin.schedule_coalesced(
            ("stories_settle", key),
            lambda fragment=fragment: self.plugin.refresh_dialogs_stories(fragment),
            140,
        )


class _DialogsSearchVisibilityHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin._plugin_alive:
            return
        show = True
        try:
            show = bool(param.args[0])
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)

        if show:
            self.plugin.set_dialogs_overlay_visible(
                param.thisObject,
                False,
            )

    def after_hooked_method(self, param):
        fragment = param.thisObject
        key = _identity(fragment)
        self.plugin.schedule_coalesced(
            ("stories_search_now", key),
            lambda fragment=fragment: self.plugin.refresh_dialogs_stories(fragment),
            0,
        )
        self.plugin.schedule_coalesced(
            ("stories_search_settle", key),
            lambda fragment=fragment: self.plugin.refresh_dialogs_stories(fragment),
            320,
        )


class _DialogsSearchProgressAfterHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if float(param.args[0]) > 0.0:
            return
        fragment = param.thisObject
        self.plugin.schedule_coalesced(
            ("stories_search_now", _identity(fragment)),
            lambda: self.plugin.refresh_dialogs_stories(fragment),
            32,
        )


class _InAppKeyboardDrawableAfterHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        container = param.thisObject
        if _identity(container) not in self.plugin._keyboard_replace_guard:
            self.plugin.schedule_keyboard_container_refresh(container, 32)


