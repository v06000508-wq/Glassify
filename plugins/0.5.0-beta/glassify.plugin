class GlassifyExtensionAPI:
    """Small, tracked API exposed to optional Glassify extensions.

    Hook handles registered through this object are automatically removed when
    the extension is disabled, updated, removed, or when Glassify unloads.
    """

    __slots__ = (
        "__core",
        "_hook_handles",
        "_settings_callback_active",
        "_settings_listener",
        "_settings_schema",
        "_strength_listeners",
        "_dex_handles",
        "extension_id",
    )

    def __init__(self, core: "GlassifyPlugin", extension_id: str):
        self.__core = core
        self.extension_id = extension_id
        self._hook_handles: List[Any] = []
        self._strength_listeners: List[Any] = []
        self._settings_schema: List[Dict[str, Any]] = []
        self._settings_listener = None
        self._settings_callback_active = False
        self._dex_handles: List[Dict[str, Any]] = []

    def log(self, message: Any):
        self.__core.log(f"[Extension:{self.extension_id}] {message}")

    def get_setting(self, key: str, default: Any = None) -> Any:
        return self.__core.get_setting(
            f"extension.{self.extension_id}.{key}",
            default,
        )

    def set_setting(self, key: str, value: Any, reload_settings: bool = False):
        self.__core.set_setting(
            f"extension.{self.extension_id}.{key}",
            value,
            reload_settings=reload_settings,
        )

    def find_class(self, class_name: str):
        class_name = str(class_name)
        if not class_name.startswith(("android.", "org.telegram.")):
            raise ValueError("класс недоступен через Glassify API")
        return find_class(class_name)

    def get_last_fragment(self):
        return get_last_fragment()

    def run_on_ui_thread(self, callback):
        return self.__core.schedule(callback, 0)

    def schedule(self, callback, delay: int = 0):
        return self.__core.schedule(callback, delay)

    def current_strength(self) -> int:
        return self.__core.current_strength()

    def get_field(self, obj: Any, name: str):
        return self.__core.field(obj, str(name))

    def set_field(self, obj: Any, name: str, value: Any) -> bool:
        return bool(self.__core.set_field_value(obj, str(name), value))

    def dp(self, value: float) -> int:
        return self.__core.dp(value)

    def identity(self, obj: Any) -> int:
        return _identity(obj)

    def create_glass_surface(
        self,
        fragment: Any,
        view: Any,
        color_key: int,
        intensity: float = 0.72,
        radius: int = 24,
        prefer_light: bool = False,
    ):
        return self.__core.create_glass_surface(
            fragment, view, color_key, intensity, radius, prefer_light
        )

    def apply_glass_drawable(
        self,
        drawable: Any,
        view: Any,
        strength: int,
        prefer_light: bool = False,
    ) -> bool:
        return bool(
            self.__core.apply_glass_drawable(drawable, view, strength, prefer_light)
        )

    def rebuild_current_fragment_views(self):
        return self.__core.rebuild_current_fragment_views()

    def register_strength_listener(self, callback):
        if not callable(callback):
            raise TypeError("callback must be callable")
        self._strength_listeners.append(callback)

    def api_version(self) -> int:
        try:
            installed = self.__core._installed_extensions().get(self.extension_id) or {}
            return int(installed.get("api", 1))
        except Exception:
            return 1

    def _require_api4(self):
        if self.api_version() < 4:
            raise RuntimeError("This method requires Glassify Extension API 4")

    def _dex_find_method(self, clazz: Any, name: str, parameter_count: int):
        methods = clazz.getDeclaredMethods()
        for method in methods:
            try:
                if str(method.getName()) != str(name):
                    continue
                params = method.getParameterTypes()
                if len(params) != int(parameter_count):
                    continue
                try:
                    method.setAccessible(True)
                except Exception as _suppressed_exc:
                    _note_suppressed(_suppressed_exc)
                return method
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)
        raise RuntimeError("DEX method not found: " + str(name))

    def _dex_invoke(self, method: Any, receiver: Any, args: Any):
        values = list(args or [])
        Boolean = jclass("java.lang.Boolean")
        boxed = [Boolean.valueOf(value) if isinstance(value, bool) else value for value in values]
        errors = []
        try:
            return method.invoke(receiver, jarray(Object)(boxed))
        except Exception as exc:
            errors.append(str(exc))
        try:
            return method.invoke(receiver, *boxed)
        except Exception as exc:
            errors.append(str(exc))
        raise RuntimeError("DEX reflection invoke failed: " + " | ".join(errors[-2:]))

    def load_remote_dex(
        self,
        chunk_urls: Any,
        expected_sha256: str,
        expected_size: int,
        main_class_name: str,
    ):
        """Download a pinned, compressed DEX payload owned by this extension.

        API 4 intentionally exposes only this narrow loader instead of Python
        imports/open/DexClassLoader access to catalog extensions.
        """
        self._require_api4()
        urls = list(chunk_urls or [])
        if not 1 <= len(urls) <= 32:
            raise ValueError("DEX payload must contain 1 to 32 chunks")
        expected_sha256 = str(expected_sha256).lower().strip()
        if not _SHA256_RE.fullmatch(expected_sha256):
            raise ValueError("invalid DEX SHA-256")
        expected_size = int(expected_size)
        if not 1 <= expected_size <= 512 * 1024:
            raise ValueError("invalid DEX size")
        main_class_name = str(main_class_name).strip()
        if not main_class_name or len(main_class_name) > 240:
            raise ValueError("invalid DEX main class")

        prefix = (
            "https://raw.githubusercontent.com/v06000508-wq/Glassify/main/"
            f"extensions/{self.extension_id}/"
        )
        encoded_parts: List[bytes] = []
        encoded_total = 0
        encoded_limit = 384 * 1024
        for raw_url in urls:
            url = str(raw_url)
            if not url.startswith(prefix):
                raise ValueError("DEX chunk is outside this extension directory")
            response = requests.get(
                url,
                timeout=(5, 20),
                stream=True,
                headers={"User-Agent": f"Glassify/{__version__}"},
            )
            response.raise_for_status()
            length = response.headers.get("Content-Length")
            if length:
                try:
                    if int(length) > encoded_limit - encoded_total:
                        raise ValueError("compressed DEX payload is too large")
                except ValueError as exc:
                    if str(exc) == "compressed DEX payload is too large":
                        raise
            chunk_data: List[bytes] = []
            for piece in response.iter_content(chunk_size=8192):
                if not piece:
                    continue
                encoded_total += len(piece)
                if encoded_total > encoded_limit:
                    raise ValueError("compressed DEX payload is too large")
                chunk_data.append(piece)
            encoded_parts.append(b"".join(chunk_data).strip())

        try:
            packed = base64.b64decode(b"".join(encoded_parts), validate=True)
            decompressor = zlib.decompressobj()
            raw = decompressor.decompress(packed, expected_size + 1)
            if len(raw) > expected_size or not decompressor.eof:
                raise ValueError("DEX size mismatch")
        except Exception as exc:
            raise ValueError("invalid compressed DEX payload") from exc
        if len(raw) != expected_size:
            raise ValueError("DEX size mismatch")
        if hashlib.sha256(raw).hexdigest() != expected_sha256:
            raise ValueError("DEX SHA-256 mismatch")

        context = ApplicationLoader.applicationContext
        if context is None:
            raise RuntimeError("Application context is unavailable")
        base = str(context.getCodeCacheDir().getAbsolutePath())
        root = os.path.join(base, "glassify_dex")
        opt_dir = os.path.join(root, "opt")
        os.makedirs(opt_dir, mode=0o700, exist_ok=True)
        path = os.path.join(
            root,
            self.extension_id + "_" + expected_sha256[:12] + ".dex",
        )
        valid = False
        try:
            if os.path.isfile(path):
                with open(path, "rb") as existing_file:
                    existing = existing_file.read(expected_size + 1)
                valid = (
                    len(existing) == expected_size
                    and hashlib.sha256(existing).hexdigest() == expected_sha256
                )
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)
        if not valid:
            temp_path = path + ".tmp"
            try:
                os.remove(temp_path)
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)
            with open(temp_path, "wb") as stream:
                stream.write(raw)
                stream.flush()
                os.fsync(stream.fileno())
            os.chmod(temp_path, 0o444)
            os.replace(temp_path, path)
            os.chmod(path, 0o444)

        try:
            prefix = self.extension_id + "_"
            for filename in os.listdir(root):
                candidate = os.path.join(root, filename)
                if (
                    filename.startswith(prefix)
                    and filename.endswith(".dex")
                    and os.path.realpath(candidate) != os.path.realpath(path)
                    and os.path.isfile(candidate)
                ):
                    try:
                        os.remove(candidate)
                    except Exception as exc:
                        self.log("stale DEX cleanup failed: " + str(exc))
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)

        DexClassLoader = jclass("dalvik.system.DexClassLoader")
        loader = DexClassLoader(path, opt_dir, None, context.getClassLoader())
        clazz = loader.loadClass(main_class_name)
        handle = {
            "loader": loader,
            "class": clazz,
            "path": path,
            "active": False,
        }
        self._dex_handles.append(handle)
        return handle

    def activate_embedded_dex(self, handle: Any):
        self._require_api4()
        if not isinstance(handle, dict) or handle not in self._dex_handles:
            raise ValueError("unknown DEX handle")
        if bool(handle.get("active")):
            return True
        context = ApplicationLoader.applicationContext
        method = self._dex_find_method(handle.get("class"), "onLoad", 2)
        self._dex_invoke(method, None, [context, None])
        handle["active"] = True
        return True

    def call_embedded_dex(self, handle: Any, method_name: str, args: Any = None):
        self._require_api4()
        if not isinstance(handle, dict) or handle not in self._dex_handles:
            raise ValueError("unknown DEX handle")
        values = list(args or [])
        method = self._dex_find_method(handle.get("class"), str(method_name), len(values))
        return self._dex_invoke(method, None, values)

    def unload_embedded_dex(self, handle: Any):
        self._require_api4()
        if not isinstance(handle, dict) or handle not in self._dex_handles:
            return
        if bool(handle.get("active")):
            try:
                method = self._dex_find_method(handle.get("class"), "onUnload", 0)
                self._dex_invoke(method, None, [])
            except Exception as exc:
                self.log("DEX onUnload failed: " + str(exc))
        handle["active"] = False
        try:
            self._dex_handles.remove(handle)
        except ValueError:
            pass

    def register_settings(self, schema: Any, callback=None):
        """Register a small native settings page owned and rendered by core."""
        if callback is not None and not callable(callback):
            raise TypeError("settings callback must be callable")
        self._settings_schema = self.__core._validate_extension_settings_schema(schema)
        self._settings_listener = callback
        self.__core._reload_extension_settings()

    def request_settings_reload(self):
        self.__core._reload_extension_settings()

    def set_material_profile(self, profile: Any = None):
        """Apply a validated Blur3 material override for this extension.

        A user-triggered settings callback is restart-gated: the value is saved
        immediately, but rebuilding active Blur3 material objects is deferred
        until the next exteraGram process start.
        """
        if self._settings_callback_active:
            if profile is not None:
                self.__core._validate_material_profile(profile)
            self.log(
                f"Glassify {__version__}: extension material saved; "
                "live Blur3 rebuild deferred until restart"
            )
            return
        self.__core._set_extension_material_profile(self.extension_id, profile)

    def _notify_setting(self, key: str, value: Any) -> bool:
        callback = self._settings_listener
        if callback is None:
            self.__core._show_extension_restart_required(self.extension_id)
            return True

        succeeded = False
        self._settings_callback_active = True
        try:
            callback(str(key), value)
            succeeded = True
        except Exception as exc:
            self.log(f"settings callback failed: {exc}")
        finally:
            self._settings_callback_active = False

        if succeeded:
            self.__core._show_extension_restart_required(self.extension_id)
        return succeeded

    def _notify_strength(self, strength: int):
        for callback in list(self._strength_listeners):
            try:
                callback(int(strength))
            except Exception as exc:
                self.log(f"strength listener failed: {exc}")

    def hook_method(self, *args, **kwargs):
        handle = self.__core.hook_method(*args, **kwargs)
        self._remember_hooks(handle)
        return handle

    def hook_all_methods(self, *args, **kwargs):
        handles = self.__core.hook_all_methods(*args, **kwargs)
        self._remember_hooks(handles)
        return handles

    def hook_all_constructors(self, *args, **kwargs):
        handles = self.__core.hook_all_constructors(*args, **kwargs)
        self._remember_hooks(handles)
        return handles

    def _remember_hooks(self, handles: Any):
        if handles is None:
            return
        if isinstance(handles, (list, tuple, set)):
            self._hook_handles.extend(item for item in handles if item is not None)
        else:
            self._hook_handles.append(handles)

    def _cleanup(self):
        for handle in list(self._dex_handles):
            try:
                self.unload_embedded_dex(handle)
            except Exception as exc:
                self.log("failed to unload DEX: " + str(exc))
        self._dex_handles.clear()
        self.__core._set_extension_material_profile(self.extension_id, None)
        self._settings_schema.clear()
        self._settings_listener = None
        self._strength_listeners.clear()
        while self._hook_handles:
            handle = self._hook_handles.pop()
            try:
                self.__core.unhook_method(handle)
            except Exception as exc:
                self.log(f"failed to unhook method: {exc}")


class GlassifyPlugin(BasePlugin):
    DEFAULT_STRENGTH = GLASSIFY_DEFAULT_STRENGTH
    EXTENSIONS_ENABLED_KEY = "extensions_enabled"
    # "Размытие под шапкой" in the UI. The key keeps its historical name so
    # existing user choices survive the update.
    PROGRESSIVE_BLUR_ENABLED_KEY = "progressive_blur_enabled"
    STORIES_BLUR_ENABLED_KEY = "stories_blur_enabled"
    KEYBOARD_GLASS_ENABLED_KEY = "keyboard_glass_enabled"

    # The progressive blur above the chat title is optional Glassify Core UI.
    # Keep it permanently on the LiquidGlass+ Frosted surface so optional
    # extension surface choices cannot alter this navigation treatment.
    TOP_FROSTED_INTENSITY_SCALE = 0.42
    TOP_FROSTED_THICKNESS_SCALE = 0.55
    TOP_FROSTED_ALPHA_SCALE = 1.35

    def __init__(self):
        super().__init__()

        global _ACTIVE_PLUGIN
        _ACTIVE_PLUGIN = self

        self._native_available = False
        self._preview_strength: Optional[int] = None
        self._strength_cache: Optional[int] = None

        # Pure performance caches. They do not alter rendering values.
        self._field_reflection_cache: Dict[Tuple[str, str], Any] = {}
        self._missing_field_cache = set()
        self._m3_hint_fields_cache: Dict[str, Tuple[Any, ...]] = {}
        self._m3_fast_class_skip_cache: Dict[str, bool] = {}
        self._dp_cache: Dict[float, int] = {}
        self._material_revision = 0
        self._material_signature_cache: Dict[int, Tuple[int, int]] = {}
        self._liquid_values_cache: Dict[Tuple[int, int], Tuple[float, int]] = {}
        self._last_runtime_prune_at = 0.0
        self._coalesced_tokens: Dict[Any, int] = {}
        self._coalesced_sequence = 0

        self._liquid_drawables: Dict[int, Dict[str, Any]] = {}
        self._top_overlays: Dict[int, Dict[str, Any]] = {}
        self._runtime_refs: Dict[int, Dict[str, Any]] = {}
        self._keyboard_runtime: Dict[int, Dict[str, Any]] = {}
        self._keyboard_replace_guard = set()
        self._main_tabs_inset_shields: Dict[int, Dict[str, Any]] = {}
        self._m3_chat_headers: Dict[int, Dict[str, Any]] = {}
        self._m3_header_view_ids = set()
        self._m3_navigation_view_ids = set()
        self._chat_create_depth = 0
        self._deferred_liquid_drawables: Dict[int, Dict[str, Any]] = {}
        self._deferred_liquid_flush_scheduled = False
        self._plugin_alive = False
        self._scheduled_generation = 0
        self._suppressed_errors: Dict[str, int] = {}

        self._extension_lock = threading.RLock()
        self._extension_alive = False
        self._extension_generation = 0
        self._extension_stop_event = threading.Event()
        self._extension_root = ""
        self._extension_state_path = ""
        self._extension_catalog_path = ""
        self._extension_preview_root = ""
        self._extension_state: Dict[str, Any] = {"schema": 1, "installed": {}}
        self._extension_catalog: Dict[str, Dict[str, Any]] = {}
        self._extension_catalog_error = ""
        self._extension_modules: Dict[str, types.ModuleType] = {}
        self._extension_apis: Dict[str, GlassifyExtensionAPI] = {}
        self._extension_module_names: Dict[str, str] = {}
        self._extension_jobs: Dict[str, str] = {}
        self._extension_last_errors: Dict[str, str] = {}
        self._extension_preview_jobs: Dict[str, bool] = {}
        self._extension_preview_waiters: Dict[str, List[Any]] = {}
        self._extension_preview_bitmaps: Dict[str, Any] = {}
        self._extension_material_profiles: Dict[str, Dict[str, float]] = {}
        self._extension_restart_prompt_at = 0.0

        # Settings UI state.
        self._area_flag_cache: Dict[str, bool] = {}
        self._last_dialogs_fragment = None
        self._pending_uninstall: Tuple[str, float] = ("", 0.0)

    def on_plugin_load(self):
        global _SUPPRESSED_FAILURE_TOTAL
        _SUPPRESSED_FAILURES.clear()
        _SUPPRESSED_FAILURE_TOTAL = 0
        self._plugin_alive = True
        self._area_flag_cache.clear()
        self._scheduled_generation += 1
        self.log(f"Glassify {__version__}: loading")
        self.ensure_native_flags()
        self.install_hooks()
        if self._extensions_master_enabled():
            self._initialize_extension_manager()
            self._start_extension_manager()
        else:
            self.log("Glassify extensions: disabled by default")

        if self._native_available:
            self.log(
                f"Glassify: native blur3 enabled; strength={self.current_strength()}"
            )
        else:
            self.log(
                "Glassify: native blur3 unavailable; native rendering is left unchanged"
            )

    def on_plugin_unload(self):
        self._plugin_alive = False
        self._scheduled_generation += 1
        global _ACTIVE_PLUGIN, _GLASSIFY_LOGO_BITMAP, _GLASSIFY_LOGO_FETCHING
        if _ACTIVE_PLUGIN is self:
            _ACTIVE_PLUGIN = None

        self._stop_extension_manager()
        self.remove_top_overlays()
        self._runtime_refs.clear()
        self.restore_keyboard_panels()
        self.restore_main_tabs_inset_shields()
        self.restore_m3_chat_headers()
        self.restore_drawables()
        self._chat_create_depth = 0
        self._deferred_liquid_drawables.clear()
        self._deferred_liquid_flush_scheduled = False
        self._m3_navigation_view_ids.clear()
        self._m3_fast_class_skip_cache.clear()
        self._m3_hint_fields_cache.clear()
        self._missing_field_cache.clear()
        self._coalesced_tokens.clear()

        _SLIDER_LISTENERS.clear()
        _STRENGTH_CARDS.clear()
        _CLICK_CALLBACKS.clear()
        _CLICK_LISTENERS.clear()
        self._area_flag_cache.clear()
        self._last_dialogs_fragment = None
        _EXTENSION_PREVIEW_FACTORIES.clear()
        with _GLASSIFY_LOGO_LOCK:
            logo_overlays = list(_GLASSIFY_LOGO_OVERLAYS.values())
            _GLASSIFY_LOGO_OVERLAYS.clear()
            _GLASSIFY_LOGO_WAITERS.clear()
            _GLASSIFY_LOGO_BITMAP = None
            _GLASSIFY_LOGO_FETCHING = False
        for entry in logo_overlays:
            try:
                if isinstance(entry, tuple):
                    logo_view, logo_drawable = entry
                    logo_view.getOverlay().remove(logo_drawable)
            except Exception as exc:
                self._log_suppressed("detach Glassify logo overlay", exc)
        # Do not recycle the logo bitmap here: a normal ImageView may still be
        # drawing it. Dropping Glassify's global reference is sufficient.
        if _SUPPRESSED_FAILURE_TOTAL:
            self.log(
                "Glassify diagnostics: "
                f"{_SUPPRESSED_FAILURE_TOTAL} compatibility fallbacks in "
                f"{len(_SUPPRESSED_FAILURES)} locations"
            )
        self.log("Glassify unloaded. Restart exteraGram to rebuild current screens.")

    # ------------------------------------------------------------------
    # Area preferences: header blur, stories glass, keyboard glass
    # ------------------------------------------------------------------

    def _area_enabled(self, key: str) -> bool:
        # Hot paths (slider ticks, keyboard refreshes) read these flags, so
        # keep the persisted value in memory after the first read.
        cached = self._area_flag_cache.get(key)
        if cached is not None:
            return cached
        try:
            value = bool(self.get_setting(key, True))
        except Exception as exc:
            self._log_suppressed("read area preference", exc)
            value = True
        self._area_flag_cache[key] = value
        return value

    def _store_area_flag(self, key: str, value: Any) -> bool:
        enabled = bool(value)
        # Persist first so an immediate UI callback/rebuild observes the new
        # state instead of the value from the previous settings frame.
        self.set_setting(key, enabled)
        self._area_flag_cache[key] = enabled
        return enabled

    def _progressive_blur_enabled(self) -> bool:
        return self._area_enabled(self.PROGRESSIVE_BLUR_ENABLED_KEY)

    def _stories_blur_enabled(self) -> bool:
        return self._area_enabled(self.STORIES_BLUR_ENABLED_KEY)

    def _keyboard_glass_enabled(self) -> bool:
        return self._area_enabled(self.KEYBOARD_GLASS_ENABLED_KEY)

    def _top_overlay_allowed(self, data: Any) -> bool:
        if isinstance(data, dict) and data.get("kind") == "dialogs_stories":
            return self._stories_blur_enabled()
        return self._progressive_blur_enabled()

    def _remove_disallowed_top_overlays(self):
        for key, data in list(self._top_overlays.items()):
            if not self._top_overlay_allowed(data):
                self._remove_top_overlay_data(data)
                self._top_overlays.pop(key, None)

    def _progressive_blur_changed(self, value: Any):
        enabled = self._store_area_flag(self.PROGRESSIVE_BLUR_ENABLED_KEY, value)

        if not enabled:
            # Remove the header Blur3 overlays immediately. Stories glass has
            # its own switch, and M3's windowBackgroundWhite color fade is
            # stored separately in _m3_chat_headers and stays active.
            self._remove_disallowed_top_overlays()
        else:
            # Rebuild the screens behind settings so the effect is back without
            # reopening a chat. Every overlay is dropped first: the rebuild
            # recreates them for the new views instead of updating old ones.
            self.remove_top_overlays()
            self.schedule(self.rebuild_current_fragment_views, 0)

    def _stories_blur_changed(self, value: Any):
        enabled = self._store_area_flag(self.STORIES_BLUR_ENABLED_KEY, value)
        if not enabled:
            self._remove_disallowed_top_overlays()
            return
        fragment = self._last_dialogs_fragment
        if fragment is not None and self.field(fragment, "fragmentView") is not None:
            self.schedule(
                lambda fragment=fragment: self.refresh_dialogs_stories(fragment),
                0,
            )

    def _keyboard_glass_changed(self, value: Any):
        enabled = self._store_area_flag(self.KEYBOARD_GLASS_ENABLED_KEY, value)
        if not enabled:
            # Put Telegram's own keyboard, emoji and bot panel backgrounds back.
            self.restore_keyboard_panels()
        # When enabled, panels pick the glass up the next time they are shown.

    # ------------------------------------------------------------------
    # Extension manager
    # ------------------------------------------------------------------

    def _extensions_master_enabled(self) -> bool:
        return bool(self.get_setting(self.EXTENSIONS_ENABLED_KEY, False))

    def _extensions_master_changed(self, value: Any):
        enabled = bool(value)
        # _start_extension_manager() checks the persisted master flag, so the
        # new value must be committed before starting/stopping the manager.
        self.set_setting(
            self.EXTENSIONS_ENABLED_KEY,
            enabled,
            reload_settings=True,
        )
        if enabled:
            if not self._extension_alive:
                self._initialize_extension_manager()
            self._start_extension_manager()
        else:
            if self._extension_alive:
                self._stop_extension_manager()

    def _initialize_extension_manager(self):
        """Prepare local extension storage without performing network I/O."""
        self._extension_generation += 1
        self._extension_stop_event = threading.Event()
        try:
            base_dir = (
                ApplicationLoader.applicationContext.getFilesDir().getAbsolutePath()
            )
            self._extension_root = os.path.join(base_dir, "glassify_extensions")
            self._extension_state_path = os.path.join(
                self._extension_root, "state.json"
            )
            self._extension_catalog_path = os.path.join(
                self._extension_root,
                "catalog_cache.json",
            )
            self._extension_preview_root = os.path.join(
                self._extension_root,
                "previews",
            )
            os.makedirs(self._extension_root, exist_ok=True)
            os.makedirs(self._extension_preview_root, exist_ok=True)
            self._load_extension_state()
            self._load_cached_extension_catalog()
            self._extension_alive = True
        except Exception as exc:
            self._extension_alive = False
            self.log(f"Glassify extensions: initialization failed: {exc}")

    def _start_extension_manager(self):
        if not self._extensions_master_enabled() or not self._extension_alive:
            return

        for extension_id in list(self._installed_extensions().keys()):
            if self._extension_enabled(extension_id):
                self._load_extension(extension_id)

        self._refresh_extension_catalog_async(silent=True)

    def _stop_extension_manager(self):
        self._extension_alive = False
        self._extension_stop_event.set()
        self._extension_generation += 1
        for extension_id in list(self._extension_modules.keys()):
            self._unload_extension(extension_id)
        with self._extension_lock:
            self._extension_jobs.clear()
            self._extension_preview_jobs.clear()
            self._extension_preview_waiters.clear()
        self._clear_extension_preview_bitmaps()

    def _extension_worker_context(self) -> Tuple[int, threading.Event]:
        return self._extension_generation, self._extension_stop_event

    def _extension_worker_active(
        self,
        generation: int,
        stop_event: threading.Event,
    ) -> bool:
        return bool(
            self._plugin_alive
            and self._extension_alive
            and generation == self._extension_generation
            and stop_event is self._extension_stop_event
            and not stop_event.is_set()
        )

    def _require_extension_worker_active(
        self,
        generation: int,
        stop_event: threading.Event,
    ):
        if not self._extension_worker_active(generation, stop_event):
            raise RuntimeError("операция отменена: Glassify выгружен")

    def _run_on_ui_sync(self, callback, timeout: float = 8.0):
        try:
            Looper = jclass("android.os.Looper")
            if Looper.myLooper() == Looper.getMainLooper():
                return callback()
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)

        finished = threading.Event()
        state_lock = threading.Lock()
        state = {"started": False, "cancelled": False}
        result: Dict[str, Any] = {}

        def invoke():
            with state_lock:
                if state["cancelled"]:
                    finished.set()
                    return
                state["started"] = True
            try:
                result["value"] = callback()
            except BaseException as exc:
                result["error"] = exc
            finally:
                finished.set()

        run_on_ui_thread(invoke)
        if not finished.wait(max(0.1, float(timeout))):
            with state_lock:
                if not state["started"]:
                    state["cancelled"] = True
                    cancelled_before_start = True
                else:
                    cancelled_before_start = False
            if cancelled_before_start:
                raise TimeoutError("UI-поток не ответил вовремя; задача отменена")
            # The callback has already entered the UI thread. Returning now would
            # let rollback race with a still-running callback, so wait for that
            # single in-flight operation to finish instead of executing it later.
            finished.wait()
        if "error" in result:
            raise result["error"]
        return result.get("value")

    def _current_exteragram_version(self) -> Optional[Version]:
        context = getattr(ApplicationLoader, "applicationContext", None)
        if context is None:
            return None
        try:
            package_name = str(context.getPackageName())
            package_info = context.getPackageManager().getPackageInfo(
                package_name,
                0,
            )
            raw = str(package_info.versionName or "").strip()
        except Exception as exc:
            self._log_suppressed("read exteraGram version", exc)
            return None
        match = re.search(r"\d+(?:\.\d+)+", raw)
        if match is None:
            return None
        try:
            return Version(match.group(0))
        except InvalidVersion:
            return None

    def _installed_extensions(self) -> Dict[str, Dict[str, Any]]:
        installed = self._extension_state.get("installed", {})
        if not isinstance(installed, dict):
            return {}
        return {
            str(extension_id): entry
            for extension_id, entry in installed.items()
            if _EXTENSION_ID_RE.fullmatch(str(extension_id))
            and isinstance(entry, dict)
        }

    def _sanitize_installed_extension_entry(
        self,
        extension_id: str,
        raw_entry: Any,
    ) -> Optional[Dict[str, Any]]:
        if not _EXTENSION_ID_RE.fullmatch(extension_id) or not isinstance(raw_entry, dict):
            return None
        try:
            version = str(raw_entry.get("version") or "").strip()
            Version(version)
            api = int(raw_entry.get("api", 0))
            if api < 1 or api > GLASSIFY_EXTENSION_API:
                return None
            min_glassify = str(raw_entry.get("min_glassify") or "0").strip()
            Version(min_glassify)
            min_exteragram = str(raw_entry.get("min_exteragram") or "").strip()
            if min_exteragram:
                Version(min_exteragram)
            sha256 = str(raw_entry.get("sha256") or "").lower().strip()
            commit = str(raw_entry.get("commit") or "").lower().strip()
            blob_sha = str(raw_entry.get("blob_sha") or "").lower().strip()
            if not _SHA256_RE.fullmatch(sha256):
                return None
            if not _GIT_COMMIT_RE.fullmatch(commit):
                return None
            if not _GIT_BLOB_RE.fullmatch(blob_sha):
                return None
            path = str(raw_entry.get("path") or "").strip()
            if not path or os.path.isabs(path):
                return None
            normalized = os.path.normpath(path).replace("\\", "/")
            expected = f"installed/{extension_id}/{version}/extension.py"
            if normalized != expected:
                return None
            installed_at = int(raw_entry.get("installed_at", 0) or 0)
            if installed_at < 0:
                installed_at = 0
        except (InvalidVersion, TypeError, ValueError, OverflowError):
            return None
        return {
            "version": version,
            "api": api,
            "min_glassify": min_glassify,
            "min_exteragram": min_exteragram,
            "sha256": sha256,
            "commit": commit,
            "blob_sha": blob_sha,
            "path": normalized,
            "installed_at": installed_at,
        }

    def _load_extension_state(self):
        state = {"schema": 1, "installed": {}}
        state_changed = False
        if self._extension_state_path and os.path.isfile(self._extension_state_path):
            try:
                with open(self._extension_state_path, "r", encoding="utf-8") as handle:
                    loaded = json.load(handle)
                if isinstance(loaded, dict) and isinstance(
                    loaded.get("installed"), dict
                ):
                    clean_installed: Dict[str, Dict[str, Any]] = {}
                    for raw_id, raw_entry in loaded.get("installed", {}).items():
                        extension_id = str(raw_id or "").strip()
                        cleaned = self._sanitize_installed_extension_entry(
                            extension_id, raw_entry
                        )
                        if cleaned is None:
                            state_changed = True
                            continue
                        clean_installed[extension_id] = cleaned
                        if cleaned != raw_entry:
                            state_changed = True
                    state = {"schema": 1, "installed": clean_installed}
                    if loaded.get("schema") != 1:
                        state_changed = True
                else:
                    state_changed = True
            except Exception as exc:
                state_changed = True
                self.log(f"Glassify extensions: state reset after read error: {exc}")
        self._extension_state = state
        if state_changed and self._extension_state_path:
            try:
                self._save_extension_state()
            except Exception as exc:
                self._log_suppressed("rewrite cleaned extension state", exc)

    def _save_extension_state(self):
        if not self._extension_state_path:
            return
        self._write_json_atomic(self._extension_state_path, self._extension_state)

    def _write_json_atomic(self, path: str, payload: Dict[str, Any]):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        temp_path = f"{path}.{uuid.uuid4().hex}.tmp"
        try:
            with open(temp_path, "x", encoding="utf-8") as handle:
                json.dump(
                    payload,
                    handle,
                    ensure_ascii=False,
                    indent=2,
                    sort_keys=True,
                )
                handle.write("\n")
                handle.flush()
                try:
                    os.fsync(handle.fileno())
                except Exception as exc:
                    self._log_suppressed("sync JSON state", exc)
            os.replace(temp_path, path)
        finally:
            if os.path.exists(temp_path):
                try:
                    os.remove(temp_path)
                except Exception as exc:
                    self._log_suppressed("clean JSON staging", exc)

    def _write_bytes_atomic(self, path: str, data: bytes):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        temp_path = f"{path}.{uuid.uuid4().hex}.tmp"
        try:
            with open(temp_path, "xb") as handle:
                handle.write(data)
                handle.flush()
                try:
                    os.fsync(handle.fileno())
                except Exception as exc:
                    self._log_suppressed("sync preview cache", exc)
            os.replace(temp_path, path)
        finally:
            if os.path.exists(temp_path):
                try:
                    os.remove(temp_path)
                except Exception as exc:
                    self._log_suppressed("clean preview cache staging", exc)

    def _load_cached_extension_catalog(self):
        if not self._extension_catalog_path or not os.path.isfile(
            self._extension_catalog_path
        ):
            return
        try:
            with open(self._extension_catalog_path, "r", encoding="utf-8") as handle:
                payload = json.load(handle)
            catalog = self._validate_extension_catalog(payload)
            self._extension_catalog = catalog
            self._cleanup_extension_preview_cache()
        except Exception as exc:
            self.log(f"Glassify extensions: cached catalog ignored: {exc}")

    def _validate_extension_catalog(
        self,
        payload: Any,
    ) -> Dict[str, Dict[str, Any]]:
        if not isinstance(payload, dict) or payload.get("schema") != 1:
            raise ValueError("unsupported catalog schema")

        entries = payload.get("extensions")
        if not isinstance(entries, list):
            raise ValueError("catalog extensions must be a list")
        if len(entries) > 100:
            raise ValueError("catalog contains too many extensions")

        result: Dict[str, Dict[str, Any]] = {}
        for raw in entries:
            if not isinstance(raw, dict):
                continue
            extension_id = str(raw.get("id", "")).strip()
            version = str(raw.get("version", "")).strip()
            file_url = str(raw.get("file", "")).strip()
            sha256 = str(raw.get("sha256", "")).lower().strip()
            source_commit = str(raw.get("commit", "")).lower().strip()
            blob_sha = str(raw.get("blob_sha", "")).lower().strip()
            min_glassify = str(raw.get("min_glassify") or "0").strip()
            min_exteragram = str(raw.get("min_exteragram") or "").strip()
            api = raw.get("api", 0)
            # Accept preview_v2 as a compatibility alias for older catalog layouts.
            # This keeps catalog parsing stable across previously published layouts.

            preview_raw = raw.get("preview_v2") or raw.get("preview")

            if not _EXTENSION_ID_RE.fullmatch(extension_id):
                continue
            if extension_id in result:
                continue
            try:
                Version(version)
                Version(min_glassify)
                if min_exteragram:
                    Version(min_exteragram)
            except InvalidVersion:
                continue
            try:
                api = int(api)
            except (TypeError, ValueError):
                continue
            if api < 1:
                continue
            if not _SHA256_RE.fullmatch(sha256):
                continue
            # Remote executable code must be pinned to immutable Git objects.
            if not _GIT_COMMIT_RE.fullmatch(source_commit):
                continue
            if not _GIT_BLOB_RE.fullmatch(blob_sha):
                continue
            if not self._extension_url_allowed(file_url, extension_id, version):
                continue

            item = {
                "id": extension_id,
                "name": str(raw.get("name") or extension_id)[:80],
                "description": str(raw.get("description") or "")[:400],
                "version": version,
                "api": api,
                "min_glassify": min_glassify,
                "min_exteragram": min_exteragram,
                "file": file_url,
                "sha256": sha256,
                "commit": source_commit,
                "blob_sha": blob_sha,
            }
            if isinstance(preview_raw, dict):
                preview_file = str(preview_raw.get("file") or "").strip()
                preview_sha256 = str(preview_raw.get("sha256") or "").lower().strip()
                if _SHA256_RE.fullmatch(
                    preview_sha256
                ) and self._extension_preview_url_allowed(
                    preview_file,
                    extension_id,
                    version,
                ):
                    item["preview"] = {
                        "file": preview_file,
                        "sha256": preview_sha256,
                    }
            result[extension_id] = item
        return result

    def _extension_url_allowed(
        self,
        file_url: str,
        extension_id: str,
        version: str,
    ) -> bool:
        if not file_url.startswith(GLASSIFY_EXTENSION_RAW_PREFIX):
            return False
        try:
            parsed = urlparse(file_url)
        except Exception:
            return False
        if parsed.scheme != "https" or parsed.netloc != "raw.githubusercontent.com":
            return False
        expected = f"/v06000508-wq/Glassify/main/extensions/{extension_id}/{version}/"
        return (
            parsed.path == expected + "extension.py"
            and not parsed.query
            and not parsed.fragment
        )

    def _extension_preview_url_allowed(
        self,
        preview_url: str,
        extension_id: str,
        version: str,
    ) -> bool:
        if not preview_url.startswith(GLASSIFY_EXTENSION_RAW_PREFIX):
            return False
        try:
            parsed = urlparse(preview_url)
        except Exception:
            return False
        expected = f"/v06000508-wq/Glassify/main/extensions/{extension_id}/{version}/"
        filename = os.path.basename(parsed.path)
        return bool(
            parsed.scheme == "https"
            and parsed.netloc == "raw.githubusercontent.com"
            and _PREVIEW_FILE_RE.fullmatch(filename)
            and parsed.path == expected + filename
            and not parsed.query
            and not parsed.fragment
        )

    def _refresh_extension_catalog_clicked(self, _view=None):
        self._refresh_extension_catalog_async(silent=False)

    def _download_extension_catalog(self) -> bytes:
        """Fetch the catalog through GitHub API, with raw CDN as fallback.

        raw.githubusercontent.com is unavailable on some networks even when
        api.github.com works. The API route also avoids stale intermediary
        caches because the file content is returned in a JSON envelope.
        """
        failures: List[str] = []

        try:
            response = requests.get(
                GLASSIFY_CATALOG_API_URL,
                params={"ref": "main"},
                timeout=(5, 12),
                headers={
                    "User-Agent": f"Glassify/{__version__}",
                    "Accept": "application/vnd.github+json",
                    "Cache-Control": "no-cache, no-store, max-age=0",
                    "Pragma": "no-cache",
                },
            )
            response.raise_for_status()
            envelope = response.json()
            encoded = envelope.get("content") if isinstance(envelope, dict) else None
            encoding = envelope.get("encoding") if isinstance(envelope, dict) else None
            if encoding != "base64" or not isinstance(encoded, str):
                raise ValueError("GitHub API вернул некорректный каталог")
            return _decode_github_base64(
                encoded,
                GLASSIFY_MAX_CATALOG_BYTES,
                "catalog",
            )
        except Exception as exc:
            failures.append(f"API: {exc}")

        try:
            separator = "&" if "?" in GLASSIFY_CATALOG_URL else "?"
            catalog_url = (
                f"{GLASSIFY_CATALOG_URL}{separator}"
                f"_glassify_ts={int(time.time() * 1000)}"
            )
            response = requests.get(
                catalog_url,
                stream=True,
                timeout=(5, 12),
                headers={
                    "User-Agent": f"Glassify/{__version__}",
                    "Cache-Control": "no-cache, no-store, max-age=0",
                    "Pragma": "no-cache",
                },
            )
            response.raise_for_status()
            length = response.headers.get("Content-Length")
            if length is not None:
                try:
                    if int(length) > GLASSIFY_MAX_CATALOG_BYTES:
                        raise ValueError("catalog is too large")
                except ValueError as exc:
                    if str(exc) == "catalog is too large":
                        raise
            chunks: List[bytes] = []
            total = 0
            for chunk in response.iter_content(chunk_size=16384):
                if not chunk:
                    continue
                total += len(chunk)
                if total > GLASSIFY_MAX_CATALOG_BYTES:
                    raise ValueError("catalog is too large")
                chunks.append(chunk)
            content = b"".join(chunks)
            if not content:
                raise ValueError("catalog is empty")
            return content
        except Exception as exc:
            failures.append(f"raw: {exc}")

        raise RuntimeError("; ".join(failures))

    def _extension_preview_key(self, entry: Dict[str, Any]) -> str:
        preview = entry.get("preview") or {}
        return ":".join(
            (
                str(entry.get("id") or ""),
                str(entry.get("version") or ""),
                str(preview.get("sha256") or ""),
            )
        )

    def _extension_preview_cache_path(self, entry: Dict[str, Any]) -> str:
        preview = entry.get("preview") or {}
        digest = str(preview.get("sha256") or "")
        extension_id = str(entry.get("id") or "")
        version = str(entry.get("version") or "")
        root = os.path.realpath(self._extension_preview_root)
        candidate = os.path.realpath(
            os.path.join(root, extension_id, f"{version}-{digest[:20]}.image")
        )
        if candidate == root or not candidate.startswith(root + os.sep):
            raise ValueError("invalid preview cache path")
        return candidate

    def _read_cached_extension_preview(self, entry: Dict[str, Any]) -> bytes:
        path = self._extension_preview_cache_path(entry)
        size = os.path.getsize(path)
        if size <= 0 or size > GLASSIFY_MAX_PREVIEW_BYTES:
            raise ValueError("invalid cached preview size")
        with open(path, "rb") as handle:
            data = handle.read(GLASSIFY_MAX_PREVIEW_BYTES + 1)
        if len(data) > GLASSIFY_MAX_PREVIEW_BYTES:
            raise ValueError("cached preview is too large")
        expected = str((entry.get("preview") or {}).get("sha256") or "")
        if hashlib.sha256(data).hexdigest() != expected:
            raise ValueError("cached preview hash mismatch")
        return data

    def _download_extension_preview(self, entry: Dict[str, Any]) -> bytes:
        preview = entry.get("preview") or {}
        preview_url = str(preview.get("file") or "")
        expected_digest = str(preview.get("sha256") or "")
        if not self._extension_preview_url_allowed(
            preview_url,
            str(entry.get("id") or ""),
            str(entry.get("version") or ""),
        ):
            raise ValueError("invalid preview URL")

        parsed = urlparse(preview_url)
        marker = "/v06000508-wq/Glassify/main/"
        if not parsed.path.startswith(marker):
            raise ValueError("invalid preview repository path")
        repository_path = parsed.path[len(marker) :]
        failures: List[str] = []

        try:
            api_url = (
                "https://api.github.com/repos/v06000508-wq/Glassify/contents/"
                + repository_path
            )
            response = requests.get(
                api_url,
                params={"ref": "main"},
                timeout=(5, 15),
                headers={
                    "User-Agent": f"Glassify/{__version__}",
                    "Accept": "application/vnd.github+json",
                    "Cache-Control": "no-cache, no-store, max-age=0",
                },
            )
            response.raise_for_status()
            envelope = response.json()
            encoded = envelope.get("content") if isinstance(envelope, dict) else None
            encoding = envelope.get("encoding") if isinstance(envelope, dict) else None
            if encoding != "base64" or not isinstance(encoded, str):
                raise ValueError("GitHub API вернул некорректное изображение")
            data = _decode_github_base64(
                encoded,
                GLASSIFY_MAX_PREVIEW_BYTES,
                "preview",
            )
        except Exception as exc:
            failures.append(f"API: {exc}")
        else:
            if hashlib.sha256(data).hexdigest() != expected_digest:
                raise ValueError("preview SHA-256 mismatch")
            return data

        try:
            response = requests.get(
                preview_url,
                stream=True,
                timeout=(5, 15),
                headers={
                    "User-Agent": f"Glassify/{__version__}",
                    "Cache-Control": "no-cache, no-store, max-age=0",
                },
            )
            response.raise_for_status()
            length = response.headers.get("Content-Length")
            if length is not None and int(length) > GLASSIFY_MAX_PREVIEW_BYTES:
                raise ValueError("preview is too large")
            chunks: List[bytes] = []
            total = 0
            for chunk in response.iter_content(chunk_size=32768):
                if not chunk:
                    continue
                total += len(chunk)
                if total > GLASSIFY_MAX_PREVIEW_BYTES:
                    raise ValueError("preview is too large")
                chunks.append(chunk)
            data = b"".join(chunks)
            if not data:
                raise ValueError("preview is empty")
            if hashlib.sha256(data).hexdigest() != expected_digest:
                raise ValueError("preview SHA-256 mismatch")
            return data
        except Exception as exc:
            failures.append(f"raw: {exc}")

        raise RuntimeError("; ".join(failures))

    def _decode_extension_preview(self, path: str):
        options_class = jclass("android.graphics.BitmapFactory$Options")

        bounds = options_class()
        bounds.inJustDecodeBounds = True
        BitmapFactory.decodeFile(path, bounds)
        width = int(bounds.outWidth)
        height = int(bounds.outHeight)
        if width <= 0 or height <= 0:
            raise ValueError("Android не смог прочитать размер изображения")

        sample = 1
        while (
            width // sample > GLASSIFY_MAX_PREVIEW_DIMENSION
            or height // sample > GLASSIFY_MAX_PREVIEW_DIMENSION
            or (width // sample) * (height // sample) > GLASSIFY_MAX_PREVIEW_PIXELS
        ):
            sample *= 2

        options = options_class()
        options.inSampleSize = sample
        bitmap = BitmapFactory.decodeFile(path, options)
        if bitmap is None:
            raise ValueError("Android не смог декодировать изображение")

        decoded_pixels = int(bitmap.getWidth()) * int(bitmap.getHeight())
        if decoded_pixels > GLASSIFY_MAX_PREVIEW_PIXELS:
            try:
                bitmap.recycle()
            except Exception as exc:
                self._log_suppressed("recycle oversized preview", exc)
            raise ValueError("декодированное изображение слишком большое")
        return bitmap

    def _set_extension_preview_view(
        self,
        view: Any,
        bitmap: Any = None,
        message: str = "",
    ):
        try:
            image = view.getChildAt(0)
            placeholder = view.getChildAt(1)
            if bitmap is not None:
                image.setImageBitmap(bitmap)
                placeholder.setVisibility(View.GONE)
            else:
                image.setImageDrawable(None)
                placeholder.setText(message or "Загружаем предпросмотр…")
                placeholder.setVisibility(View.VISIBLE)
        except Exception as exc:
            self._log_suppressed("bind extension preview", exc)

    def _clear_extension_preview_bitmaps(self):
        # Do not call Bitmap.recycle() here: an ImageView can still be drawing
        # a cached preview after it leaves this dictionary. Dropping our strong
        # references lets Android reclaim it when the UI releases its copy.
        with self._extension_lock:
            self._extension_preview_bitmaps.clear()

    def _cleanup_extension_preview_cache(self):
        root = self._extension_preview_root
        if not root or not os.path.isdir(root):
            return
        keep = set()
        for entry in self._extension_catalog.values():
            if not entry.get("preview"):
                continue
            try:
                keep.add(os.path.realpath(self._extension_preview_cache_path(entry)))
            except Exception as exc:
                self._log_suppressed("resolve preview cache path", exc)
        root_real = os.path.realpath(root)
        for dirpath, _dirnames, filenames in os.walk(root_real, topdown=False):
            for filename in filenames:
                path = os.path.realpath(os.path.join(dirpath, filename))
                if path in keep:
                    continue
                if path.startswith(root_real + os.sep):
                    try:
                        os.remove(path)
                    except Exception as exc:
                        self._log_suppressed("clean stale preview cache", exc)
            if dirpath != root_real:
                try:
                    if not os.listdir(dirpath):
                        os.rmdir(dirpath)
                except Exception as exc:
                    self._log_suppressed("clean preview cache directory", exc)

    def _bind_extension_preview_view(self, extension_id: str, view: Any):
        entry = self._extension_catalog.get(extension_id)
        if not entry or not entry.get("preview"):
            self._set_extension_preview_view(
                view,
                message="Предпросмотр недоступен",
            )
            return

        key = self._extension_preview_key(entry)
        with self._extension_lock:
            bitmap = self._extension_preview_bitmaps.get(key)
            if bitmap is not None:
                self._set_extension_preview_view(view, bitmap=bitmap)
                return
            waiters = self._extension_preview_waiters.setdefault(key, [])
            if all(_identity(existing) != _identity(view) for existing in waiters):
                waiters.append(view)
                if len(waiters) > 8:
                    del waiters[:-8]
            if self._extension_preview_jobs.get(key):
                return
            self._extension_preview_jobs[key] = True

        self._set_extension_preview_view(view, message="Загружаем предпросмотр…")
        generation, stop_event = self._extension_worker_context()

        def worker():
            bitmap = None
            error = ""
            try:
                self._require_extension_worker_active(generation, stop_event)
                try:
                    data = self._read_cached_extension_preview(entry)
                except Exception:
                    data = self._download_extension_preview(entry)
                    self._require_extension_worker_active(generation, stop_event)
                    self._write_bytes_atomic(
                        self._extension_preview_cache_path(entry),
                        data,
                    )
                self._require_extension_worker_active(generation, stop_event)
                cache_path = self._extension_preview_cache_path(entry)
                bitmap = self._decode_extension_preview(cache_path)
            except Exception as exc:
                error = str(exc)

            with self._extension_lock:
                waiters = self._extension_preview_waiters.pop(key, [])
                self._extension_preview_jobs.pop(key, None)
                if bitmap is not None and self._extension_worker_active(
                    generation,
                    stop_event,
                ):
                    self._extension_preview_bitmaps[key] = bitmap
                    while len(self._extension_preview_bitmaps) > 8:
                        oldest = next(iter(self._extension_preview_bitmaps))
                        self._extension_preview_bitmaps.pop(oldest, None)

            if not self._extension_worker_active(generation, stop_event):
                return
            if error:
                self.log(f"Glassify extensions: preview {extension_id} failed: {error}")

            def apply_preview():
                if not self._extension_worker_active(generation, stop_event):
                    return
                for target in waiters:
                    self._set_extension_preview_view(
                        target,
                        bitmap=bitmap,
                        message=(
                            "Предпросмотр недоступен"
                            if error
                            else "Загружаем предпросмотр…"
                        ),
                    )

            run_on_ui_thread(apply_preview)

        threading.Thread(
            target=worker,
            name=f"GlassifyPreview-{extension_id}",
            daemon=True,
        ).start()

    def _refresh_extension_catalog_async(self, silent: bool = False):
        if not self._extensions_master_enabled() or not self._extension_alive:
            return
        with self._extension_lock:
            if "__catalog__" in self._extension_jobs:
                if not silent:
                    self._extension_notify("Каталог уже обновляется")
                return
            self._extension_jobs["__catalog__"] = "refresh"

        self._reload_extension_settings()
        generation, stop_event = self._extension_worker_context()

        def worker():
            error = None
            try:
                self._require_extension_worker_active(generation, stop_event)
                content = self._download_extension_catalog()
                self._require_extension_worker_active(generation, stop_event)
                payload = json.loads(content.decode("utf-8"))
                catalog = self._validate_extension_catalog(payload)
                if not catalog and payload.get("extensions"):
                    raise ValueError("catalog contains no valid extensions")

                self._require_extension_worker_active(generation, stop_event)
                with self._extension_lock:
                    self._extension_catalog = catalog
                    self._extension_catalog_error = ""
                self._cleanup_extension_preview_cache()
                self._require_extension_worker_active(generation, stop_event)
                self._write_json_atomic(self._extension_catalog_path, payload)
            except Exception as exc:
                error = str(exc)
                if self._extension_worker_active(generation, stop_event):
                    with self._extension_lock:
                        self._extension_catalog_error = error
                    self.log(f"Glassify extensions: catalog refresh failed: {exc}")
            finally:
                if generation == self._extension_generation:
                    with self._extension_lock:
                        self._extension_jobs.pop("__catalog__", None)
                    self._reload_extension_settings()

            if not silent and self._extension_worker_active(generation, stop_event):
                if error:
                    self._extension_notify(f"Не удалось обновить каталог: {error}")
                else:
                    self._extension_notify("Каталог расширений обновлён")

        threading.Thread(
            target=worker,
            name="GlassifyCatalog",
            daemon=True,
        ).start()

    def _extension_compatible(self, entry: Dict[str, Any]) -> Tuple[bool, str]:
        try:
            if int(entry.get("api", 0)) > GLASSIFY_EXTENSION_API:
                return False, "Расширение требует более новую версию Glassify"
            minimum = Version(str(entry.get("min_glassify") or "0"))
            if Version(__version__) < minimum:
                return False, f"Требуется Glassify {minimum}+"
            extera_requirement = str(entry.get("min_exteragram") or "").strip()
            if extera_requirement:
                extera_minimum = Version(extera_requirement)
                current = self._current_exteragram_version()
                if current is None:
                    return False, "Не удалось определить версию exteraGram"
                if current < extera_minimum:
                    return False, f"Требуется exteraGram {extera_minimum}+"
        except (InvalidVersion, TypeError, ValueError):
            return False, "Некорректные требования совместимости"
        return True, ""

    def _extension_enabled_key(self, extension_id: str) -> str:
        return f"extension.enabled.{extension_id}"

    def _extension_enabled(self, extension_id: str) -> bool:
        if extension_id not in self._installed_extensions():
            return False
        return bool(self.get_setting(self._extension_enabled_key(extension_id), False))

    def _extension_is_installed(self, extension_id: str) -> bool:
        return extension_id in self._installed_extensions()

    def _extension_has_update(self, extension_id: str) -> bool:
        installed = self._installed_extensions().get(extension_id)
        entry = self._extension_catalog.get(extension_id)
        if not installed or not entry:
            return False
        try:
            return Version(str(entry["version"])) > Version(str(installed["version"]))
        except (InvalidVersion, KeyError, TypeError):
            return False

    def _extension_file_path(self, extension_id: str, installed: Dict[str, Any]) -> str:
        rel_path = str(installed.get("path") or "")
        if not rel_path:
            return ""
        root = os.path.realpath(self._extension_root)
        candidate = os.path.realpath(os.path.join(root, rel_path))
        if candidate == root or not candidate.startswith(root + os.sep):
            return ""
        return candidate

    def _read_limited_file(self, path: str) -> bytes:
        size = os.path.getsize(path)
        if size <= 0 or size > GLASSIFY_MAX_EXTENSION_BYTES:
            raise ValueError("invalid extension file size")
        with open(path, "rb") as handle:
            data = handle.read(GLASSIFY_MAX_EXTENSION_BYTES + 1)
        if len(data) > GLASSIFY_MAX_EXTENSION_BYTES:
            raise ValueError("extension file is too large")
        return data

    def _parse_extension_source(
        self,
        source: str,
        filename: str,
    ) -> Tuple[Any, Dict[str, Any]]:
        tree = ast.parse(source, filename=filename)
        metadata = None
        for statement in tree.body:
            target = None
            value = None
            if isinstance(statement, ast.Assign):
                if len(statement.targets) == 1:
                    target = statement.targets[0]
                    value = statement.value
            elif isinstance(statement, ast.AnnAssign):
                target = statement.target
                value = statement.value
            if isinstance(target, ast.Name) and target.id == "GLASSIFY_EXTENSION":
                if metadata is not None:
                    raise ValueError("GLASSIFY_EXTENSION объявлен несколько раз")
                try:
                    metadata = ast.literal_eval(value)
                except Exception as exc:
                    raise ValueError(
                        "GLASSIFY_EXTENSION должен быть литералом"
                    ) from exc

        if not isinstance(metadata, dict):
            raise ValueError("нет статического GLASSIFY_EXTENSION")

        blocked_calls = {"compile", "eval", "exec", "globals", "locals", "open", "vars"}
        for node in ast.walk(tree):
            if isinstance(node, (ast.Import, ast.ImportFrom)):
                raise ValueError(
                    "импорты в расширениях запрещены; используйте Glassify API"
                )
            if (
                isinstance(node, ast.Call)
                and isinstance(node.func, ast.Name)
                and (node.func.id in blocked_calls or node.func.id == "__import__")
            ):
                raise ValueError(f"опасный вызов запрещён: {node.func.id}")
            if (
                isinstance(node, ast.Call)
                and isinstance(node.func, ast.Attribute)
                and node.func.attr in blocked_calls
            ):
                raise ValueError(f"опасный метод запрещён: {node.func.attr}")
            if (
                isinstance(node, ast.Call)
                and isinstance(node.func, ast.Name)
                and node.func.id in {"getattr", "hasattr", "setattr"}
                and len(node.args) >= 2
                and isinstance(node.args[1], ast.Constant)
                and isinstance(node.args[1].value, str)
                and node.args[1].value.startswith("__")
            ):
                raise ValueError("доступ к служебным атрибутам запрещён")
            if (
                isinstance(node, ast.Attribute)
                and node.attr.startswith("__")
                and node.attr not in {"__init__", "__new__", "__repr__", "__str__"}
            ):
                raise ValueError("доступ к служебным атрибутам запрещён")
            if isinstance(node, ast.Attribute) and node.attr.startswith(
                "_GlassifyExtensionAPI__"
            ):
                raise ValueError("доступ к внутренностям Glassify API запрещён")
            if (
                isinstance(node, ast.Name)
                and isinstance(node.ctx, ast.Load)
                and node.id.startswith("__")
                and node.id != "__name__"
            ):
                raise ValueError("доступ к служебным именам запрещён")
            if (
                isinstance(node, ast.Constant)
                and isinstance(node.value, str)
                and "_GlassifyExtensionAPI__" in node.value
            ):
                raise ValueError("доступ к внутренностям Glassify API запрещён")
        return tree, metadata

    def _validate_extension_metadata(
        self,
        extension_id: str,
        metadata: Dict[str, Any],
        expected: Dict[str, Any],
    ):
        if str(metadata.get("id")) != extension_id:
            raise ValueError("ID расширения не совпадает")
        if str(metadata.get("version")) != str(expected.get("version")):
            raise ValueError("версия расширения не совпадает")
        try:
            metadata_api = int(metadata.get("api", 0))
            expected_api = int(expected.get("api", 0))
        except (TypeError, ValueError) as exc:
            raise ValueError("некорректный API расширения") from exc
        if metadata_api != expected_api or metadata_api > GLASSIFY_EXTENSION_API:
            raise ValueError("расширение несовместимо с этой версией Glassify")

    def _extension_globals(self, module_name: str) -> Dict[str, Any]:
        import builtins

        safe_builtins = {
            name: getattr(builtins, name) for name in _EXTENSION_SAFE_BUILTINS
        }
        safe_builtins["getattr"] = _safe_extension_getattr
        safe_builtins["hasattr"] = _safe_extension_hasattr
        safe_builtins["setattr"] = _safe_extension_setattr
        return {
            "__builtins__": safe_builtins,
            "__name__": module_name,
            "__package__": "",
            "MethodHook": MethodHook,
            "Any": Any,
            "Dict": Dict,
            "List": List,
            "Optional": Optional,
            "Tuple": Tuple,
        }

    def _download_extension_source(self, entry: Dict[str, Any]) -> Tuple[bytes, bool]:
        file_url = str(entry["file"])
        source_commit = str(entry.get("commit") or "").lower().strip()
        expected_blob_sha = str(entry.get("blob_sha") or "").lower().strip()
        parsed = urlparse(file_url)
        path_parts = parsed.path.lstrip("/").split("/")
        if len(path_parts) < 4:
            raise ValueError("некорректный путь расширения")

        # Prefer GitHub's Contents API for immutable, commit-pinned bytes.
        if _GIT_COMMIT_RE.fullmatch(source_commit):
            try:
                owner, repo = path_parts[0], path_parts[1]
                relative_path = "/".join(path_parts[3:])
                api_url = f"https://api.github.com/repos/{owner}/{repo}/contents/{relative_path}"
                response = requests.get(
                    api_url,
                    params={"ref": source_commit},
                    timeout=(5, 20),
                    headers={
                        "User-Agent": f"Glassify/{__version__}",
                        "Accept": "application/vnd.github+json",
                        "Cache-Control": "no-cache, no-store, max-age=0",
                        "Pragma": "no-cache",
                    },
                )
                response.raise_for_status()
                payload = response.json()
                encoded = payload.get("content") if isinstance(payload, dict) else None
                encoding = payload.get("encoding") if isinstance(payload, dict) else None
                api_blob_sha = (
                    str(payload.get("sha") or "").lower().strip()
                    if isinstance(payload, dict)
                    else ""
                )
                if encoding != "base64" or not isinstance(encoded, str):
                    raise ValueError("GitHub вернул некорректный файл расширения")
                if not _GIT_BLOB_RE.fullmatch(expected_blob_sha):
                    raise ValueError("в каталоге отсутствует корректный Git blob")
                if api_blob_sha != expected_blob_sha:
                    raise ValueError("GitHub blob не совпадает с каталогом")
                data = _decode_github_base64(
                    encoded,
                    GLASSIFY_MAX_EXTENSION_BYTES,
                    "extension",
                )
                computed_blob_sha = hashlib.sha1(
                    b"blob " + str(len(data)).encode("ascii") + b"\0" + data
                ).hexdigest()
                if computed_blob_sha != expected_blob_sha:
                    raise ValueError("содержимое не соответствует Git blob")
                return data, True
            except Exception as exc:
                self.log(
                    "Glassify extensions: GitHub API unavailable; "
                    f"using pinned raw fallback: {exc}"
                )

        # Raw fallback must preserve the catalog's immutable commit instead of
        # silently switching back to /main/. SHA-256 and Git blob are rechecked.
        if _GIT_COMMIT_RE.fullmatch(source_commit):
            owner, repo = path_parts[0], path_parts[1]
            relative_path = "/".join(path_parts[3:])
            download_url = (
                f"https://raw.githubusercontent.com/{owner}/{repo}/"
                f"{source_commit}/{relative_path}"
            )
        else:
            download_url = file_url

        separator = "&" if "?" in download_url else "?"
        download_url = (
            f"{download_url}{separator}_glassify_sha={entry.get('sha256', '')}"
        )
        response = requests.get(
            download_url,
            stream=True,
            timeout=(5, 20),
            headers={
                "User-Agent": f"Glassify/{__version__}",
                "Cache-Control": "no-cache, no-store, max-age=0",
                "Pragma": "no-cache",
            },
        )
        response.raise_for_status()

        length = response.headers.get("Content-Length")
        if length:
            try:
                if int(length) > GLASSIFY_MAX_EXTENSION_BYTES:
                    raise ValueError("extension file is too large")
            except ValueError as exc:
                if str(exc) == "extension file is too large":
                    raise

        chunks: List[bytes] = []
        total = 0
        for chunk in response.iter_content(chunk_size=16384):
            if not chunk:
                continue
            total += len(chunk)
            if total > GLASSIFY_MAX_EXTENSION_BYTES:
                raise ValueError("extension file is too large")
            chunks.append(chunk)
        data = b"".join(chunks)
        if not data:
            raise ValueError("empty extension file")

        blob_verified = False
        if _GIT_BLOB_RE.fullmatch(expected_blob_sha):
            computed_blob_sha = hashlib.sha1(
                b"blob " + str(len(data)).encode("ascii") + b"\0" + data
            ).hexdigest()
            if computed_blob_sha != expected_blob_sha:
                raise ValueError("raw fallback Git blob не совпадает с каталогом")
            blob_verified = True
        return data, blob_verified

    def _install_extension_clicked(self, extension_id: str, _view=None):
        self._install_extension_async(extension_id)

    def _install_extension_async(self, extension_id: str):
        if not self._extensions_master_enabled() or not self._extension_alive:
            self._extension_notify("Сначала включите расширения Glassify")
            return
        entry = self._extension_catalog.get(extension_id)
        if not entry:
            self._extension_notify("Расширение отсутствует в каталоге")
            return
        compatible, reason = self._extension_compatible(entry)
        if not compatible:
            self._extension_notify(reason)
            return

        with self._extension_lock:
            if extension_id in self._extension_jobs:
                self._extension_notify("Операция с расширением уже выполняется")
                return
            self._extension_jobs[extension_id] = "install"
        self._reload_extension_settings()
        generation, stop_event = self._extension_worker_context()

        def worker():
            error = None
            rolled_back = False
            previous = self._installed_extensions().get(extension_id)
            previous = dict(previous) if isinstance(previous, dict) else None
            previous_enabled = self._extension_enabled(extension_id)
            should_enable = bool(previous_enabled) if previous is not None else False
            is_new = previous is None
            target_dir = ""
            stage_dir = ""
            backup_dir = ""
            state_committed = False
            target_replaced = False
            try:
                self._require_extension_worker_active(generation, stop_event)
                data, blob_verified = self._download_extension_source(entry)
                self._require_extension_worker_active(generation, stop_event)
                digest = hashlib.sha256(data).hexdigest()
                if digest != entry["sha256"]:
                    self.log(
                        "Glassify extensions: SHA-256 mismatch for "
                        f"{extension_id}: expected={entry['sha256']} actual={digest}; "
                        f"blob_verified={blob_verified}"
                    )
                    raise ValueError(
                        f"SHA-256 не совпадает: {digest[:8]} ≠ {entry['sha256'][:8]}"
                    )

                try:
                    source = data.decode("utf-8")
                except UnicodeDecodeError as exc:
                    raise ValueError("расширение должно быть UTF-8") from exc
                tree, metadata = self._parse_extension_source(
                    source,
                    filename=f"{extension_id}/extension.py",
                )
                self._validate_extension_metadata(extension_id, metadata, entry)
                compile(tree, f"{extension_id}/extension.py", "exec")

                target_dir = os.path.join(
                    self._extension_root,
                    "installed",
                    extension_id,
                    entry["version"],
                )
                version_root = os.path.dirname(target_dir)
                os.makedirs(version_root, exist_ok=True)
                token = uuid.uuid4().hex
                stage_dir = os.path.join(version_root, f".stage-{token}")
                backup_dir = os.path.join(version_root, f".backup-{token}")
                os.makedirs(stage_dir, exist_ok=False)
                staged_path = os.path.join(stage_dir, "extension.py")
                with open(staged_path, "xb") as handle:
                    handle.write(data)
                    handle.flush()
                    try:
                        os.fsync(handle.fileno())
                    except Exception as exc:
                        self._log_suppressed("sync staged extension", exc)

                staged_digest = hashlib.sha256(
                    self._read_limited_file(staged_path)
                ).hexdigest()
                if staged_digest != digest:
                    raise ValueError("проверка записанного файла не пройдена")

                self._require_extension_worker_active(generation, stop_event)
                if extension_id in self._extension_modules:
                    self._unload_extension(extension_id)
                self._require_extension_worker_active(generation, stop_event)

                if os.path.isdir(target_dir):
                    os.replace(target_dir, backup_dir)
                os.replace(stage_dir, target_dir)
                target_replaced = True
                stage_dir = ""
                target_path = os.path.join(target_dir, "extension.py")

                relative_path = os.path.relpath(target_path, self._extension_root)
                with self._extension_lock:
                    self._extension_state.setdefault("installed", {})[extension_id] = {
                        "version": entry["version"],
                        "api": entry["api"],
                        "min_glassify": entry["min_glassify"],
                        "min_exteragram": entry.get("min_exteragram", ""),
                        "sha256": digest,
                        "commit": entry.get("commit", ""),
                        "blob_sha": entry.get("blob_sha", ""),
                        "path": relative_path,
                        "installed_at": int(time.time()),
                    }
                    state_committed = True
                    self._save_extension_state()

                if is_new:
                    self.set_setting(self._extension_enabled_key(extension_id), False)
                self._require_extension_worker_active(generation, stop_event)

                if should_enable and not self._load_extension(extension_id):
                    detail = self._extension_last_errors.get(
                        extension_id, "ошибка загрузки"
                    )
                    raise RuntimeError(f"проверка запуска не пройдена: {detail}")

                self._require_extension_worker_active(generation, stop_event)
                self._cleanup_old_extension_versions(extension_id, entry["version"])
                if backup_dir and os.path.isdir(backup_dir):
                    try:
                        shutil.rmtree(backup_dir)
                    except Exception as cleanup_exc:
                        self._log_suppressed(
                            "clean committed extension backup",
                            cleanup_exc,
                        )
                    finally:
                        backup_dir = ""
            except Exception as exc:
                error = str(exc)
                rollback_errors: List[str] = []

                try:
                    if extension_id in self._extension_modules:
                        self._unload_extension(extension_id)
                except Exception as rollback_exc:
                    rollback_errors.append(f"выгрузка: {rollback_exc}")

                if state_committed:
                    with self._extension_lock:
                        installed = self._extension_state.setdefault("installed", {})
                        if previous is None:
                            installed.pop(extension_id, None)
                        else:
                            installed[extension_id] = previous

                try:
                    if target_replaced and target_dir and os.path.isdir(target_dir):
                        shutil.rmtree(target_dir)
                    if backup_dir and os.path.isdir(backup_dir):
                        os.replace(backup_dir, target_dir)
                        backup_dir = ""
                except Exception as rollback_exc:
                    rollback_errors.append(f"файлы: {rollback_exc}")

                try:
                    if state_committed:
                        with self._extension_lock:
                            self._save_extension_state()
                except Exception as rollback_exc:
                    rollback_errors.append(f"состояние: {rollback_exc}")

                try:
                    self.set_setting(
                        self._extension_enabled_key(extension_id),
                        previous_enabled if previous is not None else False,
                    )
                except Exception as rollback_exc:
                    rollback_errors.append(f"настройка: {rollback_exc}")

                try:
                    if (
                        previous is not None
                        and previous_enabled
                        and self._extension_worker_active(generation, stop_event)
                    ):
                        rolled_back = self._load_extension(extension_id)
                    else:
                        rolled_back = previous is not None
                except Exception as rollback_exc:
                    rolled_back = False
                    rollback_errors.append(f"запуск: {rollback_exc}")

                if rollback_errors:
                    error = f"{error}; откат не завершён: " + "; ".join(rollback_errors)
                    rolled_back = False
                if self._extension_worker_active(generation, stop_event):
                    self.log(
                        f"Glassify extensions: install {extension_id} failed: {error}"
                    )
            finally:
                if stage_dir and os.path.isdir(stage_dir):
                    try:
                        shutil.rmtree(stage_dir)
                    except Exception as exc:
                        self._log_suppressed("clean extension staging", exc)
                if error and backup_dir and os.path.isdir(backup_dir):
                    self.log(
                        "Glassify extensions: rollback backup preserved at "
                        f"{backup_dir}"
                    )
                if generation == self._extension_generation:
                    with self._extension_lock:
                        self._extension_jobs.pop(extension_id, None)
                    self._reload_extension_settings()

            if not self._extension_worker_active(generation, stop_event):
                return
            if error:
                if rolled_back:
                    self._extension_notify(
                        f"Обновление отменено, предыдущая версия восстановлена: {error}"
                    )
                else:
                    self._extension_notify(f"Не удалось установить: {error}")
            else:
                self._extension_notify(f"{entry['name']} установлено")

        threading.Thread(
            target=worker,
            name=f"GlassifyInstall-{extension_id}",
            daemon=True,
        ).start()

    def _cleanup_old_extension_versions(self, extension_id: str, keep_version: str):
        root = os.path.join(self._extension_root, "installed", extension_id)
        if not os.path.isdir(root):
            return
        for name in os.listdir(root):
            if name == keep_version:
                continue
            path = os.path.join(root, name)
            if os.path.isdir(path):
                try:
                    shutil.rmtree(path)
                except Exception as exc:
                    self.log(f"Glassify extensions: old version cleanup failed: {exc}")

    def _extension_enabled_changed(self, extension_id: str, value: Any):
        if not self._extensions_master_enabled():
            self._extension_notify("Сначала включите расширения Glassify")
            return
        if not self._extension_is_installed(extension_id):
            return

        enabled = bool(value)
        self.set_setting(self._extension_enabled_key(extension_id), enabled)
        if enabled:
            if not self._load_extension(extension_id):
                self.set_setting(self._extension_enabled_key(extension_id), False)
                detail = self._extension_last_errors.get(
                    extension_id, "ошибка загрузки"
                )
                self._extension_notify(f"Не удалось включить: {detail}")
                self._reload_extension_settings()
                return
            self._extension_notify("Расширение включено")
        else:
            self._unload_extension(extension_id)
            self._extension_notify("Расширение выключено")
        self._reload_extension_settings()

    def _uninstall_extension_clicked(self, extension_id: str, _view=None):
        if extension_id in self._extension_jobs:
            self._extension_notify("Дождитесь завершения текущей операции")
            return
        self._unload_extension(extension_id)

        installed = self._installed_extensions().get(extension_id)
        if installed:
            path = self._extension_file_path(extension_id, installed)
            extension_root = os.path.dirname(os.path.dirname(path)) if path else ""
            try:
                if extension_root and os.path.isdir(extension_root):
                    shutil.rmtree(extension_root)
            except Exception as exc:
                self.log(f"Glassify extensions: remove files failed: {exc}")

        preview_dir = os.path.join(self._extension_preview_root, extension_id)
        try:
            if preview_dir and os.path.isdir(preview_dir):
                shutil.rmtree(preview_dir)
        except Exception as exc:
            self._log_suppressed("remove extension preview cache", exc)

        with self._extension_lock:
            self._extension_state.setdefault("installed", {}).pop(extension_id, None)
            self._save_extension_state()
        self.set_setting(self._extension_enabled_key(extension_id), False)
        self._extension_last_errors.pop(extension_id, None)
        self._extension_notify("Расширение удалено")
        self._reload_extension_settings()

    def _load_extension(self, extension_id: str) -> bool:
        if not self._plugin_alive or not self._extension_alive:
            return False
        if extension_id in self._extension_modules:
            return True
        installed = self._installed_extensions().get(extension_id)
        if not installed or not self._extension_enabled(extension_id):
            return False

        path = self._extension_file_path(extension_id, installed)
        if not path or not os.path.isfile(path):
            self._extension_last_errors[extension_id] = "файл расширения не найден"
            return False

        module_suffix = hashlib.sha256(extension_id.encode("utf-8")).hexdigest()[:16]
        module_name = f"_glassify_extension_{module_suffix}"
        api = GlassifyExtensionAPI(self, extension_id)
        try:
            data = self._read_limited_file(path)
            digest = hashlib.sha256(data).hexdigest()
            if digest != str(installed.get("sha256", "")):
                raise ValueError("локальный SHA-256 не совпадает")

            compatible, reason = self._extension_compatible(installed)
            if not compatible:
                raise ValueError(reason)
            try:
                source = data.decode("utf-8")
            except UnicodeDecodeError as exc:
                raise ValueError("расширение должно быть UTF-8") from exc
            tree, metadata = self._parse_extension_source(source, path)
            self._validate_extension_metadata(extension_id, metadata, installed)
            code = compile(tree, path, "exec")

            def execute_on_ui():
                if not self._plugin_alive or not self._extension_alive:
                    raise RuntimeError("Glassify выгружен")
                module = types.ModuleType(module_name)
                module.__file__ = path
                module.__package__ = ""
                module.__dict__.update(self._extension_globals(module_name))
                sys.modules[module_name] = module
                exec(code, module.__dict__)
                runtime_metadata = getattr(module, "GLASSIFY_EXTENSION", None)
                if not isinstance(runtime_metadata, dict):
                    raise ValueError("нет GLASSIFY_EXTENSION")
                self._validate_extension_metadata(
                    extension_id,
                    runtime_metadata,
                    installed,
                )
                on_load = getattr(module, "on_load", None)
                if callable(on_load):
                    on_load(api)
                return module

            module = self._run_on_ui_sync(execute_on_ui)

            with self._extension_lock:
                self._extension_modules[extension_id] = module
                self._extension_apis[extension_id] = api
                self._extension_module_names[extension_id] = module_name
            self._extension_last_errors.pop(extension_id, None)
            self.log(
                f"Glassify extensions: loaded {extension_id} "
                f"v{installed.get('version')}"
            )
            return True
        except Exception as exc:
            try:
                self._run_on_ui_sync(api._cleanup)
            except Exception as cleanup_exc:
                self._log_suppressed("extension load cleanup", cleanup_exc)
            try:
                self._run_on_ui_sync(lambda: sys.modules.pop(module_name, None))
            except Exception as cleanup_exc:
                self._log_suppressed("extension module cleanup", cleanup_exc)
            self._extension_last_errors[extension_id] = str(exc)
            self.log(f"Glassify extensions: load {extension_id} failed: {exc}")
            return False

    def _unload_extension(self, extension_id: str):
        with self._extension_lock:
            module = self._extension_modules.pop(extension_id, None)
            api = self._extension_apis.pop(extension_id, None)
            module_name = self._extension_module_names.pop(extension_id, None)

        def unload_on_ui():
            unload_error = None
            try:
                if module is not None:
                    on_unload = getattr(module, "on_unload", None)
                    if callable(on_unload):
                        on_unload(api)
            except Exception as exc:
                unload_error = exc
            finally:
                try:
                    if api is not None:
                        api._cleanup()
                finally:
                    if module_name:
                        sys.modules.pop(module_name, None)
            if unload_error is not None:
                raise unload_error

        try:
            self._run_on_ui_sync(unload_on_ui)
        except Exception as exc:
            self.log(f"Glassify extensions: unload {extension_id} failed: {exc}")

    def _extension_notify(self, text: str):
        generation = self._extension_generation

        def show():
            if not self._extension_alive or generation != self._extension_generation:
                return
            try:
                BulletinHelper.show_info(str(text))
            except Exception:
                self.log(f"Glassify extensions: {text}")

        if self._extension_alive:
            run_on_ui_thread(show)

    def _restart_exteragram(self):
        """Schedule the launcher, then terminate the current process."""
        try:
            context = ApplicationLoader.applicationContext
            if context is None:
                raise RuntimeError("application context unavailable")

            Intent = jclass("android.content.Intent")
            Context = jclass("android.content.Context")
            PendingIntent = jclass("android.app.PendingIntent")
            AlarmManager = jclass("android.app.AlarmManager")
            BuildVersion = jclass("android.os.Build$VERSION")
            Process = jclass("android.os.Process")
            Integer = jclass("java.lang.Integer")
            Long = jclass("java.lang.Long")

            launch_intent = context.getPackageManager().getLaunchIntentForPackage(
                str(context.getPackageName())
            )
            if launch_intent is None:
                raise RuntimeError("launcher intent unavailable")

            intent_flags = (
                int(Intent.FLAG_ACTIVITY_NEW_TASK)
                | int(Intent.FLAG_ACTIVITY_CLEAR_TOP)
                | int(Intent.FLAG_ACTIVITY_CLEAR_TASK)
            )
            launch_intent.addFlags(Integer.valueOf(intent_flags))

            pending_flags = int(PendingIntent.FLAG_CANCEL_CURRENT)
            if int(BuildVersion.SDK_INT) >= 23:
                pending_flags |= int(PendingIntent.FLAG_IMMUTABLE)

            pending = PendingIntent.getActivity(
                context,
                Integer.valueOf(6020),
                launch_intent,
                Integer.valueOf(pending_flags),
            )

            alarm = context.getSystemService(Context.ALARM_SERVICE)
            if alarm is None:
                raise RuntimeError("alarm service unavailable")

            alarm.set(
                Integer.valueOf(int(AlarmManager.RTC)),
                Long.valueOf(int(System.currentTimeMillis()) + 450),
                pending,
            )
            Process.killProcess(Process.myPid())
        except Exception as exc:
            self.log(f"Glassify: restart failed: {exc}")
            try:
                BulletinHelper.show_error(
                    "Не удалось перезапустить автоматически. "
                    "Закройте exteraGram и откройте снова."
                )
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

    def _show_extension_restart_required(self, extension_id: str):
        if not self._extension_alive:
            return

        now = time.monotonic()
        if now - self._extension_restart_prompt_at < 0.35:
            return
        self._extension_restart_prompt_at = now
        generation = self._extension_generation

        def show():
            if not self._extension_alive or generation != self._extension_generation:
                return
            try:
                R = jclass("org.telegram.messenger.R")
                BulletinHelper.show_with_button(
                    "Настройки расширения сохранены. "
                    "Для безопасного применения перезапустите exteraGram.",
                    R.raw.info,
                    "Перезапустить",
                    on_click=self._restart_exteragram,
                )
            except Exception as exc:
                self.log(
                    f"Glassify extensions: restart bulletin failed "
                    f"for {extension_id}: {exc}"
                )
                try:
                    BulletinHelper.show_info(
                        "Настройки сохранены. Перезапустите exteraGram для применения."
                    )
                except Exception as _suppressed_exc:
                    _note_suppressed(_suppressed_exc)

        run_on_ui_thread(show)

    def _reload_extension_settings(self):
        if not self._extension_alive:
            return
        generation = self._extension_generation

        def reload_ui():
            if not self._extension_alive or generation != self._extension_generation:
                return
            try:
                current = self._extensions_master_enabled()
                self.set_setting(
                    self.EXTENSIONS_ENABLED_KEY,
                    current,
                    reload_settings=True,
                )
            except Exception as exc:
                self.log(f"Glassify extensions: settings reload failed: {exc}")

        run_on_ui_thread(reload_ui)

    def _validate_extension_settings_schema(self, schema: Any) -> List[Dict[str, Any]]:
        if not isinstance(schema, list):
            raise TypeError("settings schema must be a list")
        if len(schema) > 12:
            raise ValueError("settings schema is too large")

        result: List[Dict[str, Any]] = []
        for raw in schema:
            if not isinstance(raw, dict):
                raise TypeError("settings item must be a dictionary")
            kind = str(raw.get("type") or "").strip().lower()
            if kind not in {"choice", "action", "divider", "switch"}:
                raise ValueError(f"unsupported settings item: {kind}")

            if kind == "divider":
                result.append(
                    {
                        "type": "divider",
                        "text": str(raw.get("text") or "")[:240],
                    }
                )
                continue

            key = str(raw.get("key") or "").strip()
            if not _EXTENSION_SETTING_KEY_RE.fullmatch(key):
                raise ValueError("invalid extension setting key")
            item = {
                "type": kind,
                "key": key,
                "text": str(raw.get("text") or key)[:80],
                "subtext": str(raw.get("subtext") or "")[:180],
                "icon": str(raw.get("icon") or "msg_settings")[:64],
            }

            if kind == "switch":
                # Available since Glassify 0.5.0: extensions using it should
                # declare min_glassify 0.5.0 in the catalog.
                item["default"] = bool(raw.get("default", False))

            if kind == "choice":
                options = raw.get("options")
                if not isinstance(options, list) or not 2 <= len(options) <= 8:
                    raise ValueError("choice must contain 2 to 8 options")
                clean_options = []
                seen = set()
                for option in options:
                    if not isinstance(option, dict):
                        raise TypeError("choice option must be a dictionary")
                    value = str(option.get("value") or "").strip()
                    if not _EXTENSION_SETTING_KEY_RE.fullmatch(value):
                        raise ValueError("invalid choice value")
                    if value in seen:
                        raise ValueError("duplicate choice value")
                    seen.add(value)
                    clean_options.append(
                        {
                            "value": value,
                            "text": str(option.get("text") or value)[:80],
                            "subtext": str(option.get("subtext") or "")[:180],
                        }
                    )
                default = str(raw.get("default") or clean_options[0]["value"])
                if default not in seen:
                    raise ValueError("choice default is not an option")
                item["default"] = default
                item["options"] = clean_options
            result.append(item)
        return result

    def _extension_choice_label(
        self, api: GlassifyExtensionAPI, item: Dict[str, Any]
    ) -> str:
        current = str(api.get_setting(item["key"], item["default"]))
        for option in item["options"]:
            if option["value"] == current:
                return option["text"]
        return item["options"][0]["text"]

    @staticmethod
    def _extension_choice_index(item: Dict[str, Any], value: Any) -> int:
        for index, option in enumerate(item.get("options") or ()):
            if option["value"] == str(value):
                return index
        return 0

    @staticmethod
    def _extension_choice_index_key(extension_id: str, key: str) -> str:
        # Selector stores an index; the extension keeps reading its string value.
        return f"extension_ui.{extension_id}.{key}"

    @staticmethod
    def _extension_schema_item(
        api: GlassifyExtensionAPI, key: str
    ) -> Optional[Dict[str, Any]]:
        for schema_item in api._settings_schema:
            if schema_item.get("key") == key:
                return schema_item
        return None

    def _extension_choice_selected(
        self,
        extension_id: str,
        key: str,
        value: str,
        _view=None,
    ):
        api = self._extension_apis.get(extension_id)
        if api is None:
            self._extension_notify("Сначала включите расширение")
            return
        schema_item = self._extension_schema_item(api, key)
        default = schema_item.get("default") if schema_item else None
        previous = api.get_setting(key, default)
        final = value
        api.set_setting(key, value)
        if not api._notify_setting(key, value):
            api.set_setting(key, previous)
            final = previous
            if not api._notify_setting(key, previous):
                api.log(f"settings rollback callback failed for {key}")
            self._extension_notify("Настройка не применена и была восстановлена")
        if schema_item is not None and schema_item.get("type") == "choice":
            try:
                self.set_setting(
                    self._extension_choice_index_key(extension_id, key),
                    self._extension_choice_index(schema_item, final),
                )
            except Exception as exc:
                self._log_suppressed("sync extension choice selector", exc)
        self._reload_extension_settings()

    def _extension_choice_index_selected(
        self,
        extension_id: str,
        key: str,
        index: Any,
    ):
        api = self._extension_apis.get(extension_id)
        if api is None:
            self._extension_notify("Сначала включите расширение")
            return
        schema_item = self._extension_schema_item(api, key)
        if schema_item is None or schema_item.get("type") != "choice":
            return
        options = schema_item["options"]
        try:
            position = max(0, min(len(options) - 1, int(index)))
        except (TypeError, ValueError):
            position = 0
        self._extension_choice_selected(extension_id, key, options[position]["value"])

    def _extension_switch_changed(self, extension_id: str, key: str, value: Any):
        api = self._extension_apis.get(extension_id)
        if api is None:
            self._extension_notify("Сначала включите расширение")
            self._reload_extension_settings()
            return
        enabled = bool(value)
        api.set_setting(key, enabled)
        if not api._notify_setting(key, enabled):
            api.set_setting(key, not enabled)
            if not api._notify_setting(key, not enabled):
                api.log(f"settings rollback callback failed for {key}")
            self._extension_notify("Настройка не применена и была восстановлена")
            self._reload_extension_settings()

    def _create_extension_choice_settings(
        self,
        extension_id: str,
        item: Dict[str, Any],
    ) -> List[Any]:
        api = self._extension_apis.get(extension_id)
        if api is None:
            return [Header(text=item["text"]), Text(text="Расширение выключено")]
        current = str(api.get_setting(item["key"], item["default"]))
        items: List[Any] = [Header(text=item["text"])]
        for option in item["options"]:
            selected = option["value"] == current
            items.append(
                Text(
                    text=option["text"],
                    subtext=(
                        "Выбрано"
                        if selected and not option["subtext"]
                        else option["subtext"]
                    ),
                    icon="msg_customize",
                    accent=selected,
                    on_click=(
                        lambda view,
                        extension_id=extension_id,
                        key=item["key"],
                        value=option["value"]: self._extension_choice_selected(
                            extension_id, key, value, view
                        )
                    ),
                )
            )
        return items

    def _create_extension_choice_setting(
        self,
        extension_id: str,
        api: GlassifyExtensionAPI,
        item: Dict[str, Any],
    ) -> Any:
        if Selector is not None:
            try:
                index_key = self._extension_choice_index_key(extension_id, item["key"])
                current = api.get_setting(item["key"], item["default"])
                index = self._extension_choice_index(item, current)
                if self.get_setting(index_key, None) != index:
                    self.set_setting(index_key, index)
                return Selector(
                    key=index_key,
                    text=item["text"],
                    default=index,
                    items=[option["text"] for option in item["options"]],
                    icon=item["icon"],
                    on_change=(
                        lambda position,
                        extension_id=extension_id,
                        key=item["key"]: self._extension_choice_index_selected(
                            extension_id, key, position
                        )
                    ),
                )
            except Exception as exc:
                # Selector signatures differ between SDK builds. The sub-page
                # below works everywhere.
                self._log_suppressed("create extension selector", exc)
        return Text(
            text=item["text"],
            subtext=self._extension_choice_label(api, item),
            icon=item["icon"],
            create_sub_fragment=(
                lambda extension_id=extension_id,
                item=item: self._create_extension_choice_settings(
                    extension_id, item
                )
            ),
        )

    def _extension_action_clicked(self, extension_id: str, key: str, _view=None):
        api = self._extension_apis.get(extension_id)
        if api is None:
            self._extension_notify("Сначала включите расширение")
            return
        api._notify_setting(key, None)
        self._reload_extension_settings()

    def _create_extension_owned_settings(self, extension_id: str) -> List[Any]:
        api = self._extension_apis.get(extension_id)
        if api is None or not api._settings_schema:
            return []
        items: List[Any] = [Header(text="Настройки расширения")]
        for item in api._settings_schema:
            kind = item["type"]
            if kind == "divider":
                items.append(Divider(text=item["text"]))
            elif kind == "switch":
                switch_kwargs: Dict[str, Any] = {
                    "key": f"extension.{extension_id}.{item['key']}",
                    "text": item["text"],
                    "default": bool(item["default"]),
                    "icon": item["icon"],
                    "on_change": (
                        lambda value,
                        extension_id=extension_id,
                        key=item["key"]: self._extension_switch_changed(
                            extension_id, key, value
                        )
                    ),
                }
                if item["subtext"]:
                    switch_kwargs["subtext"] = item["subtext"]
                items.append(Switch(**switch_kwargs))
            elif kind == "choice":
                items.append(
                    self._create_extension_choice_setting(extension_id, api, item)
                )
            elif kind == "action":
                items.append(
                    Text(
                        text=item["text"],
                        subtext=item["subtext"],
                        icon=item["icon"],
                        on_click=(
                            lambda view,
                            extension_id=extension_id,
                            key=item["key"]: self._extension_action_clicked(
                                extension_id, key, view
                            )
                        ),
                    )
                )
        return items

    def _extension_status_text(self, extension_id: str) -> str:
        job = self._extension_jobs.get(extension_id)
        if job == "install":
            return "Установка…"
        installed = self._installed_extensions().get(extension_id)
        if not installed:
            return "Не установлено"
        version = str(installed.get("version", "?"))
        if self._extension_has_update(extension_id):
            latest = self._extension_catalog[extension_id]["version"]
            return f"Обновление {version} → {latest}"
        if self._extension_enabled(extension_id):
            if extension_id in self._extension_modules:
                return f"Включено · v{version}"
            error = self._extension_last_errors.get(extension_id)
            if error:
                return f"Ошибка загрузки · v{version}"
            return f"Установлено · v{version}"
        return f"Выключено · v{version}"

    def _extension_updates_count(self) -> int:
        return sum(
            1
            for extension_id in self._installed_extensions()
            if self._extension_has_update(extension_id)
        )

    def _extensions_summary_text(self) -> str:
        installed = len(self._installed_extensions())
        available = len(self._extension_catalog)
        if available:
            summary = f"Установлено: {installed} · в каталоге: {available}"
            updates = self._extension_updates_count()
            if updates:
                summary += f" · обновлений: {updates}"
            return summary
        if "__catalog__" in self._extension_jobs:
            return f"Установлено: {installed} · обновляем каталог…"
        if self._extension_catalog_error:
            return f"Установлено: {installed} · каталог не загрузился"
        return f"Установлено: {installed} · откройте, чтобы загрузить каталог"

    def _create_extensions_settings(self) -> List[Any]:
        if not self._extensions_master_enabled():
            return [
                Header(text="Расширения"),
                Text(
                    text="Расширения выключены",
                    subtext="Включите их на главной странице настроек Glassify.",
                    icon="msg_info",
                ),
            ]
        items: List[Any] = [Header(text="Расширения")]

        refreshing = "__catalog__" in self._extension_jobs
        items.append(
            Text(
                text="Обновление каталога…" if refreshing else "Обновить каталог",
                subtext=(
                    "Получаем список расширений с GitHub"
                    if refreshing
                    else "Проверить новые расширения и обновления"
                ),
                icon="msg_retry",
                accent=not refreshing,
                on_click=None
                if refreshing
                else self._refresh_extension_catalog_clicked,
            )
        )
        items.append(
            Divider(
                text=(
                    "Каталог обновляется автоматически. Код расширения "
                    "скачивается только после нажатия «Установить» и проходит "
                    "проверку SHA-256."
                )
            )
        )

        ids = set(self._extension_catalog.keys()) | set(
            self._installed_extensions().keys()
        )
        if not ids:
            error = self._extension_catalog_error.strip()
            items.append(
                Text(
                    text="Не удалось загрузить каталог"
                    if error
                    else "Каталог пока пуст",
                    subtext=(
                        error[:500]
                        if error
                        else "Нажмите «Обновить каталог». Уже установленные "
                        "расширения останутся доступны офлайн."
                    ),
                    icon="msg_warning" if error else "msg_info",
                )
            )
            return items

        for extension_id in sorted(
            ids,
            key=lambda item: (
                self._extension_catalog.get(item, {}).get("name") or item
            ).lower(),
        ):
            entry = self._extension_catalog.get(extension_id, {})
            name = str(entry.get("name") or extension_id)
            description = str(entry.get("description") or "Нет данных каталога")
            if len(description) > 90:
                description = description[:89].rstrip() + "…"
            status = self._extension_status_text(extension_id)
            items.append(
                Text(
                    text=name,
                    subtext=f"{status} · {description}",
                    icon="msg_customize",
                    accent=self._extension_has_update(extension_id),
                    create_sub_fragment=(
                        lambda extension_id=extension_id: (
                            self._create_extension_detail_settings(extension_id)
                        )
                    ),
                    link_alias=f"extension_{extension_id}",
                )
            )

        return items

    def _extension_integrity_setting(
        self,
        extension_id: str,
        installed: Optional[Dict[str, Any]],
    ) -> Any:
        if not installed:
            return Text(
                text="Проверка перед установкой",
                subtext="SHA-256 и Git blob сверяются с каталогом",
                icon="msg_info",
            )
        if extension_id in self._extension_modules:
            return Text(
                text="Файл проверен",
                subtext="SHA-256 совпадает с установленной версией",
                icon="msg_info",
            )
        error = self._extension_last_errors.get(extension_id)
        if error:
            return Text(
                text="Не удалось запустить",
                subtext=str(error)[:180],
                icon="msg_error",
                red=True,
            )
        return Text(
            text="Проверка при включении",
            subtext="SHA-256 сверяется при каждом запуске расширения",
            icon="msg_info",
        )

    def _create_extension_detail_settings(self, extension_id: str) -> List[Any]:
        entry = self._extension_catalog.get(extension_id, {})
        installed = self._installed_extensions().get(extension_id)
        name = str(entry.get("name") or extension_id)
        description = str(entry.get("description") or "Нет описания")
        items: List[Any] = [Header(text=name)]

        if entry.get("preview"):
            try:
                items.append(
                    Custom(
                        factory=_extension_preview_factory(extension_id).instance.java,
                    )
                )
            except Exception as exc:
                # A preview is optional decoration. Never let a client/API
                # mismatch prevent the extension detail page from opening.
                self._log_suppressed("create extension preview setting", exc)

        status = self._extension_status_text(extension_id)
        api_level = (installed or entry).get("api")
        if api_level:
            status = f"{status} · API {api_level}"
        items.append(Text(text=status, subtext=description, icon="msg_info"))

        compatible, reason = (
            self._extension_compatible(entry) if entry else (True, "")
        )
        if entry and not compatible:
            items.append(
                Text(
                    text="Несовместимо",
                    subtext=reason,
                    icon="msg_error",
                    red=True,
                )
            )

        job = self._extension_jobs.get(extension_id)
        if job:
            items.append(
                Text(
                    text="Установка…",
                    subtext="Скачиваем и проверяем файл расширения",
                    icon="msg_download",
                )
            )
            return items

        has_update = bool(installed) and self._extension_has_update(extension_id)
        if installed:
            if has_update:
                items.append(
                    Text(
                        text=f"Обновить до {entry['version']}",
                        subtext="Скачать новую проверенную версию",
                        icon="msg_download",
                        accent=True,
                        on_click=(
                            lambda view,
                            extension_id=extension_id: self._install_extension_clicked(
                                extension_id,
                                view,
                            )
                        ),
                    )
                )
            items.append(
                Switch(
                    key=self._extension_enabled_key(extension_id),
                    text="Включено",
                    default=False,
                    subtext="Можно выключить без удаления",
                    icon="msg_settings",
                    on_change=(
                        lambda value,
                        extension_id=extension_id: self._extension_enabled_changed(
                            extension_id,
                            value,
                        )
                    ),
                )
            )
            if self._extension_enabled(extension_id):
                items.extend(self._create_extension_owned_settings(extension_id))
        elif entry:
            items.append(
                Text(
                    text="Установить" if compatible else "Установка недоступна",
                    subtext=(
                        f"v{entry['version']} · SHA-256 проверяется перед запуском"
                        if compatible
                        else reason
                    ),
                    icon="msg_download",
                    accent=compatible,
                    on_click=(
                        (
                            lambda view,
                            extension_id=extension_id: self._install_extension_clicked(
                                extension_id,
                                view,
                            )
                        )
                        if compatible
                        else None
                    ),
                )
            )

        items.append(Header(text="Проверка"))
        items.append(self._extension_integrity_setting(extension_id, installed))
        source = installed or entry
        requirements = []
        minimum = str(source.get("min_glassify") or "")
        if minimum and minimum != "0":
            requirements.append(f"Glassify {minimum}+")
        extera_min = str(source.get("min_exteragram") or "")
        if extera_min:
            requirements.append(f"exteraGram {extera_min}+")
        if requirements:
            items.append(
                Text(
                    text="Требования",
                    subtext=" · ".join(requirements),
                    icon="msg_settings",
                )
            )
        commit = str(source.get("commit") or "")
        if _GIT_COMMIT_RE.fullmatch(commit):
            items.append(
                Text(
                    text="Источник",
                    subtext=f"commit {commit[:7]} · открыть на GitHub",
                    icon="msg_link",
                    on_click=(
                        lambda view, commit=commit: self._open_link(
                            f"{GLASSIFY_REPOSITORY_URL}/commit/{commit}"
                        )
                    ),
                )
            )

        if installed:
            items.append(Header(text="Управление"))
            if entry and not has_update:
                items.append(
                    Text(
                        text="Переустановить",
                        subtext="Повторно скачать текущую версию и проверить SHA-256",
                        icon="msg_retry",
                        on_click=(
                            lambda view,
                            extension_id=extension_id: self._install_extension_clicked(
                                extension_id,
                                view,
                            )
                        ),
                    )
                )
            items.append(
                Text(
                    text="Удалить расширение",
                    subtext="Спросим подтверждение перед удалением",
                    icon="msg_delete",
                    red=True,
                    on_click=(
                        lambda view,
                        extension_id=extension_id: self._confirm_uninstall_extension(
                            extension_id,
                            view,
                        )
                    ),
                )
            )
        else:
            error = self._extension_last_errors.get(extension_id)
            if error:
                items.append(Divider(text=f"Последняя ошибка: {error[:180]}"))
        return items

    def _confirm_uninstall_extension(self, extension_id: str, _view=None):
        if extension_id in self._extension_jobs:
            self._extension_notify("Дождитесь завершения текущей операции")
            return
        entry = self._extension_catalog.get(extension_id, {})
        name = str(entry.get("name") or extension_id)
        if self._show_uninstall_dialog(extension_id, name):
            return

        # No dialog API on this SDK build: confirm with a second tap instead.
        pending_id, pending_at = self._pending_uninstall
        now = time.monotonic()
        if pending_id == extension_id and now - pending_at <= 4.0:
            self._pending_uninstall = ("", 0.0)
            self._uninstall_extension_clicked(extension_id)
            return
        self._pending_uninstall = (extension_id, now)
        self._extension_notify(
            "Нажмите «Удалить расширение» ещё раз, чтобы подтвердить"
        )

    def _show_uninstall_dialog(self, extension_id: str, name: str) -> bool:
        if AlertDialogBuilder is None:
            return False
        try:
            fragment = get_last_fragment()
            activity = fragment.getParentActivity() if fragment is not None else None
            if activity is None:
                return False
            builder = AlertDialogBuilder(activity)
            builder.set_title(f"Удалить {name}?")
            builder.set_message(
                "Файлы расширения будут удалены, а само оно выключится. "
                "Установить снова можно из каталога."
            )
            builder.set_positive_button(
                "Удалить",
                lambda *_args, extension_id=extension_id: (
                    self._uninstall_extension_clicked(extension_id)
                ),
            )
            builder.set_negative_button("Отмена", lambda *_args: None)
            builder.show()
            try:
                builder.make_button_red(AlertDialogBuilder.BUTTON_POSITIVE)
            except Exception as exc:
                self._log_suppressed("style uninstall dialog", exc)
            return True
        except Exception as exc:
            self._log_suppressed("show uninstall dialog", exc)
            return False

    # ------------------------------------------------------------------
    # Settings actions: links, energy saving, diagnostics
    # ------------------------------------------------------------------

    def _open_energy_settings(self, _view=None):
        try:
            fragment = get_last_fragment()
            if fragment is None:
                raise RuntimeError("no visible fragment")
            LiteModeSettingsActivity = jclass("org.telegram.ui.LiteModeSettingsActivity")
            fragment.presentFragment(LiteModeSettingsActivity())
        except Exception as exc:
            self._log_suppressed("open energy saving settings", exc)
            try:
                BulletinHelper.show_info("Откройте Настройки → Энергосбережение")
            except Exception as bulletin_exc:
                _note_suppressed(bulletin_exc)

    def _open_link(self, url: str, _view=None):
        try:
            from org.telegram.messenger.browser import Browser

            fragment = get_last_fragment()
            context = fragment.getParentActivity() if fragment is not None else None
            Browser.openUrl(context or ApplicationLoader.applicationContext, str(url))
        except Exception as exc:
            self._log_suppressed("open link", exc)
            try:
                AndroidUtilities.addToClipboard(str(url))
                BulletinHelper.show_info("Не удалось открыть ссылку, она скопирована")
            except Exception as fallback_exc:
                _note_suppressed(fallback_exc)

    def _diagnostics_text(self) -> str:
        def on_off(flag: bool) -> str:
            return "вкл" if flag else "выкл"

        lines = [f"Glassify {_version_label()} (сборка {__build__})"]
        try:
            context = ApplicationLoader.applicationContext
            package_name = str(context.getPackageName())
            package_info = context.getPackageManager().getPackageInfo(package_name, 0)
            lines.append(f"Клиент: {package_name} {package_info.versionName}")
        except Exception as exc:
            lines.append(f"Клиент: неизвестно ({type(exc).__name__})")
        try:
            Build = jclass("android.os.Build")
            BuildVersion = jclass("android.os.Build$VERSION")
            lines.append(
                f"Android: {BuildVersion.RELEASE} (SDK {BuildVersion.SDK_INT}), "
                f"{Build.MANUFACTURER} {Build.MODEL}"
            )
        except Exception as exc:
            lines.append(f"Android: неизвестно ({type(exc).__name__})")

        self.ensure_native_flags()
        lines.append(
            "Blur3 в энергосбережении: "
            + ("включён" if self._native_available else "выключен")
        )
        lines.append(f"Интенсивность: {self.current_strength()}%")
        lines.append(
            "Области: "
            f"шапка {on_off(self._progressive_blur_enabled())}, "
            f"истории {on_off(self._stories_blur_enabled())}, "
            f"клавиатура {on_off(self._keyboard_glass_enabled())}"
        )
        lines.append(
            "Активно: "
            f"оверлеев {len(self._top_overlays)}, "
            f"drawable {len(self._liquid_drawables)}, "
            f"клавиатур {len(self._keyboard_runtime)}, "
            f"M3-шапок {len(self._m3_chat_headers)}"
        )

        if self._extensions_master_enabled():
            parts = []
            for extension_id, entry in sorted(self._installed_extensions().items()):
                if extension_id in self._extension_modules:
                    state = "работает"
                elif self._extension_enabled(extension_id):
                    state = "не запущено"
                else:
                    state = "выключено"
                parts.append(f"{extension_id} {entry.get('version', '?')} ({state})")
            lines.append("Расширения: " + (", ".join(parts) if parts else "не установлены"))
            for extension_id, error in sorted(self._extension_last_errors.items()):
                lines.append(f"  ошибка {extension_id}: {str(error)[:200]}")
            if self._extension_catalog_error:
                lines.append(f"Каталог: {self._extension_catalog_error[:200]}")
        else:
            lines.append("Расширения: выключены")

        lines.append(
            f"Fallback-ветки: {_SUPPRESSED_FAILURE_TOTAL} "
            f"в {len(_SUPPRESSED_FAILURES)} местах"
        )
        for key, count in sorted(
            _SUPPRESSED_FAILURES.items(), key=lambda pair: -int(pair[1])
        )[:8]:
            lines.append(f"  {count}× {str(key)[:220]}")
        logged = sorted(self._suppressed_errors.items(), key=lambda pair: -int(pair[1]))
        if logged:
            lines.append("Ошибки:")
            for key, count in logged[:5]:
                lines.append(f"  {count}× {str(key)[:160]}")
        return "\n".join(lines)

    def _copy_diagnostics(self, _view=None):
        try:
            text = self._diagnostics_text()
        except Exception as exc:
            text = f"Glassify {_version_label()}: диагностика не собрана ({exc})"
        try:
            AndroidUtilities.addToClipboard(text)
            BulletinHelper.show_info("Диагностика скопирована")
        except Exception as exc:
            self._log_suppressed("copy diagnostics", exc)
            self.log(text)
            try:
                BulletinHelper.show_info(
                    "Не удалось скопировать: диагностика записана в журнал плагина"
                )
            except Exception as bulletin_exc:
                _note_suppressed(bulletin_exc)

    # ------------------------------------------------------------------
    # Settings pages
    # ------------------------------------------------------------------

    def _create_update_report_settings(self) -> List[Any]:
        items: List[Any] = [Header(text=f"Что нового в {_version_label()}")]
        try:
            items.append(Custom(factory=UpdateReportFactory.instance.java))
        except Exception as exc:
            self._log_suppressed("create update report setting", exc)
            release = GLASSIFY_CHANGELOG.get(str(__version__)) or {}
            for title, description in tuple(release.get("items") or ()):
                items.append(Text(text=title, subtext=description, icon="msg_info"))
        items.append(
            Text(
                text="Подробная история",
                subtext="Все технические изменения — на GitHub",
                icon="msg_link",
                on_click=lambda view: self._open_link(
                    f"{GLASSIFY_REPOSITORY_URL}/commits/main"
                ),
            )
        )
        return items

    def _area_switches(self) -> List[Any]:
        return [
            Switch(
                key=self.PROGRESSIVE_BLUR_ENABLED_KEY,
                text="Размытие под шапкой",
                default=True,
                subtext="Плавный переход от шапки к сообщениям в чатах",
                icon="msg_discussion",
                on_change=self._progressive_blur_changed,
            ),
            Switch(
                key=self.STORIES_BLUR_ENABLED_KEY,
                text="Стекло над историями",
                default=True,
                subtext="Мягкое размытие под панелью историй на вкладке «Чаты»",
                icon="msg_camera",
                on_change=self._stories_blur_changed,
            ),
            Switch(
                key=self.KEYBOARD_GLASS_ENABLED_KEY,
                text="Стеклянная клавиатура",
                default=True,
                subtext="Панель эмодзи и стикеров, клавиатуры ботов",
                icon="msg_sticker",
                on_change=self._keyboard_glass_changed,
            ),
        ]

    def _extensions_master_switch(self) -> Any:
        return Switch(
            key=self.EXTENSIONS_ENABLED_KEY,
            text="Расширения",
            default=False,
            subtext="Код скачивается только по кнопке «Установить»",
            icon="msg_list",
            on_change=self._extensions_master_changed,
        )

    def _create_glass_settings(self) -> List[Any]:
        items: List[Any] = [Header(text="Интенсивность")]
        try:
            items.append(Custom(factory=StrengthSliderFactory.instance.java))
        except Exception as exc:
            _note_suppressed(exc)
            self._log_suppressed("settings slider factory", exc)
            items.append(
                Divider(
                    text=(
                        f"Интенсивность: {self.current_strength()}%. "
                        "Ползунок недоступен в этой сборке клиента."
                    )
                )
            )
        items.append(
            Divider(
                text=(
                    "Меняет нативные параметры Liquid Glass. "
                    "Применяется сразу, без перезапуска."
                )
            )
        )
        return items

    def _create_areas_settings(self) -> List[Any]:
        items: List[Any] = [Header(text="Где применять")]
        items.extend(self._area_switches())
        items.append(
            Divider(
                text=(
                    "Если на вашей сборке что-то выглядит не так, "
                    "отключите только эту область."
                )
            )
        )
        return items

    def _create_extensions_category_settings(self) -> List[Any]:
        items: List[Any] = [Header(text="Расширения"), self._extensions_master_switch()]
        if self._extensions_master_enabled():
            # Catalog rows without their own page header.
            items.extend(self._create_extensions_settings()[1:])
        else:
            items.append(
                Divider(
                    text=(
                        "Выключены по умолчанию. Каталог загружается только "
                        "после включения, а каждое расширение включается отдельно."
                    )
                )
            )
        return items

    def _create_settings_impl(self) -> List[Any]:
        # Build the standard SDK rows first. Rich custom rows are optional and
        # must never become a single point of failure for the whole page.
        self.ensure_native_flags()
        items: List[Any] = []

        try:
            items.append(Custom(factory=GlassifyHeaderFactory.instance.java))
        except Exception as exc:
            _note_suppressed(exc)
            self._log_suppressed("settings header factory", exc)
            items.append(Header(text=f"Glassify {_version_label()}"))

        if not self._native_available:
            try:
                items.append(Custom(factory=NativeWarningFactory.instance.java))
            except Exception as exc:
                _note_suppressed(exc)
                items.append(
                    Text(
                        text="Liquid Glass выключен в клиенте",
                        subtext="Нажмите, чтобы открыть «Энергосбережение»",
                        icon="msg_warning",
                        red=True,
                        on_click=self._open_energy_settings,
                    )
                )

        extensions_accent = (
            self._extensions_master_enabled() and self._extension_updates_count() > 0
        )
        items.append(Header(text="Категории"))
        items.extend(
            [
                Text(
                    text="Стекло",
                    icon="msg_palette",
                    create_sub_fragment=self._create_glass_settings,
                    link_alias="glass",
                ),
                Text(
                    text="Где применять",
                    icon="msg_customize",
                    create_sub_fragment=self._create_areas_settings,
                    link_alias="areas",
                ),
                Text(
                    text="Расширения",
                    icon="msg_list",
                    accent=extensions_accent,
                    create_sub_fragment=self._create_extensions_category_settings,
                    link_alias="extensions",
                ),
                Text(
                    text="Что нового",
                    icon="msg_info",
                    create_sub_fragment=self._create_update_report_settings,
                    link_alias="whats_new",
                ),
            ]
        )

        items.append(Header(text="Ссылки"))
        items.extend(
            [
                Text(
                    text="Автор",
                    icon="msg_contacts",
                    on_click=lambda view: self._open_link(GLASSIFY_AUTHOR_URL),
                ),
                Text(
                    text="Исходный код",
                    icon="msg_link",
                    on_click=lambda view: self._open_link(GLASSIFY_REPOSITORY_URL),
                ),
                Text(
                    text="Скопировать диагностику",
                    icon="msg_copy",
                    on_click=self._copy_diagnostics,
                ),
                Divider(
                    text=(
                        f"Glassify {_version_label()} · сборка {__build__} · "
                        f"exteraGram {str(__app_version__).lstrip('>=').strip()}+"
                    )
                ),
            ]
        )
        return items

    def create_settings(self) -> List[Any]:
        try:
            settings = self._create_settings_impl()
            if settings:
                return settings
            raise RuntimeError("settings builder returned an empty list")
        except Exception as exc:
            # Last-resort page: plugin settings must never become completely
            # blank because one optional capability or custom row failed.
            _note_suppressed(exc)
            try:
                self.log(f"Glassify settings fallback activated: {exc}")
            except Exception:
                pass
            fallback: List[Any] = [
                Header(text=f"Glassify {_version_label()}"),
                Divider(
                    text=(
                        "Часть оформления настроек недоступна в этой сборке "
                        "exteraGram, поэтому открыт безопасный режим."
                    )
                ),
            ]
            try:
                fallback.extend(self._area_switches())
                fallback.append(self._extensions_master_switch())
            except Exception as switches_exc:
                _note_suppressed(switches_exc)
            fallback.append(
                Text(
                    text=f"Glassify {_version_label()}",
                    subtext=f"Автор: {GLASSIFY_AUTHOR_HANDLE} · безопасный режим",
                    icon="msg_info",
                )
            )
            return fallback

    def rebuild_current_fragment_views(self):
        fragment = None
        try:
            fragment = get_last_fragment()
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)
        if fragment is None:
            return

        try:
            parent_layout = fragment.getParentLayout()
        except Exception:
            parent_layout = None

        if parent_layout is not None:
            try:
                parent_layout.rebuildAllFragmentViews(
                    False,
                    False,
                )
                return
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

        try:
            fragment.rebuildView()
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)

    def current_strength(self) -> int:
        if self._preview_strength is not None:
            return self._preview_strength
        if self._strength_cache is not None:
            return int(self._strength_cache)
        try:
            value = int(
                self.get_setting(
                    "glass_strength",
                    self.DEFAULT_STRENGTH,
                )
            )
        except Exception:
            value = self.DEFAULT_STRENGTH
        value = max(1, min(100, value))
        self._strength_cache = value
        return value

    def preview_strength(self, value: int):
        self._preview_strength = max(1, min(100, int(value)))
        # SeekBar can emit substantially more events than we need to render.
        # Keep only the newest preview and cap expensive material propagation
        # to roughly one pass every 24 ms.
        self.schedule_coalesced(
            ("strength_preview",),
            lambda: self.apply_strength(self.current_strength()),
            24,
        )

    def commit_strength(self, value: int):
        value = max(1, min(100, int(value)))
        self._preview_strength = None
        self._strength_cache = value
        # Cancel a queued preview so it cannot run after the final committed pass.
        self._coalesced_tokens.pop(("strength_preview",), None)
        self.set_setting("glass_strength", value)
        self.apply_strength(value)
        self.log(f"Glassify: Liquid Glass strength={value}")

    def ensure_native_flags(self):
        """Check Blur3 prerequisites without modifying user settings."""
        try:
            from org.telegram.messenger import LiteMode

            required = int(LiteMode.FLAG_LIQUID_GLASS) | int(LiteMode.FLAG_CHAT_BLUR)
            current = int(LiteMode.getValue(True))
            self._native_available = (current & required) == required
        except Exception as exc:
            self._native_available = False
            self.log(f"Glassify: Blur3 capability check failed: {exc}")

    def _hook_required_method(
        self,
        clazz: Any,
        method_name: str,
        hook: MethodHook,
        label: str,
    ) -> bool:
        """Install a hook that belongs to the plugin's core integration."""
        if clazz is None:
            return False
        try:
            self.hook_all_methods(clazz, method_name, hook)
            return True
        except Exception as exc:
            self.log(f"Glassify: {label} hook failed: {exc}")
            return False

    def _hook_optional_methods(
        self,
        clazz: Any,
        method_names: Tuple[str, ...],
        hook: MethodHook,
    ):
        """Hook methods which may be absent on some Telegram builds."""
        if clazz is None:
            return
        for method_name in method_names:
            try:
                self.hook_all_methods(clazz, method_name, hook)
            except Exception:
                # Telegram renames/removes internal methods between builds.
                # Missing optional entry points must not disable the plugin.
                continue

    def _hook_optional_constructors(self, clazz: Any, hook: MethodHook):
        if clazz is None:
            return
        try:
            self.hook_all_constructors(clazz, hook)
        except Exception:
            # Constructor signatures are also version-dependent.
            return

    def install_hooks(self):
        try:
            media_controller = get_media_data_controller()
            media_class = media_controller.getClass() if media_controller is not None else None
            self._hook_optional_methods(
                media_class,
                ("setPlaceholderImageByIndex",),
                _PluginIconAfterHook(self),
            )
        except Exception as exc:
            self.log(f"Glassify: plugin icon hook unavailable: {exc}")

        factory_class = self.find_class_safe(
            "org.telegram.ui.Components.blur3.BlurredBackgroundDrawableViewFactory"
        )
        self._hook_required_method(
            factory_class,
            "create",
            _RememberDrawableAfterHook(self),
            "blur3 factory",
        )

        fragment_targets = (
            (
                "org.telegram.ui.DialogsActivity",
                _FragmentCreatedAfterHook(self, "dialogs", 96),
            ),
            (
                "org.telegram.ui.ChatActivity",
                _FragmentCreatedAfterHook(self, "chat", 112),
            ),
            (
                "org.telegram.ui.MainTabsActivity",
                _MainTabsCreatedAfterHook(self, 112),
            ),
        )
        for class_name, after_hook in fragment_targets:
            clazz = self.find_class_safe(class_name)
            if clazz is None:
                continue
            before_kind = getattr(after_hook, "kind", "")
            self._hook_required_method(
                clazz,
                "createView",
                _EnsureNativeBeforeHook(self, before_kind),
                f"pre-createView for {class_name}",
            )
            self._hook_required_method(
                clazz,
                "createView",
                after_hook,
                f"createView for {class_name}",
            )

        chat_class = self.find_class_safe("org.telegram.ui.ChatActivity")
        self._hook_optional_methods(
            chat_class,
            ("onTransitionAnimationEnd",),
            _ChatTransitionEndAfterHook(self),
        )
        self._hook_optional_methods(
            chat_class,
            ("updateColors",),
            _M3ChatHeaderColorsAfterHook(self),
        )

        main_tabs_class = self.find_class_safe("org.telegram.ui.MainTabsActivity")
        self._hook_optional_methods(
            main_tabs_class,
            (
                "onApplyWindowInsets",
                "onResume",
                "onTransitionAnimationEnd",
                "onConfigurationChanged",
            ),
            _MainTabsInsetShieldAfterHook(self),
        )

        dialogs_class = self.find_class_safe("org.telegram.ui.DialogsActivity")
        self._hook_optional_methods(
            dialogs_class,
            (
                "updateStoriesVisibility",
                "onResume",
                "closeSearching",
            ),
            _DialogsStoriesRefreshHook(self),
        )
        self._hook_required_method(
            dialogs_class,
            "showSearch",
            _DialogsSearchVisibilityHook(self),
            "search visibility",
        )

        input_container_class = self.find_class_safe(
            "org.telegram.ui.Components.chat.ChatInputViewsContainer"
        )
        self._hook_optional_methods(
            input_container_class,
            ("setUnderKeyboardBackgroundDrawable", "updateColors"),
            _InAppKeyboardDrawableAfterHook(self),
        )

        enter_view_class = self.find_class_safe(
            "org.telegram.ui.Components.ChatActivityEnterView"
        )
        self._hook_optional_methods(
            enter_view_class,
            ("showPopup", "createEmojiView", "onSizeChanged"),
            _EnterViewPanelShownAfterHook(self),
        )

        emoji_view_class = self.find_class_safe("org.telegram.ui.Components.EmojiView")
        self._hook_optional_constructors(
            emoji_view_class,
            _EmojiPanelCreatedAfterHook(self),
        )
        self._hook_optional_methods(
            emoji_view_class,
            ("updateColors",),
            _EmojiPanelRefreshAfterHook(self),
        )

        bot_keyboard_class = self.find_class_safe(
            "org.telegram.ui.bots.BotKeyboardView"
        )
        self._hook_optional_constructors(
            bot_keyboard_class,
            _BotKeyboardCreatedAfterHook(self),
        )
        self._hook_optional_methods(
            bot_keyboard_class,
            ("updateColors", "setButtons"),
            _BotKeyboardRefreshAfterHook(self),
        )

    def keyboard_panel_alpha(
        self,
        strength: Optional[int] = None,
    ) -> float:
        value = self.current_strength() if strength is None else int(strength)
        value = max(1, min(100, value))
        progress = value / 100.0

        # Low tint keeps the wallpaper visible without expensive strong blur.
        alpha = 0.20 + 0.16 * progress
        profile = self._active_material_profile()
        if profile is not None:
            alpha *= profile["overlay_alpha_scale"]
        return float(max(0.06, min(0.54, alpha)))

    def bot_button_alpha(
        self,
        strength: Optional[int] = None,
    ) -> int:
        value = self.current_strength() if strength is None else int(strength)
        value = max(1, min(100, value))
        progress = value / 100.0
        alpha = 150 + 34 * progress
        profile = self._active_material_profile()
        if profile is not None:
            alpha *= profile["overlay_alpha_scale"]
        return max(64, min(230, int(round(alpha))))

    def schedule_keyboard_refresh(
        self,
        enter_view: Any,
        delay: int = 24,
    ):
        if enter_view is None:
            return
        key = _identity(enter_view)
        self.schedule_coalesced(
            ("keyboard_enter", key),
            lambda enter_view=enter_view: self.refresh_enter_view_panels(enter_view),
            delay,
        )

    def schedule_keyboard_container_refresh(
        self,
        container: Any,
        delay: int = 32,
    ):
        if container is None:
            return
        key = _identity(container)
        self.schedule_coalesced(
            ("keyboard_container", key),
            lambda container=container: self.decorate_in_app_keyboard_container(container),
            delay,
        )

    def schedule_keyboard_panel_refresh(
        self,
        panel: Any,
        kind: str,
        delay: int = 48,
    ):
        if panel is None:
            return
        key = _identity(panel)
        kind = str(kind)
        self.schedule_coalesced(
            ("keyboard_panel", kind, key),
            lambda panel=panel, kind=kind: self.run_keyboard_panel_refresh(panel, kind),
            delay,
        )

    def run_keyboard_panel_refresh(
        self,
        panel: Any,
        kind: str,
    ):
        if kind == "emoji":
            self.decorate_emoji_panel(panel)
        elif kind == "bot":
            self.decorate_bot_keyboard(panel)

    def find_in_app_keyboard_container(self, view: Any):
        current = view
        visited = set()

        for _ in range(14):
            if current is None:
                break

            key = _identity(current)
            if key in visited:
                break
            visited.add(key)

            try:
                class_name = str(current.getClass().getName())
            except Exception:
                class_name = ""

            if class_name.endswith("Components.chat.ChatInputViewsContainer"):
                return current

            try:
                current = current.getParent()
            except Exception:
                break
        return None

    def resolve_chat_fragment(self, view: Any = None):
        fragment = None
        try:
            fragment = get_last_fragment()
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)

        if fragment is not None:
            try:
                class_name = str(fragment.getClass().getName())
                if class_name.endswith("org.telegram.ui.ChatActivity"):
                    return fragment
            except Exception:
                return fragment

        current = view
        for _ in range(10):
            if current is None:
                break
            parent_fragment = self.field(current, "parentFragment")
            if parent_fragment is not None:
                return parent_fragment
            try:
                current = current.getParent()
            except Exception:
                break
        return fragment

    def resolve_keyboard_context(
        self,
        view: Any,
        data: Optional[Dict[str, Any]] = None,
    ):
        # Emoji/Bot refresh callbacks are frequent. Once their ChatActivity and
        # ChatInputViewsContainer are known, reuse that association instead of
        # climbing the Java View parent chain again.
        if isinstance(data, dict):
            cached_fragment = data.get("fragment")
            cached_container = data.get("container")
            if cached_fragment is not None and cached_container is not None:
                if not self._view_is_detached(cached_container):
                    return cached_fragment, cached_container

        fragment = self.resolve_chat_fragment(view)
        container = (
            self.field(fragment, "chatInputViewsContainer")
            if fragment is not None
            else None
        )
        if container is None:
            container = self.find_in_app_keyboard_container(view)

        if isinstance(data, dict):
            data["fragment"] = fragment
            data["container"] = container
        return fragment, container

    def resolve_keyboard_factory(self, fragment: Any):
        if fragment is None:
            return None

        # Pure blur first for keyboard panels. It is substantially cheaper than
        # RenderNode liquid refraction across a large, frequently changing area.
        return (
            self.field(fragment, "iBlur3FactoryBlur")
            or self.field(fragment, "glassBackgroundDrawableFactoryFrosted")
            or self.field(fragment, "iBlur3FactoryFrostedLiquidGlass")
            or self.field(fragment, "glassBackgroundDrawableFactory")
            or self.field(fragment, "iBlur3FactoryLiquidGlass")
        )

    def resolve_keyboard_resources_provider(self, fragment: Any):
        if fragment is None:
            return None

        return self.field(fragment, "themeDelegate") or self.field(
            fragment, "resourceProvider"
        )

    def make_keyboard_provider(
        self,
        fragment: Any,
        color_key: int,
        alpha: float,
    ):
        from org.telegram.ui.Components.blur3.drawable.color import (
            BlurredBackgroundColorProviderThemed,
        )

        return BlurredBackgroundColorProviderThemed(
            self.resolve_keyboard_resources_provider(fragment),
            color_key,
            float(alpha),
        )

    def keyboard_material_signature(
        self,
        fragment: Any,
        strength: int,
    ):
        value = max(1, min(100, int(strength)))
        alpha = self.keyboard_panel_alpha(value)
        resources_provider = self.resolve_keyboard_resources_provider(fragment)
        tint = _theme_color(Theme.key_chat_emojiPanelBackground, resources_provider)
        return (
            value,
            int(self._material_revision),
            int(round(float(alpha) * 10000.0)),
            int(tint),
        )

    def apply_keyboard_drawable(
        self,
        drawable: Any,
        view: Any,
        strength: int,
        data: Optional[Dict[str, Any]] = None,
        fragment: Any = None,
    ) -> bool:
        if drawable is None:
            return False

        value = max(1, min(100, int(strength)))
        signature = self.keyboard_material_signature(fragment, value)
        if isinstance(data, dict) and data.get("last_material_signature") == signature:
            return True

        progress = value / 100.0
        intensity = 0.28 + 0.42 * progress
        thickness_dp = 6.0 + 8.0 * progress
        profile = self._active_material_profile()
        if profile is not None:
            intensity *= profile["intensity_scale"]
            thickness_dp *= profile["thickness_scale"]
        thickness = self.dp(thickness_dp)

        try:
            drawable.setIntensity(float(intensity))
            drawable.setThickness(int(thickness))
            if profile is not None:
                drawable.setStrokeWidth(
                    float(self.dp(profile["stroke_inner_dp"])),
                    float(self.dp(profile["stroke_outer_dp"])),
                )
                drawable.setShadowAlpha(float(profile["shadow_alpha"]))
            else:
                drawable.setStrokeWidth(0.0, 0.0)
                drawable.setShadowAlpha(0.0)
            drawable.updateColors()
        except Exception:
            return False

        if isinstance(data, dict):
            data["last_material_signature"] = signature

        try:
            if view is not None:
                view.invalidate()
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)
        return True

    def decorate_in_app_keyboard_container(
        self,
        container: Any,
        fragment: Any = None,
    ):
        if not self._native_available or container is None:
            return
        if not self._keyboard_glass_enabled():
            return

        key = _identity(container)
        if key in self._keyboard_replace_guard:
            return

        data = self._keyboard_runtime.get(key)
        if fragment is None and isinstance(data, dict):
            fragment = data.get("fragment")
        if fragment is None:
            fragment = self.resolve_chat_fragment(container)

        factory = self.resolve_keyboard_factory(fragment)
        if factory is None:
            self.log_once_keyboard(
                "factory_missing",
                "Glassify: optimized keyboard blur factory unavailable",
            )
            return

        current = self.field(
            container,
            "underKeyboardBackgroundDrawable",
        )

        if data is None:
            data = {
                "kind": "container",
                "view": container,
                "fragment": fragment,
                "factory": factory,
                "original_drawable": current,
                "drawable": None,
                "provider": None,
                "last_material_signature": None,
                "last_provider_alpha": None,
            }
            self._keyboard_runtime[key] = data
            self._maybe_prune_runtime_refs()

        replacement = data.get("drawable")

        # Create once. Reinstall only if Telegram replaced it.
        needs_replace = replacement is None or current is not replacement

        if needs_replace:
            try:
                provider = self.make_keyboard_provider(
                    fragment,
                    Theme.key_chat_emojiPanelBackground,
                    self.keyboard_panel_alpha(),
                )
                replacement = factory.create(container, provider)

                try:
                    replacement.enableInAppKeyboardOptimization()
                except Exception as _suppressed_exc:
                    _note_suppressed(_suppressed_exc)

                self._keyboard_replace_guard.add(key)
                try:
                    container.setUnderKeyboardBackgroundDrawable(replacement)
                finally:
                    self._keyboard_replace_guard.discard(key)

                replacement.setRadius(
                    self.dp(29),
                    self.dp(29),
                    0,
                    0,
                )
                replacement.setPadding(0)
                try:
                    replacement.setStrokeWidth(0.0, 0.0)
                    replacement.setShadowAlpha(0.0)
                except Exception as _suppressed_exc:
                    _note_suppressed(_suppressed_exc)

                data["drawable"] = replacement
                data["provider"] = provider
                data["factory"] = factory
                data["fragment"] = fragment
                data["container"] = container
                data["last_material_signature"] = None
                data["last_provider_alpha"] = None
            except Exception as exc:
                self._keyboard_replace_guard.discard(key)
                self.log(f"Glassify: optimized keyboard drawable failed: {exc}")
                return

        provider = data.get("provider")
        replacement = data.get("drawable")
        if replacement is None:
            return

        try:
            alpha = self.keyboard_panel_alpha()
            if provider is not None and data.get("last_provider_alpha") != alpha:
                provider.setAlpha(alpha)
                replacement.setColorProvider(provider)
                data["last_provider_alpha"] = alpha
                data["last_material_signature"] = None

            self.apply_keyboard_drawable(
                replacement,
                container,
                self.current_strength(),
                data,
                fragment,
            )
        except Exception as exc:
            self.log(f"Glassify: optimized keyboard apply failed: {exc}")
            return

        self.log_once_keyboard(
            "container_optimized",
            "Glassify: optimized single keyboard blur installed",
        )

    def remember_keyboard_background(
        self,
        data: Dict[str, Any],
        view: Any,
    ):
        if view is None:
            return

        backgrounds = data.setdefault("backgrounds", {})
        key = _identity(view)
        if key in backgrounds:
            return

        original = None
        try:
            original = view.getBackground()
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)

        backgrounds[key] = (view, original)

    def make_view_background_transparent(
        self,
        data: Dict[str, Any],
        view: Any,
    ):
        if view is None:
            return

        self.remember_keyboard_background(data, view)
        try:
            view.setBackground(None)
        except Exception:
            try:
                view.setBackgroundColor(0x00000000)
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

    def decorate_emoji_panel(self, panel: Any):
        if not self._native_available or panel is None:
            return
        if not self._keyboard_glass_enabled():
            return

        key = _identity(panel)
        data = self._keyboard_runtime.get(key)

        if data is None:
            data = {
                "kind": "emoji",
                "view": panel,
                "backgrounds": {},
                "visibility": {},
                "original_should_draw": self.field(
                    panel,
                    "shouldDrawBackground",
                ),
                "prepared": False,
            }
            self._keyboard_runtime[key] = data
            self._maybe_prune_runtime_refs()

        # Prepare the panel once; repeatedly walking its large child hierarchy
        # on the UI thread is unnecessary.
        if not bool(data.get("prepared", False)):
            try:
                panel.setShouldDrawBackground(False)
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

            self.make_view_background_transparent(data, panel)

            for field_name in (
                "emojiContainer",
                "stickersContainer",
                "gifContainer",
                "pager",
                "bottomTabContainer",
                "stickersTabContainer",
            ):
                self.make_view_background_transparent(
                    data,
                    self.field(panel, field_name),
                )

            bottom_background = self.field(
                panel,
                "bottomTabContainerBackground",
            )
            if bottom_background is not None:
                visibility = data.setdefault("visibility", {})
                bottom_key = _identity(bottom_background)
                if bottom_key not in visibility:
                    try:
                        visibility[bottom_key] = (
                            bottom_background,
                            int(bottom_background.getVisibility()),
                        )
                    except Exception:
                        visibility[bottom_key] = (
                            bottom_background,
                            View.VISIBLE,
                        )
                try:
                    bottom_background.setVisibility(View.GONE)
                except Exception as _suppressed_exc:
                    _note_suppressed(_suppressed_exc)

            data["prepared"] = True

        fragment, container = self.resolve_keyboard_context(panel, data)

        if container is not None:
            self.decorate_in_app_keyboard_container(
                container,
                fragment,
            )

        if not bool(data.get("panel_invalidated", False)):
            try:
                panel.invalidate()
                data["panel_invalidated"] = True
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

        self.log_once_keyboard(
            "emoji_optimized",
            "Glassify: emoji and sticker panel optimized",
        )

    def decorate_bot_keyboard(self, keyboard: Any):
        if not self._native_available or keyboard is None:
            return
        if not self._keyboard_glass_enabled():
            return

        key = _identity(keyboard)
        data = self._keyboard_runtime.get(key)

        if data is None:
            data = {
                "kind": "bot",
                "view": keyboard,
                "backgrounds": {},
                "button_alphas": {},
                "applied_button_alphas": {},
                "prepared": False,
            }
            self._keyboard_runtime[key] = data
            self._maybe_prune_runtime_refs()

        if not bool(data.get("prepared", False)):
            self.make_view_background_transparent(data, keyboard)
            self.make_view_background_transparent(
                data,
                self.field(keyboard, "scrollView"),
            )
            self.make_view_background_transparent(
                data,
                self.field(keyboard, "frameLayout"),
            )
            data["prepared"] = True

        # Keep Telegram's cheap selector drawables. Only lower their alpha;
        # no per-button blur drawables, providers or position watchers.
        alpha = self.bot_button_alpha()
        button_alphas = data.setdefault("button_alphas", {})
        buttons = self.field(keyboard, "buttonViews")

        if buttons is not None:
            try:
                count = int(buttons.size())
            except Exception:
                try:
                    count = len(buttons)
                except Exception:
                    count = 0

            for index in range(max(0, count)):
                try:
                    button = buttons.get(index)
                except Exception:
                    try:
                        button = buttons[index]
                    except Exception:
                        continue

                button_model = self.field(button, "button")
                if self.field(button_model, "style") is not None:
                    continue

                try:
                    background = button.getBackground()
                except Exception:
                    background = None

                if background is None:
                    continue

                background_key = _identity(background)
                if background_key not in button_alphas:
                    original_alpha = 255
                    try:
                        original_alpha = int(background.getAlpha())
                    except Exception as _suppressed_exc:
                        _note_suppressed(_suppressed_exc)
                    button_alphas[background_key] = (
                        background,
                        original_alpha,
                    )

                applied = data.setdefault("applied_button_alphas", {})
                if applied.get(background_key) != int(alpha):
                    try:
                        background.setAlpha(alpha)
                        button.invalidate()
                        applied[background_key] = int(alpha)
                    except Exception as _suppressed_exc:
                        _note_suppressed(_suppressed_exc)

        fragment, container = self.resolve_keyboard_context(keyboard, data)

        if container is not None:
            self.decorate_in_app_keyboard_container(
                container,
                fragment,
            )

        self.log_once_keyboard(
            "bot_optimized",
            "Glassify: bot keyboard optimized with shared glass",
        )

    def refresh_enter_view_panels(self, enter_view: Any):
        if enter_view is None:
            return

        fragment = self.field(enter_view, "parentFragment")
        if fragment is None:
            fragment = self.resolve_chat_fragment(enter_view)

        container = (
            self.field(fragment, "chatInputViewsContainer")
            if fragment is not None
            else None
        )
        if container is not None:
            self.decorate_in_app_keyboard_container(
                container,
                fragment,
            )

        emoji_view = self.field(enter_view, "emojiView")
        if emoji_view is not None:
            self.decorate_emoji_panel(emoji_view)

        bot_keyboard = self.field(enter_view, "botKeyboardView")
        if bot_keyboard is not None:
            self.decorate_bot_keyboard(bot_keyboard)

    def decorate_chat_bottom_panels(self, fragment: Any):
        if fragment is None:
            return

        enter_view = self.field(fragment, "chatActivityEnterView") or self.field(
            fragment, "enterView"
        )
        if enter_view is not None:
            self.schedule_keyboard_refresh(enter_view, 32)

    def update_keyboard_panels(self, strength: int):
        for data in list(self._keyboard_runtime.values()):
            kind = data.get("kind")

            if kind == "container":
                provider = data.get("provider")
                drawable = data.get("drawable")
                view = data.get("view")
                fragment = data.get("fragment")

                try:
                    alpha = self.keyboard_panel_alpha(strength)
                    if provider is not None and data.get("last_provider_alpha") != alpha:
                        provider.setAlpha(alpha)
                        drawable.setColorProvider(provider)
                        data["last_provider_alpha"] = alpha
                        data["last_material_signature"] = None

                    self.apply_keyboard_drawable(
                        drawable,
                        view,
                        strength,
                        data,
                        fragment,
                    )
                except Exception as _suppressed_exc:
                    _note_suppressed(_suppressed_exc)

            elif kind == "bot":
                alpha = int(self.bot_button_alpha(strength))
                applied = data.setdefault("applied_button_alphas", {})
                for background_key, value in data.get("button_alphas", {}).items():
                    try:
                        background, _original = value
                    except Exception:
                        continue
                    if applied.get(background_key) == alpha:
                        continue
                    try:
                        background.setAlpha(alpha)
                        applied[background_key] = alpha
                    except Exception as _suppressed_exc:
                        _note_suppressed(_suppressed_exc)

    def log_once_keyboard(self, token: str, message: str):
        marker = f"logged_{token}"
        state = self._runtime_refs.setdefault(
            -11416,
            {},
        )
        if bool(state.get(marker, False)):
            return
        state[marker] = True
        self.log(message)

    def restore_keyboard_panels(self):
        for data in list(self._keyboard_runtime.values()):
            kind = data.get("kind")

            if kind == "container":
                container = data.get("view")
                original = data.get("original_drawable")
                if container is not None and original is not None:
                    key = _identity(container)
                    try:
                        self._keyboard_replace_guard.add(key)
                        container.setUnderKeyboardBackgroundDrawable(original)
                    except Exception as _suppressed_exc:
                        _note_suppressed(_suppressed_exc)
                    finally:
                        self._keyboard_replace_guard.discard(key)

            for view, original in data.get(
                "backgrounds",
                {},
            ).values():
                try:
                    view.setBackground(original)
                except Exception as _suppressed_exc:
                    _note_suppressed(_suppressed_exc)

            for view, visibility in data.get(
                "visibility",
                {},
            ).values():
                try:
                    view.setVisibility(int(visibility))
                except Exception as _suppressed_exc:
                    _note_suppressed(_suppressed_exc)

            for background, original_alpha in data.get(
                "button_alphas",
                {},
            ).values():
                try:
                    background.setAlpha(int(original_alpha))
                except Exception as _suppressed_exc:
                    _note_suppressed(_suppressed_exc)

            if kind == "emoji":
                original_should_draw = data.get(
                    "original_should_draw",
                )
                panel = data.get("view")
                if panel is not None and original_should_draw is not None:
                    try:
                        panel.setShouldDrawBackground(bool(original_should_draw))
                    except Exception as _suppressed_exc:
                        _note_suppressed(_suppressed_exc)

        self._keyboard_runtime.clear()
        self._keyboard_replace_guard.clear()

    def set_field_value(
        self,
        obj: Any,
        name: str,
        value: Any,
    ) -> bool:
        if obj is None:
            return False

        clazz = None
        try:
            clazz = obj.getClass()
        except Exception:
            return False

        while clazz is not None:
            try:
                reflected = clazz.getDeclaredField(name)
                reflected.setAccessible(True)
                if isinstance(value, bool):
                    try:
                        reflected.setBoolean(obj, bool(value))
                    except Exception:
                        reflected.set(obj, bool(value))
                else:
                    reflected.set(obj, value)
                return True
            except Exception:
                try:
                    clazz = clazz.getSuperclass()
                except Exception:
                    break
        return False

    def glass_resources_provider(self, fragment: Any):
        return self.field(fragment, "themeDelegate") or self.field(
            fragment, "resourceProvider"
        )

    def glass_factory(
        self,
        fragment: Any,
        prefer_light: bool,
    ):
        if fragment is None:
            return None

        if prefer_light:
            return (
                self.field(fragment, "glassBackgroundDrawableFactoryFrosted")
                or self.field(fragment, "iBlur3FactoryBlur")
                or self.field(fragment, "glassBackgroundDrawableFactory")
                or self.field(fragment, "iBlur3FactoryFrostedLiquidGlass")
            )

        return (
            self.field(fragment, "glassBackgroundDrawableFactory")
            or self.field(fragment, "glassBackgroundDrawableFactoryFrosted")
            or self.field(fragment, "iBlur3FactoryFrostedLiquidGlass")
            or self.field(fragment, "iBlur3FactoryBlur")
        )

    def create_glass_surface(
        self,
        fragment: Any,
        view: Any,
        color_key: int,
        alpha: float,
        radius: int,
        prefer_light: bool,
    ):
        if fragment is None or view is None:
            return None

        factory = self.glass_factory(
            fragment,
            prefer_light,
        )
        if factory is None:
            return None

        try:
            from org.telegram.ui.Components.blur3.drawable.color import (
                BlurredBackgroundColorProviderThemed,
            )

            provider = BlurredBackgroundColorProviderThemed(
                self.glass_resources_provider(fragment),
                color_key,
                float(alpha),
            )
            drawable = factory.create(view, provider)
            drawable.setRadius(float(radius))

            if prefer_light:
                # Compact surfaces can touch their parent edge, so avoid
                # overdraw that would be clipped at the top.
                drawable.setPadding(0)
                try:
                    drawable.setStrokeWidth(
                        float(self.dp(0.35)),
                        float(self.dp(0.15)),
                    )
                    drawable.setShadowAlpha(0.0)
                except Exception as _suppressed_exc:
                    _note_suppressed(_suppressed_exc)
            else:
                drawable.setPadding(self.dp(1))
                try:
                    drawable.setStrokeWidth(
                        float(self.dp(0.65)),
                        float(self.dp(0.28)),
                    )
                    drawable.setShadowAlpha(0.05)
                except Exception as _suppressed_exc:
                    _note_suppressed(_suppressed_exc)

            view.setBackground(drawable)
            self.apply_glass_drawable(
                drawable,
                view,
                self.current_strength(),
                prefer_light,
            )
            return {
                "drawable": drawable,
                "view": view,
                "provider": provider,
                "prefer_light": bool(prefer_light),
            }
        except Exception as exc:
            self.log(f"Glassify: glass surface creation failed: {exc}")
            return None

    def apply_glass_drawable(
        self,
        drawable: Any,
        view: Any,
        strength: int,
        prefer_light: bool,
    ) -> bool:
        if drawable is None:
            return False

        value = max(1, min(100, int(strength)))
        progress = value / 100.0

        if prefer_light:
            # Use a lighter material for compact surfaces.
            intensity = 0.18 + 0.34 * progress
            thickness_dp = 4.0 + 6.0 * progress
        else:
            intensity = 0.28 + 0.55 * progress
            thickness_dp = 6.0 + 9.0 * progress

        profile = self._active_material_profile()
        if profile is not None:
            intensity *= profile["intensity_scale"]
            thickness_dp *= profile["thickness_scale"]
        thickness = self.dp(thickness_dp)

        try:
            drawable.setIntensity(float(intensity))
            drawable.setThickness(int(thickness))
            if profile is not None:
                drawable.setStrokeWidth(
                    float(self.dp(profile["stroke_inner_dp"])),
                    float(self.dp(profile["stroke_outer_dp"])),
                )
                drawable.setShadowAlpha(float(profile["shadow_alpha"]))
            elif prefer_light:
                drawable.setStrokeWidth(
                    float(self.dp(0.35)),
                    float(self.dp(0.15)),
                )
                drawable.setShadowAlpha(0.0)
            else:
                drawable.setStrokeWidth(
                    float(self.dp(0.65)),
                    float(self.dp(0.28)),
                )
                drawable.setShadowAlpha(0.05)
            drawable.updateColors()
            if view is not None:
                view.invalidate()
            return True
        except Exception:
            return False

    def find_class_safe(self, name: str):
        try:
            return find_class(name)
        except Exception as exc:
            self.log(f"Glassify: class lookup failed for {name}: {exc}")
            return None

    def _validate_material_profile(self, profile: Any) -> Dict[str, float]:
        if not isinstance(profile, dict):
            raise TypeError("material profile must be a dictionary")
        limits = {
            # Wide, still safe ranges are deliberate: LiquidGlass+ surface
            # choices must remain visibly different at any core strength.
            "intensity_scale": (0.20, 1.80),
            "thickness_scale": (0.25, 2.00),
            "stroke_inner_dp": (0.0, 2.5),
            "stroke_outer_dp": (0.0, 1.5),
            "shadow_alpha": (0.0, 0.22),
            "overlay_alpha_scale": (0.35, 1.35),
        }
        if set(profile) - set(limits):
            raise ValueError("material profile contains unsupported fields")
        result: Dict[str, float] = {}
        for key, (minimum, maximum) in limits.items():
            raw = profile.get(key, 1.0 if key.endswith("_scale") else 0.0)
            try:
                value = float(raw)
            except (TypeError, ValueError) as exc:
                raise ValueError(f"invalid material value: {key}") from exc
            result[key] = max(minimum, min(maximum, value))
        return result

    def _active_material_profile(self) -> Optional[Dict[str, float]]:
        if not self._extension_material_profiles:
            return None
        # Profiles are intentionally exclusive in v1: the most recently
        # applied extension owns the material, avoiding unpredictable blends.
        return next(reversed(self._extension_material_profiles.values()))

    def _restore_profile_materials(self):
        for entry in list(self._liquid_drawables.values()):
            drawable = entry.get("drawable")
            if drawable is None:
                continue
            try:
                drawable.setStrokeWidth(
                    float(entry.get("original_stroke_inner", 0.0) or 0.0),
                    float(entry.get("original_stroke_outer", 0.0) or 0.0),
                )
            except Exception as exc:
                self._log_suppressed("restore material stroke", exc)
            try:
                drawable.setShadowAlpha(
                    float(entry.get("original_shadow_alpha", 0.0) or 0.0)
                )
            except Exception as exc:
                self._log_suppressed("restore material shadow", exc)

    def _set_extension_material_profile(self, extension_id: str, profile: Any = None):
        extension_id = str(extension_id)
        if profile is None:
            if extension_id not in self._extension_material_profiles:
                return
            self._restore_profile_materials()
            self._extension_material_profiles.pop(extension_id, None)
        else:
            validated = self._validate_material_profile(profile)
            current = self._extension_material_profiles.get(extension_id)
            if (
                current == validated
                and self._extension_material_profiles
                and next(reversed(self._extension_material_profiles)) == extension_id
            ):
                return
            self._extension_material_profiles.pop(extension_id, None)
            self._extension_material_profiles[extension_id] = validated

        self._material_revision += 1
        self._material_signature_cache.clear()
        self._liquid_values_cache.clear()
        self.apply_strength(self.current_strength())

    def liquid_values(self, strength: Optional[int] = None) -> Tuple[float, int]:
        value = self.current_strength() if strength is None else int(strength)
        value = max(1, min(100, value))
        cache_key = (value, int(self._material_revision))
        cached = self._liquid_values_cache.get(cache_key)
        if cached is not None:
            return cached

        progress = value / 100.0
        intensity = 0.05 + 1.40 * progress
        thickness_dp = 4.0 + 14.0 * progress
        profile = self._active_material_profile()
        if profile is not None:
            intensity *= profile["intensity_scale"]
            thickness_dp *= profile["thickness_scale"]
        result = (float(intensity), int(self.dp(thickness_dp)))
        self._liquid_values_cache[cache_key] = result
        if len(self._liquid_values_cache) > 32:
            self._liquid_values_cache.clear()
            self._liquid_values_cache[cache_key] = result
        return result

    @staticmethod
    def _glassify_class_name(obj: Any) -> str:
        if obj is None:
            return ""
        try:
            return str(obj.getClass().getName())
        except Exception:
            return str(type(obj))

    def _object_has_m3_header_hint(self, obj: Any) -> bool:
        if obj is None:
            return False

        raw_class_name = self._glassify_class_name(obj)
        cache_key = str(raw_class_name)
        class_name = cache_key.lower()
        if (
            any(token in class_name for token in ("material3", "md3", "m3"))
            and any(
                token in class_name
                for token in ("header", "actionbar", "toolbar", "chat", "title")
            )
        ):
            return True

        hint_fields = self._m3_hint_fields_cache.get(cache_key)
        if hint_fields is None:
            collected = []
            try:
                clazz = obj.getClass()
            except Exception:
                clazz = None

            # Pay declared-fields reflection only once per Java class. Keep the
            # Field objects, but evaluate their values per instance so a false
            # feature flag on one chat cannot poison every later chat.
            for _ in range(5):
                if clazz is None:
                    break
                try:
                    fields = clazz.getDeclaredFields()
                    count = self.array_length(fields)
                except Exception:
                    fields = None
                    count = 0

                for index in range(count):
                    try:
                        field_obj = fields[index]
                        name = str(field_obj.getName()).lower()
                    except Exception:
                        continue

                    has_m3 = any(token in name for token in ("material3", "md3", "m3"))
                    has_header = any(
                        token in name
                        for token in ("header", "actionbar", "toolbar", "chat", "title")
                    )
                    if not (has_m3 and has_header):
                        continue
                    try:
                        field_obj.setAccessible(True)
                    except Exception as _suppressed_exc:
                        _note_suppressed(_suppressed_exc)
                    collected.append(field_obj)

                try:
                    clazz = clazz.getSuperclass()
                except Exception:
                    break

            hint_fields = tuple(collected)
            self._m3_hint_fields_cache[cache_key] = hint_fields
            if len(self._m3_hint_fields_cache) > 64:
                self._m3_hint_fields_cache = {cache_key: hint_fields}

        for field_obj in hint_fields:
            try:
                value = field_obj.get(obj)
                if isinstance(value, bool):
                    if value:
                        return True
                    continue
                if value is not None:
                    return True
            except Exception:
                # Matching field name remains a strong build-specific hint if
                # the bridge blocks reading the value.
                return True

        return False

    def _is_m3_chat_header_view(self, view: Any) -> bool:
        if view is None:
            return False

        if _identity(view) in self._m3_header_view_ids:
            return True

        name = self._glassify_class_name(view).lower()
        has_m3 = any(token in name for token in ("material3", "md3", "m3"))
        has_header = any(
            token in name
            for token in ("header", "actionbar", "toolbar", "chat", "title")
        )
        return bool(has_m3 and has_header)

    def _mark_protected_m3_subtree(
        self,
        root: Any,
        target: Any,
        max_depth: int = 3,
        max_nodes: int = 48,
    ):
        if root is None:
            return

        queue = [(root, 0)]
        seen = set()
        while queue and len(seen) < int(max_nodes):
            current, depth = queue.pop(0)
            key = _identity(current)
            if key in seen:
                continue
            seen.add(key)
            target.add(key)

            if depth >= int(max_depth) or not hasattr(current, "getChildCount"):
                continue
            try:
                count = int(current.getChildCount())
            except Exception:
                count = 0
            for index in range(count):
                try:
                    child = current.getChildAt(index)
                except Exception:
                    child = None
                if child is not None:
                    queue.append((child, depth + 1))

        return seen

    def _floating_m3_header_candidate(self, action_bar: Any):
        if action_bar is None:
            return None

        try:
            parent_width = int(action_bar.getMeasuredWidth())
            count = int(action_bar.getChildCount())
        except Exception:
            return None

        if parent_width <= 0:
            return None

        min_height = self.dp(40)
        max_height = self.dp(82)
        side_gap = self.dp(6)

        for index in range(count):
            try:
                child = action_bar.getChildAt(index)
                if child is None or int(child.getVisibility()) != int(View.VISIBLE):
                    continue

                width = int(child.getMeasuredWidth())
                height = int(child.getMeasuredHeight())
                left = int(child.getLeft())
                right_gap = parent_width - int(child.getRight())
                background = child.getBackground()
            except Exception:
                continue

            # The redesigned 12.9 header is a container, not an icon/title
            # child. This geometry filter intentionally ignores small controls.
            if (
                width >= int(parent_width * 0.72)
                and min_height <= height <= max_height
                and (left >= side_gap or right_gap >= side_gap)
                and background is not None
            ):
                return child

        return None

    def find_m3_chat_header(self, fragment: Any, root: Any = None):
        if fragment is None:
            return None

        action_bar = self.field(fragment, "actionBar")
        strong_hint = (
            self._object_has_m3_header_hint(fragment)
            or self._object_has_m3_header_hint(action_bar)
        )

        # Cover likely private names without depending on any single 12.9.0
        # implementation detail.
        candidate_names = (
            "m3ChatHeader",
            "m3ChatHeaderView",
            "m3Header",
            "m3HeaderView",
            "md3Header",
            "md3HeaderView",
            "material3Header",
            "material3HeaderView",
            "materialHeader",
            "materialHeaderView",
            "chatHeader",
            "chatHeaderView",
            "chatHeaderContainer",
            "headerContainer",
            "toolbarContainer",
        )

        for owner in (fragment, action_bar):
            if owner is None:
                continue
            for name in candidate_names:
                candidate = self.field(owner, name)
                if candidate is None or not hasattr(candidate, "invalidate"):
                    continue

                explicit_name = str(name).lower()
                explicit_m3 = any(
                    token in explicit_name for token in ("m3", "md3", "material")
                )
                if explicit_m3 or strong_hint or self._is_m3_chat_header_view(candidate):
                    return {
                        "view": candidate,
                        "action_bar": action_bar,
                        "safe_glass": True,
                    }

        # Search visible descendants by their actual runtime class.
        for base in (action_bar, root):
            if base is None or not hasattr(base, "getChildCount"):
                continue
            queue = [(base, 0)]
            seen = set()
            while queue:
                current, depth = queue.pop(0)
                key = _identity(current)
                if key in seen:
                    continue
                seen.add(key)

                if current is not base and self._is_m3_chat_header_view(current):
                    return {
                        "view": current,
                        "action_bar": action_bar,
                        "safe_glass": True,
                    }

                if depth >= 3 or not hasattr(current, "getChildCount"):
                    continue
                try:
                    child_count = int(current.getChildCount())
                except Exception:
                    child_count = 0
                for index in range(child_count):
                    try:
                        child = current.getChildAt(index)
                    except Exception:
                        child = None
                    if child is not None:
                        queue.append((child, depth + 1))

        # Geometry fallback catches a floating Material container even if the
        # fork kept a generic class name.
        floating = self._floating_m3_header_candidate(action_bar)
        if floating is not None and (strong_hint or self._object_has_m3_header_hint(floating)):
            return {
                "view": floating,
                "action_bar": action_bar,
                "safe_glass": True,
            }

        # If the build exposes only an M3 flag but draws the redesign directly
        # inside ActionBar, preserve it natively. Do not replace the entire
        # ActionBar background just to force glass.
        if strong_hint and action_bar is not None:
            return {
                "view": action_bar,
                "action_bar": action_bar,
                "safe_glass": False,
            }

        return None

    def _is_m3_navigation_view(self, view: Any) -> bool:
        if view is None:
            return False

        current = view
        # Check the view itself and a few ancestors. Material navigation item
        # views are usually children of NavigationBarView / BottomNavigationView.
        for _ in range(7):
            if current is None:
                break

            class_name = ""
            try:
                class_name = str(current.getClass().getName())
            except Exception:
                class_name = str(type(current))

            normalized = class_name.lower()
            is_material_namespace = (
                "com.google.android.material" in normalized
                or "material3" in normalized
                or ".m3" in normalized
                or "m3navigation" in normalized
            )
            is_nav_component = any(
                token in normalized
                for token in (
                    "navigationbar",
                    "bottomnavigation",
                    "navigationrail",
                    "navigationmenuview",
                    "navigationbaritem",
                    "bottomnavigationitem",
                )
            )

            if is_material_namespace and is_nav_component:
                return True

            # exteraGram/fork implementations may wrap the Material component
            # in their own class while keeping an explicit M3/navigation name.
            if (
                ("m3" in normalized or "material" in normalized)
                and is_nav_component
            ):
                return True

            try:
                parent = current.getParent()
                current = parent if parent is not current else None
            except Exception:
                break

        return False

    def _should_skip_liquid_override(self, view: Any) -> bool:
        # PERFORMANCE HOT PATH:
        # BlurredBackgroundDrawableViewFactory.create() can run repeatedly while
        # lists are being built/scrolled. Never walk Java parents from here.
        if view is None:
            return False

        key = _identity(view)
        if key in self._m3_header_view_ids or key in self._m3_navigation_view_ids:
            return True

        class_name = self._glassify_class_name(view).lower()
        cached = self._m3_fast_class_skip_cache.get(class_name)
        if cached is not None:
            return bool(cached)

        is_nav_component = any(
            token in class_name
            for token in (
                "navigationbar",
                "bottomnavigation",
                "navigationrail",
                "navigationmenuview",
                "navigationbaritem",
                "bottomnavigationitem",
            )
        )
        is_material = (
            "com.google.android.material" in class_name
            or "material3" in class_name
            or ".m3" in class_name
            or "m3navigation" in class_name
            or "md3" in class_name
        )
        is_header = (
            any(token in class_name for token in ("material3", "md3", "m3"))
            and any(
                token in class_name
                for token in ("header", "actionbar", "toolbar", "chat", "title")
            )
        )
        result = bool((is_nav_component and is_material) or is_header)
        self._m3_fast_class_skip_cache[class_name] = result
        if len(self._m3_fast_class_skip_cache) > 96:
            self._m3_fast_class_skip_cache = {class_name: result}
        return result

    def begin_chat_create(self):
        self._chat_create_depth += 1

    def end_chat_create(self):
        if self._chat_create_depth > 0:
            self._chat_create_depth -= 1
        if self._chat_create_depth == 0 and self._deferred_liquid_drawables:
            # Allow transition-end M3 discovery to finish first, then process
            # ordinary glass surfaces away from the critical opening frames.
            self.schedule_deferred_liquid_flush(720)

    def track_liquid_drawable(self, drawable: Any, view: Any = None):
        if drawable is None:
            return

        # Chat createView is the hottest transition. Do not perform even the
        # fast Java-class check here; queue raw references and classify later.
        if self._chat_create_depth > 0:
            key = _identity(drawable)
            entry = self._deferred_liquid_drawables.get(key)
            if entry is None:
                self._deferred_liquid_drawables[key] = {
                    "drawable": drawable,
                    "view": view,
                }
            elif view is not None:
                entry["view"] = view

            while len(self._deferred_liquid_drawables) > GLASSIFY_MAX_RUNTIME_REFS:
                self._deferred_liquid_drawables.pop(
                    next(iter(self._deferred_liquid_drawables)),
                    None,
                )
            return

        # One classification per drawable. remember_liquid_drawable receives a
        # flag so the duplicate M3 check is not repeated.
        if self._should_skip_liquid_override(view):
            return
        self.remember_liquid_drawable(drawable, view, skip_checked=True)

    def schedule_deferred_liquid_flush(self, delay: int = 0):
        if self._deferred_liquid_flush_scheduled:
            return
        self._deferred_liquid_flush_scheduled = True
        self.schedule(self.flush_deferred_liquid_drawables, delay)

    def flush_deferred_liquid_drawables(self):
        self._deferred_liquid_flush_scheduled = False
        if self._chat_create_depth > 0:
            self.schedule_deferred_liquid_flush(160)
            return

        # Process deferred entries in small batches so work is not placed on
        # almost every frame after opening a chat. Use shorter batches every
        # ~2 frames so scrolling can win the UI thread between slices.
        pending_count = len(self._deferred_liquid_drawables)
        batch_size = 2 if pending_count <= 18 else 3
        batch_keys = list(self._deferred_liquid_drawables.keys())[:batch_size]
        for key in batch_keys:
            entry = self._deferred_liquid_drawables.pop(key, None)
            if not entry:
                continue
            self.remember_liquid_drawable(
                entry.get("drawable"),
                entry.get("view"),
            )

        if self._deferred_liquid_drawables:
            self.schedule_deferred_liquid_flush(38)

    def _material_signature(self, strength: Optional[int] = None):
        value = self.current_strength() if strength is None else int(strength)
        value = max(1, min(100, value))
        revision = int(self._material_revision)
        cached = self._material_signature_cache.get(value)
        if cached is not None and cached[1] == revision:
            return cached
        signature = (value, revision)
        self._material_signature_cache[value] = signature
        return signature

    def remember_liquid_drawable(
        self,
        drawable: Any,
        view: Any = None,
        skip_checked: bool = False,
    ):
        if drawable is None:
            return
        if not skip_checked and self._should_skip_liquid_override(view):
            return

        key = _identity(drawable)
        entry = self._liquid_drawables.get(key)
        if entry is None:
            # Current Telegram keeps intensity/thickness/strokes in boundProps.
            # Read that structure directly instead of probing multiple missing
            # Java getters and throwing compatibility exceptions per drawable.
            props = self.field(drawable, "boundProps")
            original_intensity = self.field(props, "liquidIntensity")
            original_thickness = self.field(props, "liquidThickness")
            original_stroke_inner = self.field(props, "strokeWidthTop")
            original_stroke_outer = self.field(props, "strokeWidthBottom")
            original_shadow_alpha = self.field(drawable, "shadowAlpha")

            entry = {
                "drawable": drawable,
                "view": view,
                "original_intensity": original_intensity,
                "original_thickness": original_thickness,
                "original_stroke_inner": (
                    float(original_stroke_inner)
                    if original_stroke_inner is not None
                    else 0.0
                ),
                "original_stroke_outer": (
                    float(original_stroke_outer)
                    if original_stroke_outer is not None
                    else 0.0
                ),
                "original_shadow_alpha": (
                    float(original_shadow_alpha)
                    if original_shadow_alpha is not None
                    else 0.0
                ),
                "last_material_signature": None,
            }
            self._liquid_drawables[key] = entry
        elif view is not None:
            entry["view"] = view

        while len(self._liquid_drawables) > GLASSIFY_MAX_RUNTIME_REFS:
            oldest = next(iter(self._liquid_drawables))
            old_entry = self._liquid_drawables.pop(oldest, None)
            if old_entry is not None:
                self._restore_liquid_entry(old_entry)

        strength = self.current_strength()
        signature = self._material_signature(strength)
        if entry.get("last_material_signature") == signature:
            return

        if self.apply_to_drawable(drawable, view, strength):
            entry["last_material_signature"] = signature


    def apply_to_drawable(
        self,
        drawable: Any,
        view: Any,
        strength: int,
    ) -> bool:
        intensity, thickness = self.liquid_values(strength)

        try:
            drawable.setIntensity(float(intensity))
            drawable.setThickness(int(thickness))
        except Exception:
            return False

        profile = self._active_material_profile()
        if profile is not None:
            try:
                drawable.setStrokeWidth(
                    float(self.dp(profile["stroke_inner_dp"])),
                    float(self.dp(profile["stroke_outer_dp"])),
                )
                drawable.setShadowAlpha(float(profile["shadow_alpha"]))
            except Exception as exc:
                self._log_suppressed("apply extension material", exc)

        try:
            if view is not None:
                # Intensity/thickness/stroke are drawing properties. A layout
                # pass is unnecessary and is especially expensive while a chat
                # is constructing its view hierarchy.
                view.invalidate()
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)
        return True

    def apply_strength(self, strength: Optional[int] = None):
        value = self.current_strength() if strength is None else int(strength)
        value = max(1, min(100, value))

        stale = []
        self._maybe_prune_runtime_refs()
        signature = self._material_signature(value)
        for key, entry in list(self._liquid_drawables.items()):
            drawable = entry.get("drawable")
            view = entry.get("view")
            if self._should_skip_liquid_override(view):
                continue
            if entry.get("last_material_signature") == signature:
                continue
            if not self.apply_to_drawable(drawable, view, value):
                stale.append(key)
            else:
                entry["last_material_signature"] = signature
        for key in stale:
            self._liquid_drawables.pop(key, None)

        self.update_top_overlays(value)
        self.update_keyboard_panels(value)

        for api in list(self._extension_apis.values()):
            api._notify_strength(value)

    def _restore_liquid_entry(self, entry: Dict[str, Any]):
        drawable = entry.get("drawable")
        view = entry.get("view")
        if drawable is None:
            return
        try:
            original_intensity = entry.get("original_intensity")
            original_thickness = entry.get("original_thickness")
            if original_intensity is not None:
                drawable.setIntensity(float(original_intensity))
            if original_thickness is not None:
                drawable.setThickness(int(original_thickness))
            try:
                drawable.updateColors()
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)
            if view is not None:
                view.invalidate()
        except Exception as exc:
            self._log_suppressed("restore Liquid drawable", exc)

    def restore_drawables(self):
        for entry in list(self._liquid_drawables.values()):
            self._restore_liquid_entry(entry)
        self._liquid_drawables.clear()

    def decorate_dialogs_stories(self, fragment: Any, root: Any):
        """
        Soft native blur for the Chats tab stories area.

        Two frosted blur layers are used:
        - a shorter, stronger layer under the stories panel;
        - a longer, weaker tail fading over the first chat rows.

        The pure blur factory is preferred over the liquid-lens factory here,
        preventing colored refraction strips at system gesture edges.
        """
        if fragment is not None:
            self._last_dialogs_fragment = fragment
        if not self._native_available or fragment is None:
            return
        if not self._stories_blur_enabled():
            return

        fragment_key = _identity(fragment)
        existing = self._top_overlays.get(fragment_key)
        if existing is not None:
            self.refresh_dialogs_stories(fragment)
            return

        content_view = self.field(fragment, "contentView") or root
        if content_view is None or not hasattr(content_view, "addView"):
            self.log("Glassify: DialogsActivity contentView was not found")
            return

        # Pure frosted blur first: no liquid edge lens, therefore no colored
        # side strip near Android's back-gesture zone.
        factory = (
            self.field(fragment, "iBlur3FactoryBlur")
            or self.field(fragment, "iBlur3FactoryFrostedLiquidGlass")
            or self.field(fragment, "iBlur3FactoryLiquidGlass")
        )
        if factory is None:
            self.log("Glassify: DialogsActivity blur3 factory was not found")
            return

        try:
            from org.telegram.ui.Components.blur3 import (
                BlurredBackgroundWithFadeDrawable,
            )

            context = content_view.getContext()
            self.allow_top_overflow(content_view)

            layers = []
            for role in ("tail", "core"):
                fade_view = View(context)
                fade_view.setClickable(False)
                fade_view.setFocusable(False)
                try:
                    fade_view.setImportantForAccessibility(
                        View.IMPORTANT_FOR_ACCESSIBILITY_NO
                    )
                except Exception as _suppressed_exc:
                    _note_suppressed(_suppressed_exc)

                base = factory.create(fade_view)
                try:
                    base.setRadius(0.0)
                    base.setPadding(0)
                    base.setClipToOutline(False)
                    base.setStrokeWidth(0.0, 0.0)
                    base.setShadowAlpha(0.0)
                except Exception as _suppressed_exc:
                    _note_suppressed(_suppressed_exc)

                fade = BlurredBackgroundWithFadeDrawable(base)
                fade.setIgnoreFastWay(False)
                fade_view.setBackground(fade)

                params = FrameLayout.LayoutParams(
                    ViewGroup.LayoutParams.MATCH_PARENT,
                    self.dp(220),
                    Gravity.TOP,
                )
                params.topMargin = 0

                # Draw slightly wider than the physical screen so bitmap/lens
                # sampling edges remain outside the visible gesture area.
                overscan = self.dialogs_horizontal_overscan(content_view)
                params.leftMargin = -overscan
                params.rightMargin = -overscan

                content_view.addView(fade_view, params)
                layers.append(
                    {
                        "role": role,
                        "view": fade_view,
                        "fade": fade,
                        "base": base,
                    }
                )

            legacy_fade = self.field(fragment, "topBubblesFadeView")
            legacy_fade_alpha = None
            if legacy_fade is not None:
                try:
                    legacy_fade_alpha = float(legacy_fade.getAlpha())
                except Exception as _suppressed_exc:
                    _note_suppressed(_suppressed_exc)
                try:
                    legacy_fade.setAlpha(0.0)
                except Exception as _suppressed_exc:
                    _note_suppressed(_suppressed_exc)

            data = {
                "view": layers[0]["view"],
                "fade": layers[0]["fade"],
                "base": layers[0]["base"],
                "layers": layers,
                "parent": content_view,
                "kind": "dialogs_stories",
                "action_bar": self.field(fragment, "actionBar"),
                "fragment": fragment,
                "screen_offset": 0.0,
                "visible": True,
                "legacy_fade": legacy_fade,
                "legacy_fade_alpha": legacy_fade_alpha,
            }
            self._top_overlays[fragment_key] = data

            self.raise_dialogs_stories_controls(fragment)
            self.update_one_top_overlay(data, self.current_strength())
            self.collect_fragment_drawables(fragment)

            for delay in (16, 96, 240):
                self.schedule(
                    lambda data=data: self.align_overlay_to_screen_top(data),
                    delay,
                )

            self.log("Glassify: soft stories-panel blur added")
        except Exception as exc:
            self.log(f"Glassify: soft stories-panel blur failed: {exc}")

    def dialogs_search_active(self, fragment: Any) -> bool:
        if fragment is None:
            return False

        state = self.field(fragment, "searchIsShowed")
        if state is not None:
            try:
                if bool(state):
                    return True
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

        pager = self.field(fragment, "searchViewPager")
        if pager is not None:
            try:
                if (
                    int(pager.getVisibility()) == int(View.VISIBLE)
                    and float(pager.getAlpha()) > 0.02
                ):
                    return True
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

        action_bar = self.field(fragment, "actionBar")
        if action_bar is not None:
            try:
                if bool(action_bar.isSearchFieldVisible()):
                    return True
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)
        return False

    def dialogs_stories_available(self, fragment: Any) -> bool:
        if fragment is None:
            return False

        cell = self.field(fragment, "dialogStoriesCell")
        if cell is None:
            return False

        has_stories = self.field(fragment, "hasStories")
        has_self_stories = self.field(fragment, "hasOnlySlefStories")

        if has_stories is not None or has_self_stories is not None:
            try:
                if not bool(has_stories) and not bool(has_self_stories):
                    return False
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

        try:
            if int(cell.getVisibility()) != int(View.VISIBLE):
                return False
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)

        try:
            if float(cell.getAlpha()) <= 0.01:
                return False
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)

        return True

    def set_dialogs_overlay_visible(
        self,
        fragment: Any,
        visible: bool,
    ):
        if fragment is None:
            return

        data = self._top_overlays.get(_identity(fragment))
        if data is None:
            return

        data["visible"] = bool(visible)
        visibility = View.VISIBLE if visible else View.GONE

        for layer in data.get("layers", ()):
            view = layer.get("view")
            if view is None:
                continue
            try:
                view.setVisibility(visibility)
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

    def refresh_dialogs_stories(self, fragment: Any):
        if fragment is None:
            return
        self._last_dialogs_fragment = fragment
        if not self._stories_blur_enabled():
            data = self._top_overlays.get(_identity(fragment))
            if isinstance(data, dict) and data.get("kind") == "dialogs_stories":
                self._remove_top_overlay_data(data)
                self._top_overlays.pop(_identity(fragment), None)
            return

        fragment_key = _identity(fragment)
        data = self._top_overlays.get(fragment_key)
        if data is None:
            root = self.field(fragment, "fragmentView")
            self.decorate_dialogs_stories(fragment, root)
            return

        legacy_fade = self.field(fragment, "topBubblesFadeView")
        if legacy_fade is not None:
            try:
                legacy_fade.setAlpha(0.0)
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

        should_show = not self.dialogs_search_active(
            fragment
        ) and self.dialogs_stories_available(fragment)
        self.set_dialogs_overlay_visible(fragment, should_show)

        if not should_show:
            return

        self.raise_dialogs_stories_controls(fragment)
        self.update_one_top_overlay(data, self.current_strength())
        self.schedule_coalesced(
            ("stories_align", fragment_key),
            lambda data=data: self.align_overlay_to_screen_top(data),
            16,
        )

    def dialogs_stories_panel_height(self, fragment: Any) -> int:
        try:
            status = int(AndroidUtilities.statusBarHeight)
        except Exception:
            status = self.dp(24)

        stories_height = self.dp(81)
        stories_cell = self.field(fragment, "dialogStoriesCell")
        if stories_cell is not None:
            try:
                measured = int(stories_cell.getMeasuredHeight())
                if measured > 0:
                    stories_height = measured
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

        return int(status + stories_height)

    def dialogs_stories_layer_metrics(
        self,
        fragment: Any,
        strength: int,
    ) -> Dict[str, int]:
        value = max(1, min(100, int(strength)))
        progress = value / 100.0
        panel = self.dialogs_stories_panel_height(fragment)

        # The core ends shortly below the stories. The tail is deliberately
        # longer and weaker, producing a smooth transition over the first chats.
        core_height = panel + self.dp(34.0 + 30.0 * progress)
        tail_height = panel + self.dp(104.0 + 86.0 * progress)

        alpha_scale = 1.0
        profile = self._active_material_profile()
        if profile is not None:
            alpha_scale = profile["overlay_alpha_scale"]
        core_alpha = int((58 + 112 * progress) * alpha_scale)
        tail_alpha = int((18 + 64 * progress) * alpha_scale)

        return {
            "core_height": max(1, core_height),
            "tail_height": max(1, tail_height),
            "core_alpha": max(1, min(220, core_alpha)),
            "tail_alpha": max(1, min(120, tail_alpha)),
        }

    def dialogs_horizontal_overscan(self, view: Any) -> int:
        overscan = self.dp(14)

        try:
            insets = view.getRootWindowInsets()
            if insets is not None:
                gestures = insets.getSystemGestureInsets()
                gesture_edge = max(
                    int(gestures.left),
                    int(gestures.right),
                )
                overscan = max(
                    overscan,
                    min(self.dp(36), gesture_edge),
                )
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)

        return overscan

    def raise_dialogs_stories_controls(self, fragment: Any):
        controls = (
            self.field(fragment, "dialogStoriesCell"),
            self.field(fragment, "actionBar"),
            self.field(fragment, "fragmentSearchField"),
            self.field(fragment, "filterTabsView"),
            self.field(fragment, "searchTabsAndFiltersLayout"),
            self.field(fragment, "topPanelLayout"),
            self.field(fragment, "fragmentContextViewWrapper"),
            self.field(fragment, "fragmentLocationContextViewWrapper"),
            self.field(fragment, "rightSlidingDialogContainer"),
            self.field(fragment, "floatingButton"),
            self.field(fragment, "floatingButton2"),
            self.field(fragment, "floatingButton3"),
        )

        for control in controls:
            if control is None:
                continue
            try:
                control.bringToFront()
                control.invalidate()
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

    def _remove_top_overlay_for_fragment(self, fragment: Any):
        key = _identity(fragment)
        data = self._top_overlays.pop(key, None)
        if not isinstance(data, dict):
            return

        layers = data.get("layers")
        if layers:
            views = [
                layer.get("view")
                for layer in layers
                if layer.get("view") is not None
            ]
        else:
            view = data.get("view")
            views = [view] if view is not None else []

        self._remove_top_overlay_data(data)

    def _m3_window_background_color(self, fragment: Any) -> int:
        if fragment is not None:
            try:
                return int(fragment.getThemedColor(Theme.key_windowBackgroundWhite))
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

        resources_provider = (
            self.field(fragment, "themeDelegate")
            or self.field(fragment, "resourceProvider")
            if fragment is not None
            else None
        )
        return int(
            _theme_color(
                Theme.key_windowBackgroundWhite,
                resources_provider,
            )
        )

    def _create_m3_header_fade_drawable(self, fragment: Any):
        color = self._m3_window_background_color(fragment)

        # M3 expects a color fade, not Blur3. Keep the first part essentially
        # opaque so title/buttons stay readable, then dissolve smoothly into
        # the chat content without a visible cutoff.
        colors = jarray(jint)(
            [
                int(self._with_alpha(color, 255)),
                int(self._with_alpha(color, 250)),
                int(self._with_alpha(color, 226)),
                int(self._with_alpha(color, 166)),
                int(self._with_alpha(color, 72)),
                int(self._with_alpha(color, 0)),
            ]
        )
        drawable = GradientDrawable(
            GradientDrawable.Orientation.TOP_BOTTOM,
            colors,
        )
        drawable.setShape(GradientDrawable.RECTANGLE)
        return drawable

    def _m3_header_fade_height(self, header: Any) -> int:
        try:
            status = int(AndroidUtilities.statusBarHeight)
        except Exception:
            status = self.dp(24)

        try:
            header_height = int(header.getMeasuredHeight())
        except Exception:
            header_height = 0

        if header_height <= 0:
            header_height = self.dp(56)

        # Enough solid area for the full M3 header, followed by a soft tail.
        return max(
            self.dp(112) + status,
            header_height + status + self.dp(52),
        )

    def _remove_m3_header_fade_view(self, state: Dict[str, Any]):
        fade_view = state.get("fade_view") if isinstance(state, dict) else None
        if fade_view is None:
            return
        try:
            parent = fade_view.getParent()
            if parent is not None:
                parent.removeView(fade_view)
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)
        state["fade_view"] = None
        state["fade_parent"] = None
        state["fade_drawable"] = None

    def _restore_m3_header_state(self, state: Dict[str, Any]):
        if not isinstance(state, dict):
            return

        self._remove_m3_header_fade_view(state)

        header = state.get("view")
        action_bar = state.get("action_bar")

        try:
            if header is not None:
                header.setBackground(state.get("original_background"))
                header.invalidate()
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)

        if action_bar is not None and action_bar is not header:
            try:
                action_bar.setBackground(
                    state.get("original_action_bar_background")
                )
                action_bar.invalidate()
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

        protected_view_ids = state.get("protected_view_ids")
        if isinstance(protected_view_ids, (set, list, tuple)):
            for protected_key in protected_view_ids:
                self._m3_header_view_ids.discard(protected_key)
        else:
            if header is not None:
                self._m3_header_view_ids.discard(_identity(header))
            if action_bar is not None:
                self._m3_header_view_ids.discard(_identity(action_bar))

    def _apply_m3_chat_header_fade(self, state: Dict[str, Any]):
        if not isinstance(state, dict):
            return

        fragment = state.get("fragment")
        header = state.get("view")
        action_bar = state.get("action_bar")
        if fragment is None or header is None:
            return

        root = self.field(fragment, "fragmentView")
        content_view = self.field(fragment, "contentView") or root
        parent = self.resolve_top_overlay_parent(
            action_bar,
            content_view,
            root,
        )
        if parent is None or not hasattr(parent, "addView"):
            return

        # The M3 background itself must be gone. This also removes any native
        # Blur3 drawable which had been installed as the header background.
        try:
            if header.getBackground() is not None:
                header.setBackground(None)
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)

        if action_bar is not None and action_bar is not header:
            try:
                if action_bar.getBackground() is not None:
                    action_bar.setBackground(None)
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

        fade_view = state.get("fade_view")
        if fade_view is None or state.get("fade_parent") is not parent:
            self._remove_m3_header_fade_view(state)

            try:
                context = parent.getContext()
                fade_view = View(context)
                fade_view.setClickable(False)
                fade_view.setFocusable(False)
                try:
                    fade_view.setImportantForAccessibility(
                        View.IMPORTANT_FOR_ACCESSIBILITY_NO
                    )
                except Exception as _suppressed_exc:
                    _note_suppressed(_suppressed_exc)

                fade_view.setBackground(
                    self._create_m3_header_fade_drawable(fragment)
                )

                params = FrameLayout.LayoutParams(
                    ViewGroup.LayoutParams.MATCH_PARENT,
                    self._m3_header_fade_height(header),
                    Gravity.TOP,
                )
                params.topMargin = 0

                self.allow_top_overflow(parent)
                parent.addView(fade_view, params)

                state["fade_view"] = fade_view
                state["fade_parent"] = parent
                state["fade_drawable"] = fade_view.getBackground()
                state["fade_color"] = self._m3_window_background_color(fragment)
            except Exception as exc:
                self._log_suppressed("create M3 windowBackgroundWhite fade", exc)
                return
        else:
            current_color = self._m3_window_background_color(fragment)
            if state.get("fade_color") != current_color:
                try:
                    fade_view.setBackground(
                        self._create_m3_header_fade_drawable(fragment)
                    )
                    state["fade_drawable"] = fade_view.getBackground()
                    state["fade_color"] = current_color
                except Exception as exc:
                    self._log_suppressed("refresh M3 fade colors", exc)

            try:
                params = fade_view.getLayoutParams()
                target_height = self._m3_header_fade_height(header)
                if params is not None and int(params.height) != int(target_height):
                    params.height = int(target_height)
                    fade_view.setLayoutParams(params)
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

        # Z-order is only required on first install. Repeating bringToFront()
        # during color updates can invalidate the parent hierarchy.
        if not bool(state.get("z_order_ready", False)):
            try:
                if action_bar is not None:
                    action_bar.bringToFront()
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)
            try:
                if header is not action_bar:
                    header.bringToFront()
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)
            state["z_order_ready"] = True

        try:
            offset = self.accumulated_window_top(fade_view)
            current_translation = float(fade_view.getTranslationY())
            target_translation = current_translation - float(offset)
            if abs(float(offset)) > 0.5:
                fade_view.setTranslationY(target_translation)
                fade_view.invalidate()
            elif state.get("fade_color") is not None:
                # Header itself does not need an unconditional invalidate here;
                # changing the fade drawable already invalidates fade_view.
                pass
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)

    def decorate_m3_chat_header(
        self,
        fragment: Any,
        root: Any = None,
        detected: Any = None,
    ) -> bool:
        info = detected or self.find_m3_chat_header(fragment, root)
        if not isinstance(info, dict):
            return False

        header = info.get("view")
        action_bar = info.get("action_bar")
        if header is None:
            return False

        fragment_key = _identity(fragment)
        header_key = _identity(header)

        # Mark the complete M3 header path as protected before any drawable
        # hook can see it. Glassify must never apply Blur3 material here.
        self._m3_header_view_ids.add(header_key)
        protected_view_ids = self._mark_protected_m3_subtree(
            header,
            self._m3_header_view_ids,
            3,
            48,
        ) or {header_key}
        if action_bar is not None:
            action_bar_key = _identity(action_bar)
            self._m3_header_view_ids.add(action_bar_key)
            protected_view_ids.add(action_bar_key)

        # M3 uses a Theme.windowBackgroundWhite color fade instead of the
        # standard Glassify Blur3 top overlay.
        self._remove_top_overlay_for_fragment(fragment)

        existing = self._m3_chat_headers.get(fragment_key)
        if (
            isinstance(existing, dict)
            and existing.get("view") is header
        ):
            previous_ids = existing.get("protected_view_ids")
            if isinstance(previous_ids, set):
                previous_ids.update(protected_view_ids)
            else:
                existing["protected_view_ids"] = set(protected_view_ids)
            self._apply_m3_chat_header_fade(existing)
            return True

        if isinstance(existing, dict):
            self._restore_m3_header_state(existing)
            self._m3_chat_headers.pop(fragment_key, None)

        original_background = None
        original_action_bar_background = None

        try:
            original_background = header.getBackground()
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)

        if action_bar is not None and action_bar is not header:
            try:
                original_action_bar_background = action_bar.getBackground()
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

        state = {
            "fragment": fragment,
            "view": header,
            "action_bar": action_bar,
            "original_background": original_background,
            "original_action_bar_background": original_action_bar_background,
            "fade_view": None,
            "fade_parent": None,
            "fade_drawable": None,
            "fade_color": None,
            "z_order_ready": False,
            "protected_view_ids": set(protected_view_ids),
        }
        self._m3_chat_headers[fragment_key] = state

        self._apply_m3_chat_header_fade(state)

        self.log(
            "Glassify: Material 3 chat header uses "
            "windowBackgroundWhite fade (Blur3 disabled)"
        )
        return True

    def restore_m3_chat_headers(self):
        for state in list(self._m3_chat_headers.values()):
            self._restore_m3_header_state(state)

        self._m3_chat_headers.clear()
        self._m3_header_view_ids.clear()

    def decorate_fragment(self, fragment: Any, root: Any, kind: str):
        if not self._native_available or fragment is None:
            return

        if kind == "dialogs":
            self.decorate_dialogs_stories(fragment, root)
            return

        if kind == "chat":
            existing_m3 = self._m3_chat_headers.get(_identity(fragment))
            if isinstance(existing_m3, dict):
                self._apply_m3_chat_header_fade(existing_m3)
                return

            m3_header = self.find_m3_chat_header(fragment, root)
            if m3_header is not None:
                if self.decorate_m3_chat_header(fragment, root, m3_header):
                    return

        fragment_key = _identity(fragment)

        if not self._progressive_blur_enabled():
            existing = self._top_overlays.pop(fragment_key, None)
            if isinstance(existing, dict):
                self._remove_top_overlay_data(existing)

            if kind == "chat":
                self.schedule_coalesced(
                    ("chat_collect_no_progressive", fragment_key),
                    lambda fragment=fragment: self.collect_fragment_drawables(fragment),
                    220,
                )
                self.schedule_coalesced(
                    ("chat_bottom_no_progressive", fragment_key),
                    lambda fragment=fragment: self.decorate_chat_bottom_panels(fragment),
                    240,
                )
            else:
                self.collect_fragment_drawables(fragment)
            return

        existing = self._top_overlays.get(fragment_key)
        if existing is not None:
            self.update_one_top_overlay(existing, self.current_strength())
            if kind == "chat":
                self.schedule(
                    lambda fragment=fragment: self.collect_fragment_drawables(fragment),
                    220,
                )
                self.schedule(
                    lambda fragment=fragment: self.decorate_chat_bottom_panels(fragment),
                    220,
                )
            else:
                self.collect_fragment_drawables(fragment)
            return

        content_view = self.field(fragment, "contentView") or root
        action_bar = self.field(fragment, "actionBar")
        overlay_parent = self.resolve_top_overlay_parent(
            action_bar,
            content_view,
            root,
        )
        if overlay_parent is None:
            return

        try:
            if not hasattr(overlay_parent, "addView"):
                return
            context = overlay_parent.getContext()
        except Exception:
            return

        factory = self.field(
            fragment, "glassBackgroundDrawableFactoryFrosted"
        ) or self.field(fragment, "glassBackgroundDrawableFactory")

        if factory is None:
            self.log(f"Glassify: no native blur3 factory for {kind} top fade")
            return

        try:
            from org.telegram.ui.Components.blur3 import (
                BlurredBackgroundWithFadeDrawable,
            )

            fade_view = View(context)
            fade_view.setClickable(False)
            fade_view.setFocusable(False)
            try:
                fade_view.setImportantForAccessibility(
                    View.IMPORTANT_FOR_ACCESSIBILITY_NO
                )
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

            base = factory.create(fade_view)
            try:
                base.setRadius(0.0)
                base.setPadding(0)
                base.setClipToOutline(False)
                base.setStrokeWidth(0.0, 0.0)
                base.setShadowAlpha(0.0)
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

            fade = BlurredBackgroundWithFadeDrawable(base)
            fade.setIgnoreFastWay(False)
            fade_view.setBackground(fade)

            height = self.top_fade_height(self.current_strength())
            params = FrameLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT,
                height,
                Gravity.TOP,
            )
            params.topMargin = 0

            # Telegram may lay generic children below ActionBar even when their
            # topMargin is zero. The view is therefore aligned again after layout
            # using its accumulated window position.
            self.allow_top_overflow(overlay_parent)
            overlay_parent.addView(fade_view, params)
            self.raise_top_controls(fragment, action_bar)

            data = {
                "view": fade_view,
                "fade": fade,
                "base": base,
                "parent": overlay_parent,
                "kind": kind,
                "action_bar": action_bar,
                "screen_offset": 0.0,
            }
            self._top_overlays[fragment_key] = data
            self.update_one_top_overlay(data, self.current_strength())
            if kind == "chat":
                self.schedule(
                    lambda fragment=fragment: self.collect_fragment_drawables(fragment),
                    260,
                )
                self.schedule(
                    lambda fragment=fragment: self.decorate_chat_bottom_panels(fragment),
                    260,
                )
            else:
                self.collect_fragment_drawables(fragment)

            # First pass catches the initial layout. The second catches Telegram
            # moving the fragment after status-bar/action-bar measurements.
            self.schedule(lambda: self.align_overlay_to_screen_top(data), 24)
            self.schedule(lambda: self.align_overlay_to_screen_top(data), 160)

            self.log(f"Glassify: absolute top progressive blur added ({kind})")
        except Exception as exc:
            self.log(f"Glassify: progressive top blur failed ({kind}): {exc}")

    def resolve_top_overlay_parent(
        self,
        action_bar: Any,
        content_view: Any,
        root: Any,
    ):
        # Prefer the fragment root returned by createView. A fallback parent
        # preferred ActionBar.getParent(), whose custom layout placed unknown
        # children below the title panel.
        for candidate in (
            root,
            self.field(root, "fragmentView") if root is not None else None,
        ):
            if candidate is not None and hasattr(candidate, "addView"):
                return candidate

        if action_bar is not None:
            try:
                parent = action_bar.getParent()
                if parent is not None and hasattr(parent, "addView"):
                    return parent
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

        if content_view is not None:
            if hasattr(content_view, "addView"):
                return content_view
            try:
                parent = content_view.getParent()
                if parent is not None and hasattr(parent, "addView"):
                    return parent
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)
        return None

    def allow_top_overflow(self, parent: Any):
        current = parent
        for _ in range(6):
            if current is None:
                break
            try:
                current.setClipChildren(False)
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)
            try:
                current.setClipToPadding(False)
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)
            try:
                current = current.getParent()
            except Exception:
                break

    def accumulated_window_top(self, view: Any) -> float:
        total = 0.0
        current = view
        visited = set()

        for _ in range(16):
            if current is None:
                break
            key = _identity(current)
            if key in visited:
                break
            visited.add(key)

            try:
                total += float(current.getTop())
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)
            try:
                total += float(current.getTranslationY())
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

            try:
                parent = current.getParent()
            except Exception:
                break
            if parent is None or not hasattr(parent, "getTop"):
                break
            current = parent

        return total

    def align_overlay_to_screen_top(self, data: Dict[str, Any]):
        layers = data.get("layers")
        if layers:
            views = [
                layer.get("view") for layer in layers if layer.get("view") is not None
            ]
        else:
            view = data.get("view")
            views = [view] if view is not None else []

        if not views:
            return

        for view in views:
            try:
                view.setTranslationY(0.0)
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

        offset = self.accumulated_window_top(views[0])
        data["screen_offset"] = float(offset)

        for view in views:
            try:
                view.setTranslationY(-float(offset))
                view.invalidate()
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

        if data.get("kind") == "dialogs_stories":
            self.raise_dialogs_stories_controls(data.get("fragment"))
        else:
            self.raise_top_controls(
                None,
                data.get("action_bar"),
            )

        self.log(
            "Glassify: top blur aligned to screen Y=0 "
            f"(layout offset={int(round(offset))}px)"
        )

    def raise_top_controls(self, fragment: Any, action_bar: Any):
        # The blur overlay must sit over messages, but never cover the title,
        # back/search/menu buttons, pinned message or context panels.
        controls = [
            action_bar,
            self.field(fragment, "fragmentContextViewWrapper")
            if fragment is not None
            else None,
            (
                self.field(fragment, "fragmentLocationContextViewWrapper")
                if fragment is not None
                else None
            ),
            self.field(fragment, "searchTabsAndFiltersLayout")
            if fragment is not None
            else None,
            self.field(fragment, "filterTabsView") if fragment is not None else None,
            self.field(fragment, "topPanelLayout") if fragment is not None else None,
            self.field(fragment, "fragmentSearchField")
            if fragment is not None
            else None,
        ]
        for control in controls:
            if control is None:
                continue
            try:
                control.bringToFront()
                control.invalidate()
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

    def top_fade_height(self, strength: int) -> int:
        value = max(1, min(100, int(strength)))
        progress = value / 100.0
        base = self.dp(84.0 + 60.0 * progress)
        try:
            status = int(AndroidUtilities.statusBarHeight)
        except Exception:
            status = self.dp(24)
        return int(base + status)

    def top_frosted_values(self, strength: int) -> Tuple[float, int]:
        value = max(1, min(100, int(strength)))
        progress = value / 100.0

        # Match the Frosted surface from LiquidGlass+: same Blur3 response,
        # but owned by Core so changing LiquidGlass+ surface never touches it.
        intensity = (0.05 + 1.40 * progress) * self.TOP_FROSTED_INTENSITY_SCALE
        thickness_dp = (4.0 + 14.0 * progress) * self.TOP_FROSTED_THICKNESS_SCALE
        return float(intensity), int(self.dp(thickness_dp))

    def apply_top_frosted_material(self, data: Dict[str, Any], strength: int) -> bool:
        base = data.get("base")
        if base is None:
            return False

        changed = False
        value = max(1, min(100, int(strength)))
        if data.get("_frosted_strength") != value:
            intensity, thickness = self.top_frosted_values(value)
            try:
                base.setIntensity(float(intensity))
                base.setThickness(int(thickness))
                base.setStrokeWidth(0.0, 0.0)
                base.setShadowAlpha(0.0)
                data["_frosted_strength"] = value
                changed = True
            except Exception as exc:
                self._log_suppressed("apply fixed Frosted top blur", exc)

        # Strength changes affect geometry/intensity only. updateColors is much
        # more expensive and is needed only when the live theme tint changes.
        theme_signature = (
            _theme_color(
                getattr(Theme, "key_actionBarDefault", Theme.key_windowBackgroundWhite)
            ),
            _theme_color(Theme.key_windowBackgroundWhite),
        )
        if data.get("_frosted_theme_signature") != theme_signature:
            try:
                base.updateColors()
                data["_frosted_theme_signature"] = theme_signature
                changed = True
            except Exception as exc:
                self._log_suppressed("refresh fixed Frosted top colors", exc)
        return changed

    def top_fade_alpha(self, strength: int) -> int:
        value = max(1, min(100, int(strength)))
        progress = value / 100.0
        # Fixed Frosted tint. Do not consult the active extension material:
        # Clear/Crystal/Satin/Deep must not alter the blur above the chat name.
        alpha = (96 + 159 * progress) * self.TOP_FROSTED_ALPHA_SCALE
        return max(1, min(255, int(alpha)))

    def update_top_overlays(self, strength: int):
        if self._top_overlays and not (
            self._progressive_blur_enabled() and self._stories_blur_enabled()
        ):
            self._remove_disallowed_top_overlays()

        stale = []
        for key, data in list(self._top_overlays.items()):
            try:
                self.update_one_top_overlay(data, strength)
            except Exception:
                stale.append(key)
        for key in stale:
            self._top_overlays.pop(key, None)

    def update_one_top_overlay(self, data: Dict[str, Any], strength: int):
        if data.get("kind") == "dialogs_stories":
            if not bool(data.get("visible", True)):
                return

            fragment = data.get("fragment")
            metrics = self.dialogs_stories_layer_metrics(
                fragment,
                strength,
            )

            for layer in data.get("layers", ()):
                role = layer.get("role")
                view = layer.get("view")
                fade = layer.get("fade")
                if view is None or fade is None:
                    continue

                if role == "core":
                    height = metrics["core_height"]
                    alpha = metrics["core_alpha"]
                else:
                    height = metrics["tail_height"]
                    alpha = metrics["tail_alpha"]

                # opacity=True gives a softer maximum at the top; the long tail
                # then avoids a visible cutoff on the first chat row.
                fade_signature = (int(height), int(alpha))
                fade_changed = layer.get("_fade_signature") != fade_signature
                if fade_changed:
                    fade.setFadeHeight(-height, True)
                    fade.setAlpha(alpha)
                    layer["_fade_signature"] = fade_signature

                geometry_changed = False
                try:
                    params = view.getLayoutParams()
                    if params is not None:
                        overscan = self.dialogs_horizontal_overscan(data.get("parent"))
                        target_margin = -overscan
                        if (
                            int(params.height) != int(height)
                            or int(params.leftMargin) != int(target_margin)
                            or int(params.rightMargin) != int(target_margin)
                        ):
                            params.height = height
                            params.leftMargin = target_margin
                            params.rightMargin = target_margin
                            view.setLayoutParams(params)
                            geometry_changed = True
                except Exception as _suppressed_exc:
                    _note_suppressed(_suppressed_exc)

                try:
                    if view.getVisibility() != View.VISIBLE:
                        view.setVisibility(View.VISIBLE)
                        fade_changed = True
                    if fade_changed or geometry_changed:
                        view.invalidate()
                    if geometry_changed:
                        view.requestLayout()
                except Exception as _suppressed_exc:
                    _note_suppressed(_suppressed_exc)

                layer["_geometry_changed"] = bool(geometry_changed)

            if any(
                bool(layer.get("_geometry_changed", False))
                for layer in data.get("layers", ())
            ):
                self.schedule(
                    lambda: self.align_overlay_to_screen_top(data),
                    16,
                )
                for layer in data.get("layers", ()):
                    layer["_geometry_changed"] = False
            return

        view = data["view"]
        fade = data["fade"]
        height = self.top_fade_height(strength)

        material_changed = self.apply_top_frosted_material(data, strength)
        fade_alpha = self.top_fade_alpha(strength)
        fade_signature = (int(height), int(fade_alpha))
        fade_changed = data.get("_fade_signature") != fade_signature
        if fade_changed:
            fade.setFadeHeight(-height, False)
            fade.setAlpha(fade_alpha)
            data["_fade_signature"] = fade_signature

        geometry_changed = False
        try:
            params = view.getLayoutParams()
            if params is not None and int(params.height) != height:
                params.height = height
                view.setLayoutParams(params)
                geometry_changed = True
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)

        try:
            if material_changed or fade_changed or geometry_changed:
                view.invalidate()
            if geometry_changed:
                view.requestLayout()
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)

        if geometry_changed:
            self.schedule(lambda: self.align_overlay_to_screen_top(data), 16)

    def _remove_top_overlay_data(self, data: Dict[str, Any]):
        if not isinstance(data, dict):
            return

        layers = data.get("layers")
        if layers:
            views = [
                layer.get("view")
                for layer in layers
                if layer.get("view") is not None
            ]
        else:
            view = data.get("view")
            views = [view] if view is not None else []

        for view in views:
            try:
                parent = view.getParent()
                if parent is not None:
                    parent.removeView(view)
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

        # DialogsActivity has its own stock stories fade. Glassify hides it
        # only while its pseudo-progressive Blur3 replacement is active.
        legacy_fade = data.get("legacy_fade")
        original_alpha = data.get("legacy_fade_alpha")
        if legacy_fade is not None and original_alpha is not None:
            try:
                legacy_fade.setAlpha(float(original_alpha))
                legacy_fade.invalidate()
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

    def remove_top_overlays(self):
        for data in list(self._top_overlays.values()):
            self._remove_top_overlay_data(data)
        self._top_overlays.clear()

    def collect_fragment_drawables(self, fragment: Any):
        action_bar = self.field(fragment, "actionBar")
        m3_state = self._m3_chat_headers.get(_identity(fragment))
        m3_action_bar = (
            m3_state.get("action_bar")
            if isinstance(m3_state, dict)
            else None
        )

        if action_bar is not None and action_bar is not m3_action_bar:
            for name in (
                "glassDrawable",
                "glassDrawableBack",
                "glassDrawableMenu",
            ):
                drawable = self.field(action_bar, name)
                if drawable is not None:
                    self.remember_liquid_drawable(drawable, action_bar)

        input_container = self.field(fragment, "chatInputViewsContainer")
        if input_container is not None:
            for name in (
                "blurredBackgroundDrawable",
                "inputIslandBubbleDrawable",
                "underKeyboardBackgroundDrawable",
            ):
                drawable = self.field(input_container, name)
                if drawable is not None:
                    self.remember_liquid_drawable(
                        drawable,
                        input_container,
                    )

    @staticmethod
    def _with_alpha(color: int, alpha: int) -> int:
        return ((int(alpha) & 0xFF) << 24) | (int(color) & 0x00FFFFFF)

    def _main_tabs_inset_color(self, activity: Any) -> int:
        if activity is None:
            return int(_theme_color(Theme.key_windowBackgroundWhite))

        # Prefer MainTabsActivity's own themed color so the shield follows the
        # active Telegram theme instead of hardcoding light/dark values.
        try:
            return int(activity.getThemedColor(Theme.key_windowBackgroundWhite))
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)

        resources_provider = self.field(activity, "resourceProvider")
        return int(_theme_color(Theme.key_windowBackgroundWhite, resources_provider))

    def _main_tabs_inset_height(self, activity: Any, content_view: Any) -> int:
        height = self.field(activity, "navigationBarHeight")
        try:
            height = int(height or 0)
        except Exception:
            height = 0

        if height > 0:
            return height

        # Compatibility fallback if refresh happens before MainTabsActivity has
        # copied the current WindowInsets into navigationBarHeight.
        try:
            insets = content_view.getRootWindowInsets()
            if insets is not None:
                try:
                    height = int(insets.getStableInsetBottom())
                except Exception:
                    height = int(insets.getSystemWindowInsetBottom())
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)

        return max(0, int(height or 0))

    def refresh_main_tabs_inset_shield(self, activity: Any, root: Any = None):
        if activity is None:
            return

        content_view = self.field(activity, "contentView") or root
        if content_view is None:
            try:
                content_view = activity.getFragmentView()
            except Exception:
                content_view = None
        if content_view is None:
            return

        key = _identity(activity)
        state = self._main_tabs_inset_shields.get(key)
        shield = state.get("view") if isinstance(state, dict) else None

        if shield is None:
            try:
                context = content_view.getContext()
                shield = View(context)
                shield.setClickable(False)
                shield.setFocusable(False)

                params = FrameLayout.LayoutParams(
                    ViewGroup.LayoutParams.MATCH_PARENT,
                    1,
                    Gravity.BOTTOM,
                )
                content_view.addView(shield, params)

                self._main_tabs_inset_shields[key] = {
                    "activity": activity,
                    "parent": content_view,
                    "view": shield,
                    "last_height": None,
                    "last_color": None,
                    "last_visible": None,
                }
                self._maybe_prune_runtime_refs()
            except Exception as exc:
                self._log_suppressed("create main tabs inset shield", exc)
                return

        height = self._main_tabs_inset_height(activity, content_view)
        color = self._main_tabs_inset_color(activity)
        visible = bool(height > 0)
        changed = False

        try:
            if state.get("last_height") != int(height):
                params = shield.getLayoutParams()
                if params is not None and int(params.height) != int(height):
                    params.height = int(height)
                    shield.setLayoutParams(params)
                state["last_height"] = int(height)
                changed = True
        except Exception as exc:
            self._log_suppressed("resize main tabs inset shield", exc)

        try:
            if state.get("last_color") != int(color):
                shield.setBackgroundColor(int(color))
                state["last_color"] = int(color)
                changed = True
            if state.get("last_visible") != visible:
                shield.setVisibility(View.VISIBLE if visible else View.GONE)
                state["last_visible"] = visible
                changed = True

            parent = shield.getParent()
            if parent is not None:
                try:
                    if int(parent.indexOfChild(shield)) != int(parent.getChildCount()) - 1:
                        shield.bringToFront()
                        changed = True
                except Exception as _suppressed_exc:
                    _note_suppressed(_suppressed_exc)

            if changed:
                shield.invalidate()
        except Exception as exc:
            self._log_suppressed("update main tabs inset shield", exc)

        if changed:
            try:
                content_view.invalidate()
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

    def restore_main_tabs_inset_shields(self):
        for state in list(self._main_tabs_inset_shields.values()):
            if not isinstance(state, dict):
                continue
            parent = state.get("parent")
            shield = state.get("view")
            if parent is None or shield is None:
                continue
            try:
                parent.removeView(shield)
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)
        self._main_tabs_inset_shields.clear()

    def decorate_main_tabs(self, activity: Any, root: Any = None):
        if not self._native_available or activity is None:
            return

        self.refresh_main_tabs_inset_shield(activity, root)

        content_view = self.field(activity, "contentView") or root
        tabs_view = self.field(activity, "tabsView")
        if content_view is None or tabs_view is None:
            return

        panel = self.field(activity, "tabsViewBackground")
        is_m3_navigation = self._is_m3_navigation_view(tabs_view)
        self._m3_navigation_view_ids.clear()
        if is_m3_navigation:
            self._mark_protected_m3_subtree(
                tabs_view,
                self._m3_navigation_view_ids,
                4,
                64,
            )
        elif panel is not None:
            self.remember_liquid_drawable(panel, tabs_view)

        runtime_key = _identity(activity)
        if runtime_key in self._runtime_refs:
            return

        self._runtime_refs[runtime_key] = {
            "content": content_view,
            "tabs_view": tabs_view,
        }
        self._maybe_prune_runtime_refs()
        self.log("Glassify: main tabs kept stock")

    def _log_suppressed(self, context: str, exc: Any):
        key = str(context)
        count = int(self._suppressed_errors.get(key, 0)) + 1
        self._suppressed_errors[key] = count
        if count <= 3 or count in (8, 32, 128):
            self.log(f"Glassify: {key} failed ({count}): {exc}")

    def _runtime_view(self, data: Any):
        if not isinstance(data, dict):
            return None
        for key in (
            "view",
            "layout",
            "surface",
            "container",
            "tabs_view",
        ):
            value = data.get(key)
            if value is not None:
                return value
        return None

    def _view_is_detached(self, view: Any) -> bool:
        if view is None:
            return True
        attached = None
        parent = None
        try:
            attached = bool(view.isAttachedToWindow())
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)
        try:
            parent = view.getParent()
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)
        return attached is False and parent is None

    def _trim_runtime_mapping(self, mapping: Dict[int, Any]):
        if len(mapping) <= GLASSIFY_MAX_RUNTIME_REFS:
            return
        for key, data in list(mapping.items()):
            if len(mapping) <= GLASSIFY_MAX_RUNTIME_REFS:
                break
            view = self._runtime_view(data)
            if self._view_is_detached(view):
                mapping.pop(key, None)
        while len(mapping) > GLASSIFY_MAX_RUNTIME_REFS:
            mapping.pop(next(iter(mapping)), None)

    def _runtime_cache_pressure(self) -> bool:
        threshold = int(GLASSIFY_MAX_RUNTIME_REFS * 0.75)
        mappings = (
            self._top_overlays,
            self._runtime_refs,
            self._keyboard_runtime,
            self._main_tabs_inset_shields,
        )
        if any(len(mapping) >= threshold for mapping in mappings):
            return True
        return bool(
            len(self._field_reflection_cache) > 160
            or len(self._missing_field_cache) > 224
            or len(self._m3_hint_fields_cache) > 56
            or len(self._m3_fast_class_skip_cache) > 84
        )

    def _maybe_prune_runtime_refs(self, force: bool = False):
        now = time.monotonic()
        pressure = self._runtime_cache_pressure()
        interval = 0.75 if pressure else 4.0
        if not force and now - self._last_runtime_prune_at < interval:
            return
        self._last_runtime_prune_at = now
        self._prune_runtime_refs()

    def _prune_runtime_refs(self):
        for mapping in (
            self._top_overlays,
            self._runtime_refs,
            self._keyboard_runtime,
            self._main_tabs_inset_shields,
        ):
            self._trim_runtime_mapping(mapping)
        for key, state in list(self._m3_chat_headers.items()):
            view = state.get("view") if isinstance(state, dict) else None
            if self._view_is_detached(view):
                stale_state = self._m3_chat_headers.pop(key, None)
                if isinstance(stale_state, dict):
                    self._remove_m3_header_fade_view(stale_state)
                    protected = stale_state.get("protected_view_ids")
                    if isinstance(protected, (set, list, tuple)):
                        for protected_key in protected:
                            self._m3_header_view_ids.discard(protected_key)
                    elif view is not None:
                        self._m3_header_view_ids.discard(_identity(view))
                elif view is not None:
                    self._m3_header_view_ids.discard(_identity(view))

        if len(self._field_reflection_cache) > 192:
            self._field_reflection_cache.clear()
        if len(self._missing_field_cache) > 256:
            self._missing_field_cache.clear()
        if len(self._m3_hint_fields_cache) > 64:
            self._m3_hint_fields_cache.clear()
        if len(self._m3_fast_class_skip_cache) > 96:
            self._m3_fast_class_skip_cache.clear()

    def schedule(self, callback, delay: int = 0):
        generation = self._scheduled_generation

        def guarded():
            if not self._plugin_alive or generation != self._scheduled_generation:
                return
            try:
                self._maybe_prune_runtime_refs()
                callback()
            except Exception as exc:
                self.log(f"Glassify: guarded UI error: {exc}")

        if not self._plugin_alive:
            return
        try:
            run_on_ui_thread(guarded, delay)
        except Exception as exc:
            self.log(f"Glassify: UI scheduling failed: {exc}")

    def schedule_coalesced(self, key: Any, callback, delay: int = 0):
        self._coalesced_sequence += 1
        token = int(self._coalesced_sequence)
        self._coalesced_tokens[key] = token
        if len(self._coalesced_tokens) > 128:
            self._coalesced_tokens = {key: token}

        def run_if_latest():
            if self._coalesced_tokens.get(key) != token:
                return
            self._coalesced_tokens.pop(key, None)
            callback()

        self.schedule(run_if_latest, delay)

    def field(self, obj: Any, name: str):
        if obj is None:
            return None

        field_name = str(name)
        cache_key = None
        try:
            clazz = obj.getClass()
            class_name = str(clazz.getName())
            cache_key = (class_name, field_name)

            if cache_key in self._missing_field_cache:
                return None

            reflected = self._field_reflection_cache.get(cache_key)
            if reflected is None:
                current = clazz
                while current is not None:
                    try:
                        reflected = current.getDeclaredField(field_name)
                        reflected.setAccessible(True)
                        self._field_reflection_cache[cache_key] = reflected
                        break
                    except Exception:
                        try:
                            current = current.getSuperclass()
                        except Exception:
                            current = None

            if reflected is not None:
                try:
                    return reflected.get(obj)
                except Exception:
                    self._field_reflection_cache.pop(cache_key, None)
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)

        try:
            return get_private_field(obj, field_name)
        except Exception:
            # A missing candidate field is a property of the Java class,
            # not the individual ChatActivity instance. Cache the miss so M3
            # compatibility probing does not throw the same reflection failure
            # on every chat opening.
            if cache_key is not None:
                self._missing_field_cache.add(cache_key)
            return None

    def array_length(self, array: Any) -> int:
        try:
            return len(array)
        except Exception:
            try:
                return int(array.length)
            except Exception:
                return 0

    def dp(self, value: float) -> int:
        numeric = float(value)
        cached = self._dp_cache.get(numeric)
        if cached is not None:
            return int(cached)
        try:
            result = int(AndroidUtilities.dp(numeric))
        except Exception:
            result = int(round(numeric))
        self._dp_cache[numeric] = result
        if len(self._dp_cache) > 128:
            self._dp_cache.clear()
            self._dp_cache[numeric] = result
        return result
