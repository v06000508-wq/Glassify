def _decode_github_base64(encoded: str, limit: int, label: str) -> bytes:
    """Decode a GitHub Contents payload without accepting oversized input."""
    compact = "".join(encoded.split())
    if not compact:
        raise ValueError(f"{label} is empty")

    max_encoded = 4 * ((int(limit) + 2) // 3)
    if len(compact) > max_encoded:
        raise ValueError(f"{label} is too large")

    try:
        data = base64.b64decode(compact, validate=True)
    except (binascii.Error, ValueError) as exc:
        raise ValueError(f"{label} has invalid base64") from exc
    if not data or len(data) > limit:
        raise ValueError(f"{label} has invalid size")
    return data


def _note_suppressed(exc: Any):
    """Keep compatibility fallbacks observable without flooding the log."""
    global _SUPPRESSED_FAILURE_TOTAL
    try:
        frame = sys._getframe(1)
        location = f"{frame.f_code.co_name}:{frame.f_lineno}"
        message = f"{type(exc).__name__}: {exc}"
        key = f"{location}:{message}"
        if key not in _SUPPRESSED_FAILURES and len(_SUPPRESSED_FAILURES) >= 256:
            key = "__overflow__"
            message = "additional compatibility failures"
        count = int(_SUPPRESSED_FAILURES.get(key, 0)) + 1
        _SUPPRESSED_FAILURES[key] = count
        _SUPPRESSED_FAILURE_TOTAL += 1
        plugin = _ACTIVE_PLUGIN
        if plugin is not None and (
            (count == 1 and len(_SUPPRESSED_FAILURES) <= 32) or count in (8, 32, 128)
        ):
            plugin.log(
                f"Glassify: compatibility fallback at {location} ({count}): {message}"
            )
    except Exception:
        return


def _identity(obj: Any) -> int:
    try:
        return int(System.identityHashCode(obj))
    except Exception:
        return id(obj)


def _active_strength() -> int:
    plugin = _ACTIVE_PLUGIN
    if plugin is None:
        return 50
    return plugin.current_strength()


def _theme_color(key: int, resources_provider: Any = None) -> int:
    try:
        return int(Theme.getColor(key, resources_provider))
    except Exception:
        try:
            return int(Theme.getColor(key))
        except Exception:
            return -1  # opaque white as a signed Java int


def _validate_extension_attribute_name(name: Any) -> str:
    value = str(name)
    if value.startswith("_") or "__" in value:
        raise AttributeError("служебные атрибуты недоступны расширениям")
    return value


def _safe_extension_getattr(obj: Any, name: Any, *default):
    value = _validate_extension_attribute_name(name)
    if len(default) > 1:
        raise TypeError("getattr expected at most 3 arguments")
    if default:
        return getattr(obj, value, default[0])
    return getattr(obj, value)


def _safe_extension_hasattr(obj: Any, name: Any) -> bool:
    value = _validate_extension_attribute_name(name)
    return hasattr(obj, value)


def _safe_extension_setattr(obj: Any, name: Any, value: Any):
    safe_name = _validate_extension_attribute_name(name)
    return setattr(obj, safe_name, value)


def _glassify_logo_cache_path() -> str:
    try:
        root = str(ApplicationLoader.applicationContext.getFilesDir().getAbsolutePath())
    except Exception:
        return ""
    folder = os.path.join(root, "glassify_extensions", "assets")
    try:
        os.makedirs(folder, exist_ok=True)
    except Exception:
        return ""
    return os.path.join(folder, GLASSIFY_LOGO_CACHE_NAME)


def _decode_glassify_logo(data: bytes):
    if not data or len(data) > GLASSIFY_MAX_LOGO_BYTES:
        return None
    try:
        return BitmapFactory.decodeByteArray(data, 0, len(data))
    except Exception as exc:
        _note_suppressed(exc)
        return None


def _clear_glassify_logo_background(view: Any):
    if view is None:
        return
    key = _identity(view)

    # Remove only our own overlay drawable. Recycler cells can reuse
    # the same BackupImageView for another plugin, so never clear the whole
    # ViewOverlay and never touch foreign drawables.
    overlay_entry = _GLASSIFY_LOGO_OVERLAYS.pop(key, None)
    drawable = overlay_entry[1] if isinstance(overlay_entry, tuple) else overlay_entry
    if drawable is not None:
        try:
            view.getOverlay().remove(drawable)
        except Exception as exc:
            _note_suppressed(exc)



def _draw_glassify_logo_overlay(view: Any, bitmap: Any) -> bool:
    if view is None or bitmap is None:
        return False
    try:
        key = _identity(view)
        previous_entry = _GLASSIFY_LOGO_OVERLAYS.pop(key, None)
        previous = (
            previous_entry[1]
            if isinstance(previous_entry, tuple)
            else previous_entry
        )
        overlay = view.getOverlay()
        if previous is not None:
            try:
                overlay.remove(previous)
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

        width = int(view.getWidth())
        height = int(view.getHeight())
        if width <= 0 or height <= 0:
            return False

        # Draw into a centered square that is guaranteed to stay completely
        # inside the real icon view. This bypasses Telegram's ImageReceiver,
        # rounded BitmapShader, TGS internal size and drawable intrinsic size.
        side = min(width, height)
        left = (width - side) // 2
        top = (height - side) // 2

        BitmapDrawable = jclass("android.graphics.drawable.BitmapDrawable")
        drawable = BitmapDrawable(view.getResources(), bitmap)
        try:
            drawable.setFilterBitmap(True)
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)
        drawable.setBounds(left, top, left + side, top + side)

        # Remove the original TGS content but keep the BackupImageView itself
        # visible. The overlay is then rendered last, directly in view coords.
        try:
            view.setImageDrawable(None)
        except Exception:
            try:
                view.getImageReceiver().clearImage()
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)
        try:
            view.setSize(-1, -1)
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)

        overlay.add(drawable)
        _GLASSIFY_LOGO_OVERLAYS[key] = (view, drawable)
        view.invalidate()
        return True
    except Exception as exc:
        _note_suppressed(exc)
        return False


def _apply_glassify_logo(view: Any, bitmap: Any) -> bool:
    if view is None or bitmap is None:
        return False

    # Plugin-list icons are BackupImageView instances. Do not send
    # the bitmap through ImageReceiver at all: it is painted in ViewOverlay
    # using the measured icon bounds, so there is nothing left that can crop
    # or tile half of the image.
    try:
        view.getImageReceiver()
        if _draw_glassify_logo_overlay(view, bitmap):
            # The hook may run before RecyclerView completes layout. Re-apply
            # after layout so bounds always match the final measured icon.
            try:
                run_on_ui_thread(
                    lambda view=view, bitmap=bitmap: _draw_glassify_logo_overlay(
                        view, bitmap
                    ),
                    48,
                )
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)
            return True
    except Exception as _suppressed_exc:
        _note_suppressed(_suppressed_exc)

    # The large settings-header logo is a regular Android ImageView.
    try:
        try:
            view.setScaleType(ImageView.ScaleType.FIT_CENTER)
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)
        try:
            view.setAdjustViewBounds(True)
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)
        view.setImageBitmap(bitmap)
        try:
            view.invalidate()
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)
        return True
    except Exception as exc:
        _note_suppressed(exc)
        return False

def _read_cached_glassify_logo():
    path = _glassify_logo_cache_path()
    if not path or not os.path.isfile(path):
        return None
    try:
        size = int(os.path.getsize(path))
        if size <= 0 or size > GLASSIFY_MAX_LOGO_BYTES:
            return None
        return BitmapFactory.decodeFile(path)
    except Exception as exc:
        _note_suppressed(exc)
        return None


def _download_glassify_logo() -> bytes:
    last_error = None
    try:
        response = requests.get(
            GLASSIFY_LOGO_RAW_URL,
            timeout=(5, 12),
            stream=True,
            headers={"User-Agent": f"Glassify/{__version__}"},
        )
        response.raise_for_status()
        length = response.headers.get("Content-Length")
        if length and int(length) > GLASSIFY_MAX_LOGO_BYTES:
            raise ValueError("Glassify logo is too large")
        chunks = []
        total = 0
        for chunk in response.iter_content(16 * 1024):
            if not chunk:
                continue
            total += len(chunk)
            if total > GLASSIFY_MAX_LOGO_BYTES:
                raise ValueError("Glassify logo is too large")
            chunks.append(chunk)
        data = b"".join(chunks)
        if data:
            return data
    except Exception as exc:
        last_error = exc

    try:
        response = requests.get(
            GLASSIFY_LOGO_API_URL,
            params={"ref": "main"},
            timeout=(5, 12),
            headers={
                "Accept": "application/vnd.github+json",
                "User-Agent": f"Glassify/{__version__}",
            },
        )
        response.raise_for_status()
        payload = response.json()
        if not isinstance(payload, dict):
            raise ValueError("invalid logo response")
        return _decode_github_base64(
            str(payload.get("content") or ""),
            GLASSIFY_MAX_LOGO_BYTES,
            "Glassify logo",
        )
    except Exception as exc:
        if last_error is not None:
            _note_suppressed(last_error)
        raise exc


def _finish_glassify_logo_fetch(bitmap: Any):
    global _GLASSIFY_LOGO_BITMAP, _GLASSIFY_LOGO_FETCHING
    plugin = _ACTIVE_PLUGIN
    with _GLASSIFY_LOGO_LOCK:
        if plugin is None or not getattr(plugin, "_plugin_alive", False):
            _GLASSIFY_LOGO_WAITERS.clear()
            _GLASSIFY_LOGO_FETCHING = False
            stale = True
            waiters = []
        else:
            stale = False
            if bitmap is not None:
                _GLASSIFY_LOGO_BITMAP = bitmap
            waiters = list(_GLASSIFY_LOGO_WAITERS)
            _GLASSIFY_LOGO_WAITERS.clear()
            _GLASSIFY_LOGO_FETCHING = False
    if stale:
        if bitmap is not None:
            try:
                bitmap.recycle()
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)
        return
    if bitmap is None:
        return
    for target in waiters:
        try:
            run_on_ui_thread(
                lambda target=target, bitmap=bitmap: _apply_glassify_logo(
                    target, bitmap
                )
            )
        except Exception as exc:
            _note_suppressed(exc)


def _load_glassify_logo_into(view: Any):
    global _GLASSIFY_LOGO_BITMAP, _GLASSIFY_LOGO_FETCHING
    if view is None:
        return

    with _GLASSIFY_LOGO_LOCK:
        bitmap = _GLASSIFY_LOGO_BITMAP
    if bitmap is None:
        bitmap = _read_cached_glassify_logo()
        if bitmap is not None:
            with _GLASSIFY_LOGO_LOCK:
                _GLASSIFY_LOGO_BITMAP = bitmap
    if bitmap is not None:
        _apply_glassify_logo(view, bitmap)
        return

    with _GLASSIFY_LOGO_LOCK:
        if len(_GLASSIFY_LOGO_WAITERS) < 32:
            _GLASSIFY_LOGO_WAITERS.append(view)
        if _GLASSIFY_LOGO_FETCHING:
            return
        _GLASSIFY_LOGO_FETCHING = True

    def worker():
        bitmap = None
        try:
            data = _download_glassify_logo()
            bitmap = _decode_glassify_logo(data)
            if bitmap is not None:
                path = _glassify_logo_cache_path()
                if path:
                    tmp = f"{path}.tmp.{os.getpid()}.{threading.get_ident()}"
                    try:
                        with open(tmp, "wb") as output:
                            output.write(data)
                            output.flush()
                            os.fsync(output.fileno())
                        os.replace(tmp, path)
                    finally:
                        try:
                            if os.path.exists(tmp):
                                os.remove(tmp)
                        except Exception as _suppressed_exc:
                            _note_suppressed(_suppressed_exc)
        except Exception as exc:
            _note_suppressed(exc)
        _finish_glassify_logo_fetch(bitmap)

    threading.Thread(
        target=worker,
        name="GlassifyLogo",
        daemon=True,
    ).start()


def _view_tree_mentions_glassify(root: Any, depth: int = 0, budget=None) -> bool:
    if root is None or depth > 3:
        return False
    if budget is None:
        budget = [32]
    if budget[0] <= 0:
        return False
    budget[0] -= 1
    try:
        if hasattr(root, "getText"):
            text = str(root.getText() or "").strip()
            if text == "Glassify" or text.startswith("Glassify "):
                return True
    except Exception as _suppressed_exc:
        _note_suppressed(_suppressed_exc)
    try:
        count = int(root.getChildCount())
    except Exception:
        return False
    for index in range(min(count, 12)):
        try:
            child = root.getChildAt(index)
        except Exception:
            continue
        if _view_tree_mentions_glassify(child, depth + 1, budget):
            return True
    return False


def _is_glassify_plugin_icon_view(view: Any) -> bool:
    try:
        parent = view.getParent()
    except Exception:
        return False
    for _ in range(3):
        if parent is None:
            return False
        if _view_tree_mentions_glassify(parent):
            return True
        try:
            parent = parent.getParent()
        except Exception:
            return False
    return False


def _theme_key(*names: str) -> int:
    for name in names:
        value = getattr(Theme, name, None)
        if value is not None:
            return value
    return Theme.key_windowBackgroundWhiteBlackText


def _java_color(color: int) -> int:
    """Convert an ARGB value to a signed 32-bit Java int.

    Python keeps 0xFF336699 positive; Java int parameters reject values above
    0x7FFFFFFF, which made every custom row fall back to plain text.
    """
    value = int(color) & 0xFFFFFFFF
    return value - 0x100000000 if value >= 0x80000000 else value


def _with_alpha_color(color: int, alpha: int) -> int:
    return _java_color(((int(alpha) & 0xFF) << 24) | (int(color) & 0x00FFFFFF))


def _settings_palette(resources_provider: Any = None) -> Dict[str, int]:
    primary = _theme_color(Theme.key_windowBackgroundWhiteBlackText, resources_provider)
    secondary = _theme_color(
        _theme_key(
            "key_windowBackgroundWhiteGrayText2",
            "key_windowBackgroundWhiteGrayText",
        ),
        resources_provider,
    )
    accent = _theme_color(
        _theme_key(
            "key_windowBackgroundWhiteBlueText",
            "key_windowBackgroundWhiteBlueHeader",
        ),
        resources_provider,
    )
    return {
        "primary": _java_color(primary),
        "secondary": _java_color(secondary),
        "accent": _with_alpha_color(accent, 0xFF),
        "outline": _with_alpha_color(secondary, 0x59),
        "on_accent": _java_color(0xFFFFFFFF),
        "warning": _java_color(0xFFF0A04B),
        "warning_button": _java_color(0xFFFFB86B),
        "on_warning": _java_color(0xFF2A1A08),
    }


def _rounded_drawable(
    color: int,
    radius_dp: float,
    stroke_color: Optional[int] = None,
    stroke_dp: float = 1.0,
):
    drawable = GradientDrawable()
    drawable.setShape(GradientDrawable.RECTANGLE)
    drawable.setColor(_java_color(color))
    drawable.setCornerRadius(float(AndroidUtilities.dp(radius_dp)))
    if stroke_color is not None:
        drawable.setStroke(
            max(1, AndroidUtilities.dp(stroke_dp)),
            _java_color(stroke_color),
        )
    return drawable


def _with_ripple(content: Any, ripple_color: int, radius_dp: float):
    try:
        RippleDrawable = jclass("android.graphics.drawable.RippleDrawable")
        mask = _rounded_drawable(0xFFFFFFFF, radius_dp)
        return RippleDrawable(
            ColorStateList.valueOf(_java_color(ripple_color)),
            content,
            mask,
        )
    except Exception as exc:
        _note_suppressed(exc)
        return content


def _settings_text(
    context,
    text: str,
    size_sp: float,
    color: int,
    bold: bool = False,
):
    view = TextView(context)
    view.setText(str(text))
    view.setTextSize(TypedValue.COMPLEX_UNIT_SP, float(size_sp))
    view.setTextColor(_java_color(color))
    if bold:
        try:
            view.setTypeface(AndroidUtilities.bold())
        except Exception as exc:
            _note_suppressed(exc)
    return view


def _linear_params(
    width: int = ViewGroup.LayoutParams.MATCH_PARENT,
    height: int = ViewGroup.LayoutParams.WRAP_CONTENT,
    weight: Optional[float] = None,
    top_dp: float = 0,
):
    if weight is None:
        params = LinearLayout.LayoutParams(width, height)
    else:
        params = LinearLayout.LayoutParams(width, height, float(weight))
    params.topMargin = AndroidUtilities.dp(top_dp)
    return params


@java_subclass(Object, OnClickListener)
class _CallbackClickListener(Base):
    def __init__(self, token):
        self.token = str(token)

    @joverride()
    def onClick(self, view):
        callback = _CLICK_CALLBACKS.get(self.token)
        if callback is None:
            return
        try:
            callback()
        except Exception as exc:
            _note_suppressed(exc)


def _set_click_callback(view: Any, callback: Any) -> bool:
    """Attach a Python callback to a custom settings view.

    Callbacks are looked up by token so the Java listener proxy only carries
    a string. The oldest entries are evicted once settings pages have been
    rebuilt many times and their views are long gone.
    """
    if view is None or not callable(callback):
        return False
    token = f"click-{uuid.uuid4().hex}"
    try:
        listener = _CallbackClickListener.new_instance(init_args=[token])
        _CLICK_CALLBACKS[token] = callback
        _CLICK_LISTENERS[token] = listener
        view.setOnClickListener(listener.java)
        view.setClickable(True)
        view.setFocusable(True)
        while len(_CLICK_LISTENERS) > 128:
            stale_token = next(iter(_CLICK_LISTENERS))
            _CLICK_LISTENERS.pop(stale_token, None)
            _CLICK_CALLBACKS.pop(stale_token, None)
        return True
    except Exception as exc:
        _CLICK_CALLBACKS.pop(token, None)
        _CLICK_LISTENERS.pop(token, None)
        _note_suppressed(exc)
        return False


class _StrengthCard:
    """Keeps the slider, value label, preset chips and reset link in sync."""

    def __init__(self, value_view, seek_bar, chips, reset_view, palette):
        self.value_view = value_view
        self.seek_bar = seek_bar
        self.chips = chips
        self.reset_view = reset_view
        self.palette = palette

    def show(self, value: int):
        value = max(1, min(100, int(value)))
        try:
            self.value_view.setText(f"{value}%")
        except Exception as exc:
            _note_suppressed(exc)
        for chip in self.chips:
            _style_strength_chip(chip, chip["value"] == value, self.palette)
        if self.reset_view is not None:
            try:
                self.reset_view.setVisibility(
                    View.GONE if value == GLASSIFY_DEFAULT_STRENGTH else View.VISIBLE
                )
            except Exception as exc:
                _note_suppressed(exc)

    def sync(self, value: int):
        value = max(1, min(100, int(value)))
        self.show(value)
        try:
            if int(self.seek_bar.getProgress()) != value - 1:
                self.seek_bar.setProgress(value - 1)
        except Exception as exc:
            _note_suppressed(exc)


def _register_strength_card(card: _StrengthCard, *views: Any):
    for view in views:
        if view is not None:
            _STRENGTH_CARDS[_identity(view)] = card
    while len(_STRENGTH_CARDS) > 32:
        _STRENGTH_CARDS.pop(next(iter(_STRENGTH_CARDS)), None)


def _style_strength_chip(chip: Dict[str, Any], selected: bool, palette: Dict[str, int]):
    try:
        drawable = chip["drawable"]
        if selected:
            drawable.setColor(int(palette["accent"]))
            drawable.setStroke(AndroidUtilities.dp(1), int(palette["accent"]))
            chip["label"].setTextColor(int(palette["on_accent"]))
            chip["percent"].setTextColor(_with_alpha_color(palette["on_accent"], 0xCC))
        else:
            drawable.setColor(0x00000000)
            drawable.setStroke(AndroidUtilities.dp(1), int(palette["outline"]))
            chip["label"].setTextColor(int(palette["primary"]))
            chip["percent"].setTextColor(int(palette["secondary"]))
        chip["view"].setSelected(bool(selected))
    except Exception as exc:
        _note_suppressed(exc)


def _apply_strength_from_settings(value: int):
    plugin = _ACTIVE_PLUGIN
    if plugin is None:
        return
    value = max(1, min(100, int(value)))
    plugin.commit_strength(value)
    for card in {id(card): card for card in _STRENGTH_CARDS.values()}.values():
        card.sync(value)


@java_subclass(Object, OnSeekBarChangeListener)
class _StrengthSeekListener(Base):
    def __init__(self, value_view):
        self.value_view = value_view

    @joverride()
    def onProgressChanged(self, seek_bar, progress, from_user):
        value = max(1, min(100, int(progress) + 1))
        card = _STRENGTH_CARDS.get(_identity(seek_bar))
        if card is not None:
            card.show(value)
        else:
            try:
                self.value_view.setText(f"{value}%")
            except Exception as _suppressed_exc:
                _note_suppressed(_suppressed_exc)

        if bool(from_user):
            plugin = _ACTIVE_PLUGIN
            if plugin is not None:
                plugin.preview_strength(value)

    @joverride()
    def onStartTrackingTouch(self, seek_bar):
        # Required by Android's SeekBar listener interface.
        return

    @joverride()
    def onStopTrackingTouch(self, seek_bar):
        plugin = _ACTIVE_PLUGIN
        if plugin is None:
            return

        try:
            value = max(1, min(100, int(seek_bar.getProgress()) + 1))
        except Exception:
            value = plugin.current_strength()

        plugin.commit_strength(value)


def _create_strength_view_impl(
    context,
    list_view,
    current_account,
    class_guid,
    resources_provider,
):
    palette = _settings_palette(resources_provider)
    strength = _active_strength()

    outer = LinearLayout(context)
    outer.setOrientation(LinearLayout.VERTICAL)
    outer.setPadding(
        AndroidUtilities.dp(20),
        AndroidUtilities.dp(14),
        AndroidUtilities.dp(20),
        AndroidUtilities.dp(14),
    )
    # The SeekBar extends into the side padding so its thumb is never clipped
    # at 1% or 100% while the track still lines up with the text above.
    outer.setClipToPadding(False)

    header = LinearLayout(context)
    header.setOrientation(LinearLayout.HORIZONTAL)
    header.setGravity(Gravity.CENTER_VERTICAL)
    title = _settings_text(context, "Интенсивность", 16.0, palette["primary"])
    value_view = _settings_text(context, f"{strength}%", 17.0, palette["accent"], True)
    value_view.setGravity(Gravity.RIGHT | Gravity.CENTER_VERTICAL)
    try:
        value_view.setFontFeatureSettings("tnum")
    except Exception as _suppressed_exc:
        _note_suppressed(_suppressed_exc)
    header.addView(title, _linear_params(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1.0))
    header.addView(
        value_view,
        _linear_params(
            ViewGroup.LayoutParams.WRAP_CONTENT,
            ViewGroup.LayoutParams.WRAP_CONTENT,
        ),
    )
    outer.addView(header, _linear_params())

    seek_bar = SeekBar(context)
    seek_bar.setMax(99)
    seek_bar.setProgress(strength - 1)
    seek_bar.setContentDescription("Интенсивность Liquid Glass от 1 до 100 процентов")
    thumb_room = AndroidUtilities.dp(12)
    seek_bar.setPadding(thumb_room, 0, thumb_room, 0)

    try:
        # Material 3 slider: 4dp rounded track with a 20dp circular handle.
        ClipDrawable = jclass("android.graphics.drawable.ClipDrawable")
        LayerDrawable = jclass("android.graphics.drawable.LayerDrawable")

        inactive_color = _with_alpha_color(palette["secondary"], 0x52)
        active_color = palette["accent"]

        inactive_track = _rounded_drawable(inactive_color, 2)
        active_track = _rounded_drawable(active_color, 2)
        active_clip = ClipDrawable(
            active_track,
            Gravity.LEFT | Gravity.CENTER_VERTICAL,
            ClipDrawable.HORIZONTAL,
        )

        progress_layers = LayerDrawable(
            jarray(jclass("android.graphics.drawable.Drawable"))(
                [inactive_track, active_clip]
            )
        )
        progress_layers.setId(0, 0x01020000)  # android.R.id.background
        progress_layers.setId(1, 0x0102000D)  # android.R.id.progress
        inset = AndroidUtilities.dp(20)
        progress_layers.setLayerInset(0, 0, inset, 0, inset)
        progress_layers.setLayerInset(1, 0, inset, 0, inset)
        seek_bar.setProgressDrawable(progress_layers)

        thumb = GradientDrawable()
        thumb.setShape(GradientDrawable.OVAL)
        thumb.setColor(active_color)
        thumb.setSize(AndroidUtilities.dp(20), AndroidUtilities.dp(20))
        seek_bar.setThumb(thumb)
        seek_bar.setThumbOffset(AndroidUtilities.dp(10))
        seek_bar.setSplitTrack(False)
        seek_bar.setMinimumHeight(AndroidUtilities.dp(44))
    except Exception as _suppressed_exc:
        # Keep the native SeekBar usable on clients that reject custom drawables.
        _note_suppressed(_suppressed_exc)
        try:
            tint = ColorStateList.valueOf(palette["accent"])
            seek_bar.setProgressTintList(tint)
            seek_bar.setThumbTintList(tint)
            seek_bar.setSplitTrack(False)
            seek_bar.setMinimumHeight(AndroidUtilities.dp(36))
        except Exception as _fallback_exc:
            _note_suppressed(_fallback_exc)

    try:
        listener = _StrengthSeekListener.new_instance(init_args=[value_view])
        seek_bar.setOnSeekBarChangeListener(listener.java)
        _SLIDER_LISTENERS[_identity(seek_bar)] = listener
        while len(_SLIDER_LISTENERS) > 16:
            oldest = next(iter(_SLIDER_LISTENERS))
            _SLIDER_LISTENERS.pop(oldest, None)
    except Exception as listener_exc:
        # Some exteraGram/Android combinations can reject the generated Java
        # OnSeekBarChangeListener proxy. Never let that blank the entire
        # settings RecyclerView: keep the row visible, but disable dragging.
        # Preset chips below still work through their own click listeners.
        _note_suppressed(listener_exc)
        try:
            seek_bar.setEnabled(False)
            seek_bar.setContentDescription(
                "Интенсивность Liquid Glass: ползунок недоступен в этой сборке клиента"
            )
        except Exception as fallback_exc:
            _note_suppressed(fallback_exc)

    seek_params = _linear_params(
        ViewGroup.LayoutParams.MATCH_PARENT,
        AndroidUtilities.dp(44),
        top_dp=4,
    )
    seek_params.leftMargin = -thumb_room
    seek_params.rightMargin = -thumb_room
    outer.addView(seek_bar, seek_params)

    scale = LinearLayout(context)
    scale.setOrientation(LinearLayout.HORIZONTAL)
    softer = _settings_text(context, "Мягче", 12.5, palette["secondary"])
    stronger = _settings_text(context, "Сильнее", 12.5, palette["secondary"])
    stronger.setGravity(Gravity.RIGHT)
    scale.addView(softer, _linear_params(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1.0))
    scale.addView(stronger, _linear_params(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1.0))
    outer.addView(scale, _linear_params())

    chips_row = LinearLayout(context)
    chips_row.setOrientation(LinearLayout.HORIZONTAL)
    chips: List[Dict[str, Any]] = []
    for index, (label, value) in enumerate(GLASSIFY_STRENGTH_PRESETS):
        chip_view = LinearLayout(context)
        chip_view.setOrientation(LinearLayout.VERTICAL)
        chip_view.setGravity(Gravity.CENTER)
        chip_view.setMinimumHeight(AndroidUtilities.dp(52))
        chip_view.setPadding(
            AndroidUtilities.dp(4),
            AndroidUtilities.dp(6),
            AndroidUtilities.dp(4),
            AndroidUtilities.dp(6),
        )
        chip_view.setContentDescription(f"Пресет «{label}», {value} процентов")
        drawable = _rounded_drawable(0x00000000, 14, palette["outline"])
        chip_view.setBackground(
            _with_ripple(drawable, _with_alpha_color(palette["accent"], 0x33), 14)
        )
        label_view = _settings_text(context, label, 13.0, palette["primary"], True)
        label_view.setGravity(Gravity.CENTER)
        label_view.setSingleLine(True)
        percent_view = _settings_text(context, f"{value}%", 12.0, palette["secondary"])
        percent_view.setGravity(Gravity.CENTER)
        chip_view.addView(
            label_view,
            _linear_params(
                ViewGroup.LayoutParams.WRAP_CONTENT,
                ViewGroup.LayoutParams.WRAP_CONTENT,
            ),
        )
        chip_view.addView(
            percent_view,
            _linear_params(
                ViewGroup.LayoutParams.WRAP_CONTENT,
                ViewGroup.LayoutParams.WRAP_CONTENT,
                top_dp=1,
            ),
        )
        chip_params = _linear_params(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1.0)
        if index > 0:
            chip_params.leftMargin = AndroidUtilities.dp(8)
        chips_row.addView(chip_view, chip_params)
        _set_click_callback(
            chip_view,
            lambda value=value: _apply_strength_from_settings(value),
        )
        chips.append(
            {
                "value": int(value),
                "view": chip_view,
                "drawable": drawable,
                "label": label_view,
                "percent": percent_view,
            }
        )
    outer.addView(chips_row, _linear_params(top_dp=12))

    reset_view = _settings_text(
        context,
        f"Вернуть стандартные {GLASSIFY_DEFAULT_STRENGTH}%",
        15.0,
        palette["accent"],
        True,
    )
    reset_view.setPadding(0, AndroidUtilities.dp(14), 0, AndroidUtilities.dp(2))
    if not _set_click_callback(
        reset_view,
        lambda: _apply_strength_from_settings(GLASSIFY_DEFAULT_STRENGTH),
    ):
        reset_view = None
    else:
        outer.addView(reset_view, _linear_params())

    card = _StrengthCard(value_view, seek_bar, chips, reset_view, palette)
    card.show(strength)
    _register_strength_card(card, outer, seek_bar)
    return outer


def _bind_strength_view(view, item, divider, adapter, list_view):
    card = _STRENGTH_CARDS.get(_identity(view))
    if card is not None:
        card.sync(_active_strength())


def _create_glassify_header_view_impl(
    context,
    list_view,
    current_account,
    class_guid,
    resources_provider,
):
    palette = _settings_palette(resources_provider)
    container = FrameLayout(context)

    try:
        from org.telegram.ui.Components import LayoutHelper
        from org.telegram.ui.Components.Premium import StarParticlesView

        particles_view = StarParticlesView(context)
        particles_view.setClipWithGradient()
        particles_view.drawable.colorKey = Theme.key_premiumStarGradient2
        particles_view.drawable.isCircle = True
        # Centre the particles on the logo rather than on the whole header.
        particles_view.drawable.centerOffsetY = AndroidUtilities.dp(-34)
        particles_view.drawable.minLifeTime = 2200
        particles_view.drawable.randLifeTime = 3200
        particles_view.drawable.useRotate = False
        particles_view.drawable.updateColors()
        container.addView(
            particles_view,
            LayoutHelper.createFrame(
                -1,
                -1,
                Gravity.CENTER_HORIZONTAL | Gravity.TOP,
                0,
                0,
                0,
                0,
            ),
        )
        run_on_ui_thread(lambda: particles_view.flingParticles(340), 180)
    except Exception as _suppressed_exc:
        _note_suppressed(_suppressed_exc)

    # A plain vertical stack: text grows with the system font size instead of
    # overlapping at fixed offsets.
    column = LinearLayout(context)
    column.setOrientation(LinearLayout.VERTICAL)
    column.setGravity(Gravity.CENTER_HORIZONTAL)
    column.setPadding(
        AndroidUtilities.dp(24),
        AndroidUtilities.dp(22),
        AndroidUtilities.dp(24),
        AndroidUtilities.dp(22),
    )

    logo = ImageView(context)
    logo.setScaleType(ImageView.ScaleType.FIT_CENTER)
    logo.setContentDescription("Логотип Glassify")
    _load_glassify_logo_into(logo)
    column.addView(
        logo,
        _linear_params(AndroidUtilities.dp(108), AndroidUtilities.dp(108)),
    )

    title = _settings_text(
        context,
        f"Glassify {_version_label()}",
        22.0,
        palette["primary"],
        True,
    )
    title.setGravity(Gravity.CENTER)
    column.addView(title, _linear_params(top_dp=16))

    subtitle = _settings_text(
        context,
        "Нативный Liquid Glass для exteraGram",
        14.0,
        palette["secondary"],
    )
    subtitle.setGravity(Gravity.CENTER)
    subtitle.setSingleLine(False)
    column.addView(subtitle, _linear_params(top_dp=4))

    container.addView(
        column,
        FrameLayout.LayoutParams(
            ViewGroup.LayoutParams.MATCH_PARENT,
            ViewGroup.LayoutParams.WRAP_CONTENT,
            Gravity.CENTER_HORIZONTAL | Gravity.TOP,
        ),
    )
    return container


def _create_native_warning_view_impl(
    context,
    list_view,
    current_account,
    class_guid,
    resources_provider,
):
    palette = _settings_palette(resources_provider)

    outer = LinearLayout(context)
    outer.setOrientation(LinearLayout.VERTICAL)
    outer.setPadding(
        AndroidUtilities.dp(16),
        AndroidUtilities.dp(14),
        AndroidUtilities.dp(16),
        AndroidUtilities.dp(6),
    )

    card = LinearLayout(context)
    card.setOrientation(LinearLayout.VERTICAL)
    card.setPadding(
        AndroidUtilities.dp(16),
        AndroidUtilities.dp(14),
        AndroidUtilities.dp(16),
        AndroidUtilities.dp(14),
    )
    card.setBackground(
        _rounded_drawable(
            _with_alpha_color(palette["warning"], 0x24),
            16,
            _with_alpha_color(palette["warning"], 0x66),
        )
    )

    title = _settings_text(
        context,
        "Liquid Glass выключен в клиенте",
        15.0,
        palette["primary"],
        True,
    )
    card.addView(title, _linear_params())

    body = _settings_text(
        context,
        "Включите Liquid Glass и размытие в чатах в разделе «Энергосбережение». "
        "Пока они выключены, Glassify ничего не меняет.",
        13.5,
        palette["secondary"],
    )
    body.setSingleLine(False)
    try:
        body.setLineSpacing(float(AndroidUtilities.dp(2)), 1.0)
    except Exception as _suppressed_exc:
        _note_suppressed(_suppressed_exc)
    card.addView(body, _linear_params(top_dp=4))

    button = _settings_text(
        context,
        "Открыть энергосбережение",
        13.5,
        palette["on_warning"],
        True,
    )
    button.setPadding(
        AndroidUtilities.dp(14),
        AndroidUtilities.dp(9),
        AndroidUtilities.dp(14),
        AndroidUtilities.dp(9),
    )
    button.setBackground(
        _with_ripple(
            _rounded_drawable(palette["warning_button"], 18),
            0x33000000,
            18,
        )
    )

    def open_energy_settings():
        plugin = _ACTIVE_PLUGIN
        if plugin is not None:
            plugin._open_energy_settings()

    if not _set_click_callback(button, open_energy_settings):
        # Without a click proxy, show the path as plain text instead of a
        # button that does nothing.
        button.setBackground(None)
        button.setPadding(0, 0, 0, 0)
        button.setTextColor(int(palette["primary"]))
        button.setText("Настройки → Энергосбережение")
    card.addView(
        button,
        _linear_params(
            ViewGroup.LayoutParams.WRAP_CONTENT,
            ViewGroup.LayoutParams.WRAP_CONTENT,
            top_dp=12,
        ),
    )

    outer.addView(card, _linear_params())
    return outer


def _create_safe_custom_fallback(context, title_text, detail_text, resources_provider):
    """Create a dependency-light row when a rich custom settings view fails."""
    try:
        outer = LinearLayout(context)
        outer.setOrientation(LinearLayout.VERTICAL)
        outer.setGravity(Gravity.CENTER_VERTICAL)
        outer.setPadding(
            AndroidUtilities.dp(16),
            AndroidUtilities.dp(14),
            AndroidUtilities.dp(16),
            AndroidUtilities.dp(14),
        )

        title = TextView(context)
        title.setText(title_text)
        title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 16.0)
        try:
            title.setTextColor(
                _theme_color(
                    Theme.key_windowBackgroundWhiteBlackText, resources_provider
                )
            )
        except Exception as color_exc:
            _note_suppressed(color_exc)
        outer.addView(
            title,
            LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT,
                ViewGroup.LayoutParams.WRAP_CONTENT,
            ),
        )

        detail = TextView(context)
        detail.setText(detail_text)
        detail.setTextSize(TypedValue.COMPLEX_UNIT_SP, 13.0)
        detail.setSingleLine(False)
        try:
            detail.setTextColor(
                _theme_color(
                    getattr(
                        Theme,
                        "key_windowBackgroundWhiteGrayText",
                        Theme.key_windowBackgroundWhiteBlackText,
                    ),
                    resources_provider,
                )
            )
        except Exception as color_exc:
            _note_suppressed(color_exc)
        detail_params = LinearLayout.LayoutParams(
            ViewGroup.LayoutParams.MATCH_PARENT,
            ViewGroup.LayoutParams.WRAP_CONTENT,
        )
        detail_params.topMargin = AndroidUtilities.dp(4)
        outer.addView(detail, detail_params)
        return outer
    except Exception as fallback_exc:
        # Last-resort Android View with virtually no dependencies.
        _note_suppressed(fallback_exc)
        view = TextView(context)
        view.setText(title_text)
        return view


def _create_strength_view(
    context,
    list_view,
    current_account,
    class_guid,
    resources_provider,
):
    try:
        return _create_strength_view_impl(
            context, list_view, current_account, class_guid, resources_provider
        )
    except Exception as exc:
        _note_suppressed(exc)
        return _create_safe_custom_fallback(
            context,
            f"Интенсивность · {_active_strength()}%",
            "Ползунок недоступен в этой сборке клиента. Остальные настройки Glassify работают.",
            resources_provider,
        )


def _create_glassify_header_view(
    context,
    list_view,
    current_account,
    class_guid,
    resources_provider,
):
    try:
        return _create_glassify_header_view_impl(
            context, list_view, current_account, class_guid, resources_provider
        )
    except Exception as exc:
        _note_suppressed(exc)
        return _create_safe_custom_fallback(
            context,
            f"Glassify {_version_label()}",
            "Нативный Liquid Glass для exteraGram",
            resources_provider,
        )


def _create_native_warning_view(
    context,
    list_view,
    current_account,
    class_guid,
    resources_provider,
):
    try:
        return _create_native_warning_view_impl(
            context, list_view, current_account, class_guid, resources_provider
        )
    except Exception as exc:
        _note_suppressed(exc)
        return _create_safe_custom_fallback(
            context,
            "Liquid Glass выключен в клиенте",
            "Включите Liquid Glass и размытие в чатах: Настройки → Энергосбережение.",
            resources_provider,
        )


def _bind_static_setting_view(view, item, divider, adapter, list_view):
    # Required by SimpleSettingFactory; static custom rows have no bind state.
    return


GlassifyHeaderFactory = SimpleSettingFactory(
    _create_glassify_header_view,
    _bind_static_setting_view,
    is_clickable=False,
)


StrengthSliderFactory = SimpleSettingFactory(
    _create_strength_view,
    _bind_strength_view,
    is_clickable=False,
)


NativeWarningFactory = SimpleSettingFactory(
    _create_native_warning_view,
    _bind_static_setting_view,
    is_clickable=False,
)


def _create_update_report_view_impl(
    context,
    list_view,
    current_account,
    class_guid,
    resources_provider,
):
    palette = _settings_palette(resources_provider)
    release = GLASSIFY_CHANGELOG.get(str(__version__)) or {}
    items = tuple(release.get("items") or ())

    outer = LinearLayout(context)
    outer.setOrientation(LinearLayout.VERTICAL)
    outer.setPadding(
        AndroidUtilities.dp(20),
        AndroidUtilities.dp(12),
        AndroidUtilities.dp(20),
        AndroidUtilities.dp(18),
    )

    def add_text(text, size, color, bold=False, top=0):
        view = _settings_text(context, text, size, color, bold)
        view.setSingleLine(False)
        try:
            view.setLineSpacing(float(AndroidUtilities.dp(2)), 1.0)
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)
        outer.addView(view, _linear_params(top_dp=top))
        return view

    add_text(f"Glassify {_version_label()}", 21.0, palette["primary"], True)
    add_text(
        str(release.get("summary") or "Список изменений этой версии"),
        14.0,
        palette["secondary"],
        top=2,
    )

    if not items:
        add_text(
            "Для этой версии список изменений ещё не добавлен.",
            15.0,
            palette["secondary"],
            top=16,
        )
        return outer

    for index, (title, description) in enumerate(items):
        add_text(title, 16.0, palette["primary"], True, top=18 if index == 0 else 14)
        add_text(description, 14.0, palette["secondary"], top=3)
    return outer


def _create_update_report_view(
    context,
    list_view,
    current_account,
    class_guid,
    resources_provider,
):
    try:
        return _create_update_report_view_impl(
            context, list_view, current_account, class_guid, resources_provider
        )
    except Exception as exc:
        _note_suppressed(exc)
        return _create_safe_custom_fallback(
            context,
            f"Что нового в Glassify {_version_label()}",
            "Оформление списка изменений недоступно в этой сборке клиента.",
            resources_provider,
        )


UpdateReportFactory = SimpleSettingFactory(
    _create_update_report_view,
    _bind_static_setting_view,
    is_clickable=False,
)


def _create_extension_preview_view(
    extension_id: str,
    context,
    list_view,
    current_account,
    class_guid,
    resources_provider,
):
    outer = FrameLayout(context)
    outer.setPadding(
        AndroidUtilities.dp(16),
        AndroidUtilities.dp(8),
        AndroidUtilities.dp(16),
        AndroidUtilities.dp(10),
    )

    image = ImageView(context)
    image.setScaleType(ImageView.ScaleType.CENTER_CROP)
    image.setContentDescription(f"Предпросмотр расширения {extension_id}")
    try:
        image.setClipToOutline(True)
    except Exception as _suppressed_exc:
        _note_suppressed(_suppressed_exc)
    preview_background_key = getattr(
        Theme,
        "key_windowBackgroundGray",
        getattr(
            Theme,
            "key_windowBackgroundWhite",
            Theme.key_windowBackgroundWhiteBlackText,
        ),
    )
    image.setBackgroundColor(
        _theme_color(
            preview_background_key,
            resources_provider,
        )
    )
    try:
        background = GradientDrawable()
        background.setShape(GradientDrawable.RECTANGLE)
        background.setColor(
            _theme_color(
                preview_background_key,
                resources_provider,
            )
        )
        background.setCornerRadius(float(AndroidUtilities.dp(18)))
        image.setBackground(background)
    except Exception as _suppressed_exc:
        _note_suppressed(_suppressed_exc)

    try:
        screen_width = int(context.getResources().getDisplayMetrics().widthPixels)
    except Exception:
        screen_width = AndroidUtilities.dp(360)
    card_width = max(AndroidUtilities.dp(280), screen_width - AndroidUtilities.dp(32))
    card_height = max(
        AndroidUtilities.dp(150),
        min(AndroidUtilities.dp(220), int(card_width * 0.5)),
    )
    outer.addView(
        image,
        FrameLayout.LayoutParams(
            ViewGroup.LayoutParams.MATCH_PARENT,
            card_height,
        ),
    )

    placeholder = TextView(context)
    placeholder.setText("Загружаем предпросмотр…")
    placeholder.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14.0)
    placeholder.setGravity(Gravity.CENTER)
    placeholder.setTextColor(
        _theme_color(
            getattr(
                Theme,
                "key_windowBackgroundWhiteGrayText",
                Theme.key_windowBackgroundWhiteBlackText,
            ),
            resources_provider,
        )
    )
    outer.addView(
        placeholder,
        FrameLayout.LayoutParams(
            ViewGroup.LayoutParams.MATCH_PARENT,
            card_height,
        ),
    )
    return outer


def _bind_extension_preview_view(
    extension_id: str,
    view,
    item,
    divider,
    adapter,
    list_view,
):
    plugin = _ACTIVE_PLUGIN
    if plugin is not None:
        plugin._bind_extension_preview_view(extension_id, view)


def _extension_preview_factory(extension_id: str):
    factory = _EXTENSION_PREVIEW_FACTORIES.get(extension_id)
    if factory is not None:
        return factory

    def create(context, list_view, current_account, class_guid, resources_provider):
        try:
            return _create_extension_preview_view(
                extension_id,
                context,
                list_view,
                current_account,
                class_guid,
                resources_provider,
            )
        except Exception as exc:
            _note_suppressed(exc)
            return _create_safe_custom_fallback(
                context,
                "Предпросмотр недоступен",
                "Карточка расширения продолжает работать без изображения.",
                resources_provider,
            )

    def bind(view, item, divider, adapter, list_view):
        try:
            _bind_extension_preview_view(
                extension_id,
                view,
                item,
                divider,
                adapter,
                list_view,
            )
        except Exception as exc:
            _note_suppressed(exc)

    factory = SimpleSettingFactory(create, bind, is_clickable=False)
    _EXTENSION_PREVIEW_FACTORIES[extension_id] = factory
    return factory


class _EnsureNativeBeforeHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin", kind: str = ""):
        self.plugin = plugin
        self.kind = kind

    def before_hooked_method(self, param):
        # Capability is already checked at plugin load. Re-checking it for
        # every fragment create adds bridge work to the hottest transition.
        if not self.plugin._native_available:
            self.plugin.ensure_native_flags()
        if self.kind == "chat":
            self.plugin.begin_chat_create()


class _RememberDrawableAfterHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        drawable = param.getResult()
        if drawable is None:
            return

        view = None
        try:
            if len(param.args) > 0:
                candidate = param.args[0]
                if candidate is not None and hasattr(candidate, "invalidate"):
                    view = candidate
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)

        self.plugin.track_liquid_drawable(drawable, view)


class _PluginIconAfterHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if not self.plugin._plugin_alive:
            return
        try:
            args = param.args
            if len(args) < 3:
                return
            image_view = args[0]
            pack = str(args[1]) if args[1] is not None else ""
            index = int(args[2])

            # Recycler/list cells are reused. Remove our custom background as
            # soon as the same icon view is rebound to any other placeholder.
            if pack != "TgDuckX" or index != 26:
                _clear_glassify_logo_background(image_view)
                return
            if not _is_glassify_plugin_icon_view(image_view):
                _clear_glassify_logo_background(image_view)
                return
            _load_glassify_logo_into(image_view)
        except Exception as exc:
            _note_suppressed(exc)


class _FragmentCreatedAfterHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin", kind: str, delay: int = 80):
        self.plugin = plugin
        self.kind = kind
        self.delay = delay

    def after_hooked_method(self, param):
        fragment = param.thisObject
        root = param.getResult()

        if self.kind == "chat":
            self.plugin.end_chat_create()
            key = _identity(fragment)

            # Keep the chat-opening fast path: keyboard/panel work is
            # deferred and independent from the top-header integration.
            self.plugin.schedule_coalesced(
                ("chat_bottom_panels_create", key),
                lambda fragment=fragment: self.plugin.decorate_chat_bottom_panels(fragment),
                260,
            )

            # Fallback only. Keep expensive M3 discovery comfortably outside
            # the opening animation if the transition callback is unavailable.
            self.plugin.schedule_coalesced(
                ("chat_post_transition", key),
                lambda fragment=fragment, root=root: self.plugin.decorate_fragment(
                    fragment,
                    root,
                    "chat",
                ),
                620,
            )
            return

        self.plugin.schedule(
            lambda: self.plugin.decorate_fragment(fragment, root, self.kind),
            self.delay,
        )


class _ChatTransitionEndAfterHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        fragment = param.thisObject

        # Telegram normally passes isOpen as the first boolean argument.
        # Ignore closing transitions so we never rebuild a header while a
        # fragment is leaving the screen.
        is_open = True
        try:
            if len(param.args) > 0:
                raw = param.args[0]
                text = str(raw).strip().lower()
                if text in ("false", "0"):
                    is_open = False
                elif text in ("true", "1"):
                    is_open = True
        except Exception as _suppressed_exc:
            _note_suppressed(_suppressed_exc)

        if not is_open:
            return

        key = _identity(fragment)
        root = self.plugin.field(fragment, "fragmentView")

        # Avoid full M3 discovery immediately after the transition, directly in
        # the first interactive frame. Give input/scroll a short head start.
        self.plugin.schedule_coalesced(
            ("chat_post_transition", key),
            lambda fragment=fragment, root=root: self.plugin.decorate_fragment(
                fragment,
                root,
                "chat",
            ),
            96,
        )


class _M3ChatHeaderColorsAfterHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        fragment = param.thisObject
        key = _identity(fragment)

        # Never perform M3 discovery from updateColors. Only refresh an already
        # installed fade, which is a cheap theme-color update.
        state = self.plugin._m3_chat_headers.get(key)
        if not isinstance(state, dict):
            return

        self.plugin.schedule_coalesced(
            ("m3_chat_header_colors", key),
            lambda state=state: self.plugin._apply_m3_chat_header_fade(state),
            32,
        )


class _MainTabsCreatedAfterHook(MethodHook):
    def __init__(self, plugin: "GlassifyPlugin", delay: int = 96):
        self.plugin = plugin
        self.delay = delay

    def after_hooked_method(self, param):
        activity = param.thisObject
        root = param.getResult()
        self.plugin.schedule(
            lambda: self.plugin.decorate_main_tabs(activity, root),
            self.delay,
        )


