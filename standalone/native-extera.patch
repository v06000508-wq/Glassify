+package glassify.kyant;
+
+final class TabWidths {
+    private TabWidths() {}
+
+    // Keep equal columns when every title fits. On a narrow bar, assign room
+    // in proportion to the fitted widths and let the last item absorb rounding.
+    static int[] distribute(float[] fitted, int available) {
+        int[] result = new int[fitted.length];
+        if (fitted.length == 0 || available <= 0) return result;
+        float total = 0;
+        float widest = 0;
+        for (float width : fitted) {
+            total += width;
+            widest = Math.max(widest, width);
+        }
+        float equal = (float) available / fitted.length;
+        boolean uniform = widest <= equal;
+        float cumulative = 0;
+        int previous = 0;
+        for (int i = 0; i < fitted.length; i++) {
+            cumulative += uniform ? 1 : fitted[i];
+            int end = i == fitted.length - 1 ? available
+                    : Math.round(available * cumulative / (uniform ? fitted.length : total));
+            result[i] = end - previous;
+            previous = end;
+        }
+        return result;
+    }
+}
